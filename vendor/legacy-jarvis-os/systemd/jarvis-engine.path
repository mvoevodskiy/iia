[Unit]
Description=jarvis-engine: watch the owner's bots' request files
# The Jarvis bot runs NoNewPrivileges, so it cannot start anything as root (OpenClaw's user is root through sudo
# since helper 0.5.8; its plugin still asks here, the closed list is the same).
# Each bot writes ONE JSON request into its own directory; this root-side watcher starts the helper, which
# deletes the file first and acts only on a closed list of actions.
# StartLimitBurst=0: a stream of garbage requests must never park this unit (same reason as
# msb-pull-now.path). The helper rate-limits requests itself.
StartLimitBurst=0

[Path]
PathExists=/home/client/.msb/engine/request
PathExists=/home/openclaw/.jarvis-engine/request
Unit=jarvis-engine.service

[Install]
WantedBy=paths.target
