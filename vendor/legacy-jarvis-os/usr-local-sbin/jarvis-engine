def systemctl_ok(*args, timeout=60):
    try:
        return run(["systemctl"] + list(args), timeout=timeout).returncode == 0
    except subprocess.TimeoutExpired:
        return False


def systemctl_word(*args):
    try:
        return run(["systemctl"] + list(args), timeout=30).stdout.decode("ascii", "replace").strip()
    except subprocess.TimeoutExpired:
        return ""


def systemctl_words(verb, units, deadline):
    """`systemctl <verb> u1 u2 …` (is-active / is-enabled) for all units in ONE call, the words in the order given
    (systemctl prints one line per unit). Every call shares `deadline` (time.monotonic()): a hung systemd costs the
    caller at most that, never 30 s per call per unit. A count of lines that is not one per unit is not trusted (an
    older systemd stops `is-enabled` at the first unit it cannot find, with no line for it or for the rest; a unit with
    no word at all): then one call per unit, under the same deadline. "" = no answer (timeout, deadline, nothing
    printed). Never raises."""
    units = list(units)
    if not units:
        return []

    def ask(us):
        left = deadline - time.monotonic()
        if left <= 0:
            return None
        try:
            out = run(["systemctl", verb] + us, timeout=left).stdout.decode("ascii", "replace").splitlines()
        except subprocess.TimeoutExpired:
            return None
        return [w.strip() for w in out if w.strip()]

    got = ask(units)
    if got is not None and len(got) == len(units):
        return got
    if got is None or len(units) == 1:
        return [""] * len(units)
    words = []
    for u in units:
        one = ask([u])
        words.append(one[0] if one and len(one) == 1 else "")
    return words


# ── request intake ───────────────────────────────────────────────────────────────────────────────
def open_dir_chain(path):
    """Open every component with O_NOFOLLOW from "/". Returns (fd, fstat). FileNotFoundError passes."""
    fd = os.open("/", os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        for part in [p for p in path.split("/") if p]:
            nfd = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=fd)
            os.close(fd)
            fd = nfd
        return fd, os.fstat(fd)
    except BaseException:
        os.close(fd)
        raise


def remove_entry(dfd, name):
    """Remove whatever sits at `name` inside the held directory, never following it."""
    try:
        os.unlink(name, dir_fd=dfd)
        return
    except FileNotFoundError:
        return
    except OSError as e:
        if e.errno not in (errno.EISDIR, errno.EPERM, errno.EACCES):
            raise
    try:
        os.rmdir(name, dir_fd=dfd)
    except OSError:
        os.rename(name, ".request.junk.%s" % os.urandom(6).hex(), src_dir_fd=dfd, dst_dir_fd=dfd)


def take_request(path, expected_uid, name=REQUEST_NAME, limit=REQUEST_MAX):
    """None = no request. Refused = consumed and rejected. bytes = the request (consumed). Also the jobs file of
    import-cron (0.5.7: same checks, its own size limit)."""
    try:
        dfd, dst = open_dir_chain(path)
    except FileNotFoundError:
        return None
    except OSError:
        return Refused("BAD_REQUEST", detail={"reason": "REQUEST_DIR"})
    try:
        try:
            fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_NOCTTY | os.O_CLOEXEC, dir_fd=dfd)
        except FileNotFoundError:
            return None
        except OSError:
            remove_entry(dfd, name)  # a symlink, a socket: gone before anything else
            return Refused("BAD_REQUEST", detail={"reason": "REQUEST_NOT_FILE"})
        try:
            remove_entry(dfd, name)  # first action: garbage never re-triggers the path unit
            st = os.fstat(fd)
            # A Jarvis bot puts its request in with link() and drops its own temp name a moment later (the slot is
            # shared by the bots of a server): a second link that goes within 0.5 s is that, one that stays is refused.
            for _ in range(10):
                if st.st_nlink == 0:
                    break
                time.sleep(0.05)
                st = os.fstat(fd)
            reason = None
            if dst.st_uid != expected_uid or dst.st_mode & 0o022:
                reason = "REQUEST_DIR"
            elif not stat.S_ISREG(st.st_mode):
                reason = "REQUEST_NOT_FILE"
            elif st.st_uid != expected_uid:
                reason = "REQUEST_FOREIGN_OWNER"
            elif st.st_nlink != 0:
                reason = "REQUEST_LINKED"
            if reason:
                return Refused("BAD_REQUEST", detail={"reason": reason})
            data = b""
            while len(data) <= limit:
                b = os.read(fd, limit + 1 - len(data))
                if not b:
                    break
                data += b
        finally:
            os.close(fd)
    finally:
        os.close(dfd)
    if len(data) > limit:
        return Refused("BAD_REQUEST", detail={"reason": "REQUEST_SIZE"})
    return data


def need_str(v, rx):
    if not isinstance(v, str) or not rx.fullmatch(v):
        raise Refused("BAD_REQUEST")
    return v


def need_model(model, allow_id=False):
    if not isinstance(model, dict):
        raise Refused("BAD_REQUEST")
    mode = model.get("mode")
    if mode == "api_key":
        keys = {"mode", "provider", "api_key"}
        if not (set(model) == keys or (allow_id and set(model) == keys | {"model_id"})) or model.get("provider") not in PROVIDERS:
            raise Refused("BAD_REQUEST")
        key = need_str(model.get("api_key"), MODEL_KEY_RE)
        if key.startswith("sk-ant-oat"):
            # a Claude subscription token is never OpenClaw's key (Anthropic's rule)
            raise Refused("BAD_REQUEST", detail={"reason": "MODEL_SUBSCRIPTION_TOKEN"})
        out = {"mode": "api_key", "provider": model["provider"], "apiKey": key}
        if "model_id" in model:
            mid = need_str(model["model_id"], MODEL_ID_RE)
            if not mid.startswith(model["provider"] + "/"):
                raise Refused("BAD_REQUEST", detail={"reason": "MODEL_ID"})  # the model of another provider's key
            out["modelId"] = mid
        return out
    if mode in ("login", "none") and set(model) == {"mode"}:
        return {"mode": mode}
    raise Refused("BAD_REQUEST")


def parse_request(data):
    """The request as {id, action, params}; Refused (with .request_id when it was readable) otherwise."""
    obj = strict_json(data, "BAD_REQUEST")
    if not isinstance(obj, dict):
        raise Refused("BAD_REQUEST")
    rid = obj.get("id")
    rid = rid if isinstance(rid, str) and ID_RE.fullmatch(rid) else None
    def bad(code, reason, detail=None):
        e = Refused(code, detail=dict({"reason": reason}, **(detail or {})))
        e.request_id = rid
        return e
    if obj.get("v") != 1 or isinstance(obj.get("v"), bool):
        raise bad("BAD_REQUEST", "VERSION")
    if rid is None:
        raise bad("BAD_REQUEST", "ID")
    action = obj.get("action")
    if action not in ACTIONS:
        raise bad("BAD_REQUEST", "UNKNOWN_ACTION")
    params = {k: v for k, v in obj.items() if k not in ("v", "id", "action")}
    if not set(params) <= set(REQUEST_KEYS[action]) or not set(REQUIRED_KEYS.get(action, ())) <= set(params):
        raise bad("BAD_REQUEST", "KEYS")
    out = {}
    try:
        if "owner" in params:
            out["owner"] = need_str(params["owner"], TG_ID_RE)
        if "telegram_token" in params:
            out["token"] = need_str(params["telegram_token"], TG_TOKEN_RE)
        if "model" in params:
            out["model"] = need_model(params["model"], allow_id=action == "add-openclaw")
            if action == "set-model" and out["model"]["mode"] != "api_key":
                raise Refused("BAD_REQUEST", detail={"reason": "MODEL_MODE"})  # a sign-in is /login in OpenClaw's chat
        if "jarvis_bot" in params:
            out["jarvis_bot"] = need_str(params["jarvis_bot"], TG_USERNAME_RE)
        if "bot_id" in params:
            out["bot_id"] = need_str(params["bot_id"], BOT_ID_RE)
        for flag in ("transfer_memory", "import_memory", "from_adapter"):
            if flag in params:
                if not isinstance(params[flag], bool):
                    raise Refused("BAD_REQUEST")
                out[flag] = params[flag]
        if "archive" in params:
            out["archive"] = need_str(params["archive"], ARCHIVE_RE)
        if action == "import-cron":
            # the bot's own file only: cron-import.<the bot_id of this request>.json, in the request directory
            out["jobs_sha256"] = need_str(params["jobs_sha256"], SHA256_RE)
            if need_str(params["jobs_file"], CRON_IMPORT_FILE_RE) != cron_import_file(out["bot_id"]):
                raise Refused("BAD_REQUEST", detail={"reason": "JOBS_FILE"})
            out["jobs_file"] = params["jobs_file"]
        if "keep" in params:
            keep = params["keep"]
            if not isinstance(keep, dict) or not set(keep) <= set(KEEP_KEYS) or \
                    not all(isinstance(v, bool) for v in keep.values()):
                raise Refused("BAD_REQUEST")
            out["keep"] = {k: keep.get(k, True) for k in KEEP_KEYS}
        elif action in ("remove-openclaw", "remove-jarvis"):
            out["keep"] = {k: True for k in KEEP_KEYS}  # default: everything kept in the archive
    except Refused as e:
        raise bad("BAD_REQUEST", e.detail.get("reason", "VALUE"))
    return {"id": rid, "action": action, "params": out}


# ── local memory: rate limits and replay ─────────────────────────────────────────────────────────
def load_memory():
    raw = read_small(os.path.join(STATE_DIR, "requests.json"), 1 << 20)
    try:
        mem = json.loads(raw.decode()) if raw else {}
    except Exception:
        mem = {}
    mem = mem if isinstance(mem, dict) else {}
    t = now()
    fresh = lambda xs: [c for c in (xs if isinstance(xs, list) else []) if isinstance(c, int) and t - RATE_WINDOW < c <= t]
    calls = mem.get("calls") if isinstance(mem.get("calls"), dict) else {}
    seen = mem.get("seen") if isinstance(mem.get("seen"), dict) else {}
    return {"calls": {s: fresh(calls.get(s)) for s, _, _ in SOURCES}, "installs": fresh(mem.get("installs")),
            "seen": {s: [x for x in (seen.get(s) if isinstance(seen.get(s), list) else []) if isinstance(x, str)][-SEEN_KEEP:]
                     for s, _, _ in SOURCES}}


def save_memory(mem):
    ensure_root_dir(STATE_DIR, 0o700)
    write_file(os.path.join(STATE_DIR, "requests.json"), json.dumps(mem, sort_keys=True).encode())


def spend(source, rid, action):
    """Counts this request; None when it may run, else the refusal code."""
    mem = load_memory()
    if rid in mem["seen"][source]:
        return "REPLAY"
    if len(mem["calls"][source]) >= REQUEST_LIMIT:
        return "RATE_LIMITED"
    if action in INSTALL_ACTIONS and len(mem["installs"]) >= INSTALL_LIMIT:
        return "RATE_LIMITED"
    mem["calls"][source].append(now())
    mem["seen"][source] = (mem["seen"][source] + [rid])[-SEEN_KEEP:]
    if action in INSTALL_ACTIONS:
        mem["installs"].append(now())
    save_memory(mem)
    return None


# ── facts of this server ─────────────────────────────────────────────────────────────────────────
def read_owned(dfd, name, uid, limit):
    """A file of `uid` inside the held directory: regular, single link, size cap. None when absent or not so."""
    try:
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_NOCTTY | os.O_CLOEXEC, dir_fd=dfd)
    except OSError:
        return None
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != uid or st.st_nlink != 1 or st.st_size > limit:
            return None
        return os.read(fd, limit)
    finally:
        os.close(fd)


def read_user_file(path, user, limit):
    """A file of `user` read without following any link on the way. None when absent or not so."""
    uid = uid_of(user)
    if uid is None:
        return None
    d, name = os.path.split(path)
    try:
        dfd, _ = open_dir_chain(d)
    except OSError:
        return None
    try:
        return read_owned(dfd, name, uid, limit)
    finally:
        os.close(dfd)


def env_last(raw, rx):
    found = None
    for line in (raw or b"").decode("utf-8", "replace").splitlines():
        m = rx.fullmatch(line)
        if m:
            found = m.group(1)  # the last assignment wins, as in a sourced env file
    return found


def bot_ids():
    """Bot directories under ~/.msb/bots, opened without following links, at most MAX_BOTS."""
    try:
        dfd, _ = open_dir_chain(os.path.join(CLIENT_HOME, ".msb", "bots"))
    except OSError:
        return []
    try:
        names = sorted(n for n in os.listdir(dfd) if BOT_ID_RE.fullmatch(n))[:MAX_BOTS]
    finally:
        os.close(dfd)
    return names


