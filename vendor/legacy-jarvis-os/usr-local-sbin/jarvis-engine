# ── OpenClaw: sorting a removed HOME (root, inside the root-only staging directory) ──────────────
def secret_name(x):
    return any(fnmatch.fnmatchcase(x, p) for p in SECRET_FILES)


def move_into(src, base, rel):
    target = os.path.join(base, rel)
    os.makedirs(os.path.dirname(target), 0o700, exist_ok=True)
    os.rename(src, target)


def scrub_data(top, secrets_base, rel_top):
    """Inside a tree of the owner's data: links go (never followed), anything not a plain file goes, hard-linked files
    and credential-named entries move to the root trash."""
    if not os.path.isdir(top) or os.path.islink(top):
        return
    for root, dirs, files in os.walk(top):
        for x in list(dirs):
            p = os.path.join(root, x)
            if os.path.islink(p):
                dirs.remove(x)
                os.unlink(p)
            elif x in SECRET_DIRS:
                dirs.remove(x)
                move_into(p, secrets_base, os.path.join(rel_top, os.path.relpath(p, top)))
        for x in files:
            p = os.path.join(root, x)
            st = os.lstat(p)
            if not stat.S_ISREG(st.st_mode):
                os.unlink(p)
            elif st.st_nlink > 1 or secret_name(x):
                move_into(p, secrets_base, os.path.join(rel_top, os.path.relpath(p, top)))


SNAP_PY = r'''
import os, re, sqlite3, sys, tempfile
data = sys.stdin.buffer.read()
nl = data.index(b"\n")
a, b = (int(x) for x in data[:nl].split())
db, wal = data[nl + 1:nl + 1 + a], data[nl + 1 + a:nl + 1 + a + b]
secret_table, secret_bytes = re.compile(sys.argv[1], re.I), re.compile(sys.argv[2].encode("latin-1"))
with tempfile.TemporaryDirectory() as d:
    p = os.path.join(d, "in.sqlite")
    with open(p, "wb") as f:
        f.write(db)
    if wal:
        with open(p + "-wal", "wb") as f:
            f.write(wal)
    src = sqlite3.connect(p)
    if hasattr(src, "setconfig") and hasattr(sqlite3, "SQLITE_DBCONFIG_DEFENSIVE"):
        src.setconfig(sqlite3.SQLITE_DBCONFIG_DEFENSIVE, True)
    src.execute("PRAGMA trusted_schema=OFF")
    work = sqlite3.connect(os.path.join(d, "work.sqlite"))
    src.backup(work)
    src.close()
    for (n,) in work.execute("SELECT name FROM sqlite_master WHERE type='table'").fetchall():
        if secret_table.search(n) and not n.startswith("sqlite_"):
            work.execute('DROP TABLE "%s"' % n.replace('"', '""'))
    work.commit()
    out = os.path.join(d, "out.sqlite")
    work.execute("VACUUM INTO ?", (out,))
    work.close()
    with open(out, "rb") as f:
        snap = f.read()
    if secret_bytes.search(snap):
        sys.stderr.write("SNAP_UNSAFE\n")
        sys.exit(3)
    sys.stdout.buffer.write(snap)
'''


def read_plain(dfd, name, limit):
    """A regular single-link file inside the held directory (any owner: the openclaw user is gone), size-capped.
    None when absent; "big" when over the cap; False when not a plain file."""
    try:
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_NOCTTY | os.O_CLOEXEC, dir_fd=dfd)
    except FileNotFoundError:
        return None
    except OSError:
        return False
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
            return False
        if st.st_size > limit:
            return "big"
        data = b""
        while True:
            chunk = os.read(fd, 1 << 20)
            if not chunk:
                return data
            data += chunk
            if len(data) > limit:
                return "big"
    finally:
        os.close(fd)


def history_snapshot(agent_dir, out_path):
    """A copy of the agent's SQLite store without its secret tables, kept only when no byte of it looks like a key or a
    token. Read without following links, cut in a throwaway sandbox (SNAP_SANDBOX), never parsed as root.
    "ok" | "none" (no store) | "unsafe" | "too_big" | "error". The original waits in the root trash, untouched."""
    try:
        dfd, _ = open_dir_chain(agent_dir)
    except OSError:
        return "none"
    try:
        db = read_plain(dfd, "openclaw-agent.sqlite", SNAP_MAX)
        wal = read_plain(dfd, "openclaw-agent.sqlite-wal", SNAP_MAX)
    finally:
        os.close(dfd)
    if db is None:
        return "none"
    if db == "big" or wal == "big":
        return "too_big"
    if db is False or wal is False:
        return "error"
    wal = wal or b""
    try:
        r = run(list(SNAP_SANDBOX) + ["python3", "-I", "-S", "-c", SNAP_PY, SECRET_TABLE_RE.pattern,
                                      SECRET_BYTES_RE.pattern.decode("latin-1")],
                timeout=360, input=b"%d %d\n" % (len(db), len(wal)) + db + wal)
    except subprocess.TimeoutExpired:
        return "error"
    if r.returncode == 3:
        return "unsafe"
    if r.returncode != 0 or not r.stdout.startswith(b"SQLite format 3\x00"):
        return "error"
    write_file(out_path, r.stdout, 0o600)
    return "ok"


def sort_openclaw_home(home, keep, out_archive, out_trash, out_secrets):
    """Split the staged OpenClaw HOME: the owner's data by category into the archive (kept) or the client trash (not
    kept), keys/tokens/config into the root trash, the installed program deleted. Layout of 2026.9.x
    (openclaw-facts-2026-10-10 §3): .openclaw/workspace[-<agent>] (personality, memory, working files),
    .openclaw/agents/<agent>/agent/openclaw-agent.sqlite (live history WITH keys), .openclaw/agents/<agent>/sessions and
    .openclaw/sessions (older transcripts), .openclaw/wiki (memory)."""
    counts = {"memory": 0, "sessions": 0, "files": 0, "trash": 0, "secrets": 0}
    history = {}
    def put(src, cat, rel):
        st = os.lstat(src)
        if not stat.S_ISDIR(st.st_mode):
            if not stat.S_ISREG(st.st_mode):
                os.unlink(src)  # a link, a fifo, a socket: not data
                return
            if st.st_nlink > 1 or secret_name(os.path.basename(src)):
                secret(src, os.path.join("in-data", cat, rel))
                return
        kept = keep.get(cat, True)
        base = out_archive if kept else out_trash
        counts[cat if kept else "trash"] += 1
        move_into(src, base, os.path.join(cat, rel))
        scrub_data(os.path.join(base, cat, rel), out_secrets, os.path.join("in-data", cat, rel))
    def secret(src, rel):
        counts["secrets"] += 1
        move_into(src, out_secrets, rel)
    def names(d):
        try:
            return sorted(os.listdir(d))
        except OSError:
            return []
    oc = os.path.join(home, ".openclaw")
    for top in names(oc):
        p = os.path.join(oc, top)
        if os.path.islink(p):
            os.unlink(p)
            continue
        is_dir = os.path.isdir(p)
        if is_dir and (top == "workspace" or top.startswith("workspace-")):
            for e in names(p):
                q = os.path.join(p, e)
                if os.path.islink(q):
                    os.unlink(q)
                elif secret_name(e) or e in SECRET_DIRS:
                    secret(q, os.path.join(".openclaw", top, e))
                else:
                    put(q, "memory" if e in OC_MEMORY_NAMES else "files", os.path.join(top, e))
        elif is_dir and top == "wiki":
            put(p, "memory", "wiki")
        elif is_dir and top == "sessions":
            put(p, "sessions", "sessions")
        elif is_dir and top == "agents":
            for a in names(p):
                ad = os.path.join(p, a)
                if os.path.islink(ad) or not os.path.isdir(ad) or not BOT_ID_RE.fullmatch(a):
                    secret(ad, os.path.join(".openclaw", "agents", a)) if os.path.lexists(ad) else None
                    continue
                sd = os.path.join(ad, "sessions")
                if os.path.isdir(sd) and not os.path.islink(sd):
                    put(sd, "sessions", os.path.join("agents", a, "sessions"))
                snap_dir = os.path.join(out_archive if keep.get("sessions", True) else out_trash, "sessions", "agents", a)
                os.makedirs(snap_dir, 0o700, exist_ok=True)
                verdict = history_snapshot(os.path.join(ad, "agent"), os.path.join(snap_dir, "history.sqlite"))
                history[a] = verdict
                if verdict == "ok":
                    counts["sessions" if keep.get("sessions", True) else "trash"] += 1
                if not os.listdir(snap_dir):
                    os.rmdir(snap_dir)
                secret(ad, os.path.join(".openclaw", "agents", a))  # the store with keys, codex-home, auth: root trash
        elif top in OC_PROGRAM_NAMES:
            rmtree_private(p)
        else:
            secret(p, os.path.join(".openclaw", top))
    # Outside .openclaw: the owner's own files (scrubbed, by the owner's «files» choice), never the root trash
    # where `restore` cannot reach them. Program caches go; tool configs and key directories go to the root trash.
    for top in names(home):
        p = os.path.join(home, top)
        if top == ".openclaw":
            continue
        if top in OC_HOME_PROGRAM or os.path.islink(p):
            rmtree_private(p)
        elif top.startswith(".") or top in SECRET_DIRS:
            # dot-entries (shell histories, tool configs, .local/share…) may hold keys typed or saved there: root trash
            secret(p, os.path.join("home", top))
        else:
            put(p, "files", os.path.join("home", top))
    rmtree_private(home)
    return counts, history


def chown_tree(top, uid, gid):
    """Hand a scrubbed tree to the owner: only directories and single-link regular files are handed over; anything
    else left in it (it should not be) is removed first. lchown, root-only staging around it, no process of the
    removed user alive (openclaw-uninstall.sh checks)."""
    for root, dirs, files in os.walk(top):
        os.chown(root, uid, gid, follow_symlinks=False)
        for x in list(dirs):
            p = os.path.join(root, x)
            if os.path.islink(p):
                dirs.remove(x)
                os.unlink(p)
            else:
                os.chown(p, uid, gid, follow_symlinks=False)
        for x in files:
            p = os.path.join(root, x)
            st = os.lstat(p)
            if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
                os.unlink(p)
            else:
                os.chown(p, uid, gid, follow_symlinks=False)


def hand_off(src, rel_dir, name):
    """Rename a tree from the root staging into ~/.msb/archive[/.trash] (created by client itself), the destination
    held by an O_NOFOLLOW descriptor chain: a link planted on the way leads nowhere. "home" = landed there; "root" =
    the fallback (e.g. another filesystem): kept root-only in /var/lib/jarvis-engine/archive, nothing erased."""
    dest_dir = os.path.join(CLIENT_HOME, ".msb", "archive", *([rel_dir] if rel_dir else []))
    uid, gid = uid_of("client"), gid_of("client")
    if uid is not None:
        try:
            as_user("client", [MKDIR, "-p", "-m", "0700", dest_dir])
            dfd, dst = open_dir_chain(dest_dir)
            try:
                if dst.st_uid != uid or dst.st_mode & 0o022:
                    raise OSError(errno.EPERM, "foreign archive dir")
                chown_tree(src, uid, gid)
                os.rename(src, name, dst_dir_fd=dfd)
                return "home"
            finally:
                os.close(dfd)
        except OSError:
            pass
    ensure_root_dir(ROOT_ARCHIVE, 0o700)
    if os.path.lexists(src):
        chown_tree(src, ROOT_UID, -1)  # root-only again, whatever the failed hand-off already changed
        os.rename(src, os.path.join(ROOT_ARCHIVE, ("trash-" if rel_dir else "") + name))
    return "root"


def xfer_dir(tag):
    """A staging directory openclaw can read and nobody else: XFER_DIR (root 0755) / <tag>.<rand> root:openclaw 0750."""
    ensure_root_dir(XFER_DIR, 0o755)
    d = os.path.join(XFER_DIR, "%s.%s" % (tag, os.urandom(6).hex()))
    os.mkdir(d, 0o700)
    gid = gid_of("openclaw")
    if gid is not None:
        os.chown(d, -1, gid)
    os.chmod(d, 0o750)  # the unit's UMask=0077 turns mkdir's 0750 into 0700: openclaw could not enter (stand 10.10)
    return d


def xfer_write(base, rel, data):
    gid = gid_of("openclaw")
    target = os.path.join(base, rel)
    parent = os.path.dirname(target)
    if not os.path.isdir(parent):
        os.makedirs(parent, 0o750, exist_ok=True)
        if gid is not None:
            d = parent
            while d != base:
                os.chown(d, -1, gid)
                os.chmod(d, 0o750)
                d = os.path.dirname(d)
    write_file(target, data, 0o640)
    if gid is not None:
        os.chown(target, -1, gid)


def read_client_tree(src_root, names, out_dir, prefix, budget):
    """Copy regular files of the client's workspace (named entries, one level of directories) into a root-staged dir,
    each opened with O_NOFOLLOW from a held directory chain; links, devices, big files skipped."""
    uid = uid_of("client")
    try:
        dfd, _ = open_dir_chain(src_root)
    except OSError:
        return
    try:
        for n in names:
            if budget[0] <= 0:
                return
            try:
                st = os.stat(n, dir_fd=dfd, follow_symlinks=False)
            except OSError:
                continue
            if stat.S_ISREG(st.st_mode):
                data = read_owned(dfd, n, uid, TRANSFER_MAX_FILE)
                if data is not None and len(data) <= budget[1]:
                    xfer_write(out_dir, os.path.join(prefix, n), data)
                    budget[0] -= 1
                    budget[1] -= len(data)
            elif stat.S_ISDIR(st.st_mode):
                try:
                    sub = os.open(n, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=dfd)
                except OSError:
                    continue
                try:
                    for m in sorted(os.listdir(sub))[:TRANSFER_MAX_FILES]:
                        if budget[0] <= 0:
                            break
                        data = read_owned(sub, m, uid, TRANSFER_MAX_FILE)
                        if data is not None and m.endswith((".md", ".txt")) and len(data) <= budget[1]:
                            xfer_write(out_dir, os.path.join(prefix, n, m), data)
                            budget[0] -= 1
                            budget[1] -= len(data)
                finally:
                    os.close(sub)
    finally:
        os.close(dfd)


def transfer_memory(work):
    """«🧠 В OpenClaw»: copies (never moves) of the Jarvis personality and memory into OpenClaw's workspace, written by
    openclaw itself (configure.sh seed). SOUL.md, USER.md, MEMORY.md and memory/ keep their names; the files without a
    counterpart (CLAUDE.md, TELOS) land in memory/jarvis-import/. Returns the number of files."""
    stage_dir = xfer_dir("transfer")
    try:
        budget = [TRANSFER_MAX_FILES, TRANSFER_MAX_BYTES]
        ws = os.path.join(CLIENT_HOME, "workspace")
        read_client_tree(ws, TRANSFER_SAME + ("memory",), stage_dir, "", budget)
        read_client_tree(ws, TRANSFER_IMPORT, stage_dir, os.path.join("memory", "jarvis-import"), budget)
        n = sum(len(f) for _, _, f in os.walk(stage_dir))
        if n == 0:
            return 0
        # OpenClaw's own SOUL/USER/MEMORY are not overwritten in place: moved to memory/before-jarvis-<stamp>/ first.
        result, info = script(work, unpack(work), "openclaw-configure.sh",
                              ["seed", stage_dir, "before-jarvis-" + stamp().lower()], timeout=120)
        if result != "ok":
            raise script_refused("failed", info)
        return n
    finally:
        rmtree_private(stage_dir)


