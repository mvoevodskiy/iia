                  "TOO_BIG": "too_big"}  # any other refusal = error
SNAPSHOT_RESULTS = ("ok", "partial", "skipped:hold", "skipped:pending_restore", "skipped:timeout", "skipped:too_big",
                    "skipped:error")
SNAP_TREES = ("wiki", "memory", "cron", "skills", "hooks", "sessions", "transcripts")  # in this order, after workspaces
SNAP_UNSCANNED = ("sessions", "transcripts")  # conversations: never cut by content (agents/<id>/sessions too)
SNAP_CORE_FILES = ("SOUL.md", "USER.md", "IDENTITY.md", "AGENTS.md", "MEMORY.md")
SNAP_SKIP_SUBTREES = (("skills", "config"),)   # skill configs (mcporter.json, …) carry MCP keys
SNAP_TEXT_EXTS = (".md", ".txt", ".markdown", "")   # text: cut like the memory copy, kept
SNAP_STRUCT_EXTS = (".json", ".jsonl", ".json5", ".yaml", ".yml", ".toml", ".env", ".ini", ".cfg", ".conf")
SNAP_HEX_CUT_RE = re.compile(r"(?<![0-9A-Fa-f])[0-9a-f]{32,40}(?![0-9A-Fa-f])")   # hex keys (32-40); sha256 stays
SNAP_WHY = ("core", "size", "scan", "time", "changed")
SNAP_SECRET_NAMES = ("token.json", "credentials*.json", "client_secret*.json", "*service*account*.json", "mcporter.json")
SNAP_WORKSPACE_RE = re.compile(r"workspace(?:-[A-Za-z0-9_.-]{1,64})?")
SNAP_TOKEN_RE = re.compile(r"telegram-[A-Za-z0-9_-]{1,32}\.token")
SNAP_SKIP_DIRS = ("node_modules", "logs", "cache", "caches", "tmp", "__pycache__", "sandboxes")  # + hidden + SECRET_DIRS
SNAP_SKIP_EXTS = (".log", ".tmp", ".pid", ".lock", ".sock")
SNAP_TAR_RE = re.compile(r"openclaw-snapshot(?:\.[0-9a-f]{16})?\.tar")
SNAP_FOREIGN_RE = re.compile(r"(?:openclaw-snapshot\.([0-9a-f]{16})\.tar|engines\.([0-9a-f]{16})\.json)")
SNAP_TMP_RE = re.compile(r"\.(?:openclaw-snapshot\.tar|engines\.json)\.tmp\.[0-9]{1,10}")
SNAP_NAME_RE = re.compile(r"[A-Za-z0-9@._/:+-]{1,200}")
ISO_RE = re.compile(r"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z")
HEX_KEY_RE = re.compile(r"(?<![0-9a-f])[0-9a-f]{32,}(?![0-9a-f])")
CONFIG_SRI_RE = re.compile(r"sha(?:1|256|384|512)-")
# The backup's hook: a drop-in of msb-backup.service. These exact bytes are allowed by the R2 switch
# (src/fleet/backup-r2-switch.ts ENGINE_SNAPSHOT_DROPIN_CONTENT / _NAME, compared by sha256): a test keeps them equal.
BACKUP_UNIT = "msb-backup.service"
BACKUP_UNIT_DIRS = ("/etc/systemd/system", "/lib/systemd/system", "/usr/lib/systemd/system")
BACKUP_DROPIN_DIR = "/etc/systemd/system/msb-backup.service.d"
BACKUP_DROPIN_NAME = "50-jarvis-engine-snapshot.conf"
BACKUP_DROPIN = b"[Service]\nExecStartPre=-/usr/local/sbin/jarvis-engine snapshot\n"
BACKUP_DROPIN_TMP_RE = re.compile(r"\.50-jarvis-engine-snapshot\.tmp\.[0-9]{1,10}")  # never *.conf: systemd ignores it


def backup_dropin_error(e):
    return e.code if isinstance(e, Refused) else "INTERNAL_" + type(e).__name__.upper()[:40]


def ensure_backup_dropin(reload=True):
    """The unit msb-backup.service on this host (a unit file in /etc, /lib or /usr/lib systemd): its drop-in
    50-jarvis-engine-snapshot.conf holds exactly BACKUP_DROPIN, a regular root file 0644 with one link. Written through
    a temp file that does not end in .conf (systemd would load a half-written one), then renamed; `daemon-reload` only
    when something changed (`reload`=False: setup reloads anyway), or when the drop-in is in place but systemd says it
    still needs a reload (an earlier reload failed). No unit = nothing (no directory either).
    "absent" | "same" | "reloaded" | "written"."""
    if not any(os.path.lexists(os.path.join(d, BACKUP_UNIT)) for d in BACKUP_UNIT_DIRS):
        return "absent"
    created = False
    try:
        os.mkdir(BACKUP_DROPIN_DIR, 0o755)
        created = True
    except FileExistsError:
        pass
    dfd = os.open(BACKUP_DROPIN_DIR, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        dst = os.fstat(dfd)
        if dst.st_uid != ROOT_UID or dst.st_mode & 0o022:
            raise Refused("DIR", "failed")
        if created:
            os.fchmod(dfd, 0o755)  # as systemd's own directories (the umask 077 of the helper made it 0700)
        for name in os.listdir(dfd):  # temp files of a run killed halfway
            if BACKUP_DROPIN_TMP_RE.fullmatch(name):
                try:
                    os.unlink(name, dir_fd=dfd)
                except OSError:
                    pass
        try:
            st = os.stat(BACKUP_DROPIN_NAME, dir_fd=dfd, follow_symlinks=False)
            sound = stat.S_ISREG(st.st_mode) and st.st_uid == ROOT_UID and st.st_nlink == 1 and \
                stat.S_IMODE(st.st_mode) == 0o644 and st.st_size == len(BACKUP_DROPIN) and \
                read_owned(dfd, BACKUP_DROPIN_NAME, ROOT_UID, len(BACKUP_DROPIN)) == BACKUP_DROPIN
        except FileNotFoundError:
            sound = False
        if sound:
            if reload and systemctl_word("show", "-p", "NeedDaemonReload", BACKUP_UNIT) == "NeedDaemonReload=yes":
                if not systemctl_ok("daemon-reload"):
                    print("JARVIS_ENGINE_BACKUP_DROPIN_RELOAD", file=sys.stderr)
                return "reloaded"
            return "same"
        tmp = ".%s.tmp.%d" % (BACKUP_DROPIN_NAME[:-len(".conf")], os.getpid())
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o644, dir_fd=dfd)
        try:
            try:
                view = memoryview(BACKUP_DROPIN)
                while view:
                    view = view[os.write(fd, view):]
                os.fchmod(fd, 0o644)
                os.fsync(fd)
            finally:
                os.close(fd)
            os.rename(tmp, BACKUP_DROPIN_NAME, src_dir_fd=dfd, dst_dir_fd=dfd)  # a link there is replaced, not followed
        except BaseException:
            try:
                os.unlink(tmp, dir_fd=dfd)
            except OSError:
                pass
            raise
        os.fsync(dfd)
    finally:
        os.close(dfd)
    if reload and not systemctl_ok("daemon-reload"):
        print("JARVIS_ENGINE_BACKUP_DROPIN_RELOAD", file=sys.stderr)
    return "written"


def machine_hash():
    """The first 16 hex of sha256 over /etc/machine-id as it is on disk, the newline included
    (= `sha256sum /etc/machine-id | cut -c1-16`). A server brought up from a provider's disk image of another server
    inherits its machine-id: the pending-restore guard then takes the other server's snapshot for its own. Our moves
    install a clean image (a new machine-id), so the guard holds for them."""
    raw = read_small(MACHINE_ID, 256)
    if raw is None or not re.fullmatch(rb"[0-9a-f]{32}\n?", raw):
        raise Refused("NO_MACHINE_ID")
    return hashlib.sha256(raw).hexdigest()[:16]


def snapshot_record():
    raw = read_small(SNAPSHOT_RECORD, 4096)
    try:
        rec = json.loads(raw.decode()) if raw else {}
    except Exception:
        rec = {}
    return rec if isinstance(rec, dict) else {}


def snapshot_public():
    """state.json `snapshot`: the last run's result, when it ran, the OpenClaw snapshot in place (its time), why it is
    partial (`why`: core, size, scan, time, changed; null = whole), and the tick's word on the tars' owner (`file`:
    ok = root 0600, bad = not a plain single-link file, left alone). A host on hold never runs it: `skipped:hold`
    whatever an earlier run said."""
    rec = snapshot_record()
    iso_or_none = lambda v: v if isinstance(v, str) and ISO_RE.fullmatch(v) else None
    word = (read_small(SNAPSHOT_FILE_STATE, 16) or b"").decode("ascii", "replace").strip()
    why = rec.get("why") if isinstance(rec.get("why"), list) else []
    out = {"result": rec.get("result") if rec.get("result") in SNAPSHOT_RESULTS else None,
           "at": iso_or_none(rec.get("at")), "snapshot_at": iso_or_none(rec.get("snapshot_at")),
           "file": word if word in ("ok", "bad") else None,
           "why": ",".join(w for w in SNAP_WHY if w in why) or None}
    if host_refusal() or os.path.lexists(STAGED_HOLD):
        out["result"] = "skipped:hold"
    return out


def save_snapshot_record(result, snapshot_at, why=()):
    """Root, never raises: a record that cannot be written only leaves the previous word in state.json."""
    try:
        ensure_root_dir(STATE_DIR, 0o700)
        write_file(SNAPSHOT_RECORD, json.dumps({"result": result, "at": iso(), "snapshot_at": snapshot_at,
                                                "why": list(why)}, sort_keys=True).encode())
    except Exception:
        print("JARVIS_ENGINE_SNAPSHOT_RECORD", file=sys.stderr)


def prev_snapshot_at():
    v = snapshot_record().get("snapshot_at")
    return v if isinstance(v, str) and ISO_RE.fullmatch(v) else None


def rmtree_at(dfd, name, depth=0):
    """Remove `name` inside the held directory; a link is unlinked, never entered; directories are opened O_NOFOLLOW."""
    try:
        st = os.stat(name, dir_fd=dfd, follow_symlinks=False)
    except FileNotFoundError:
        return
    if not stat.S_ISDIR(st.st_mode):
        os.unlink(name, dir_fd=dfd)
        return
    if depth > 4 * SNAPSHOT_MAX_DEPTH:
        raise OSError(errno.ELOOP, "too deep")
    fd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=dfd)
    try:
        for n in os.listdir(fd):
            rmtree_at(fd, n, depth + 1)
    finally:
        os.close(fd)
    os.rmdir(name, dir_fd=dfd)


def open_archive_dir(uid, gid, create=True):
    """~/.msb/archive held by an O_NOFOLLOW descriptor chain from "/": every component a real directory. The client's
    HOME and ~/.msb owned by client (or root), ~/.msb/archive by client, none writable by group or others. Absent: created
    (client 0700), or None with create=False."""
    try:
        hfd, hst = open_dir_chain(CLIENT_HOME)
    except OSError:
        raise Refused("ARCHIVE_PATH")
    fds = [hfd]
    try:
        def sound(st, owners):
            return st.st_uid in owners and not st.st_mode & 0o022
        if not sound(hst, (uid, ROOT_UID)):
            raise Refused("ARCHIVE_PATH")
        try:
            ifd = os.open(".msb", os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=hfd)
        except OSError:
            raise Refused("ARCHIVE_PATH")
        fds.append(ifd)
        if not sound(os.fstat(ifd), (uid, ROOT_UID)):
            raise Refused("ARCHIVE_PATH")
        created = False
        if create:
            try:
                os.mkdir("archive", 0o700, dir_fd=ifd)
                created = True
            except FileExistsError:
                pass
        try:
            afd = os.open("archive", os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=ifd)
        except FileNotFoundError:
            if create:
                raise Refused("ARCHIVE_PATH")
            return None
        except OSError:
            raise Refused("ARCHIVE_PATH")
        try:
            if created and os.fstat(afd).st_uid == ROOT_UID:
                os.fchown(afd, uid, gid)
                os.fchmod(afd, 0o700)
            if not sound(os.fstat(afd), (uid,)):
                raise Refused("ARCHIVE_PATH")
        except BaseException:
            os.close(afd)
            raise
        return afd
    finally:
        for fd in fds:
            os.close(fd)


def entry_kind(dfd, name):
    try:
        return stat.S_IFMT(os.stat(name, dir_fd=dfd, follow_symlinks=False).st_mode)
    except FileNotFoundError:
        return None


def read_engines(afd):
    """engines.json in the archive: (parsed dict or None, its bytes or None). A link or anything but a regular file
    = (None, None), never followed."""
    try:
        fd = os.open(ENGINES_NAME, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_NOCTTY | os.O_CLOEXEC, dir_fd=afd)
    except OSError:
        return None, None
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_size > 64 << 10:
            return None, None
        data = os.read(fd, (64 << 10) + 1)
    finally:
        os.close(fd)
    try:
        doc = json.loads(data.decode("utf-8"))
    except Exception:
        return None, data
    return (doc if isinstance(doc, dict) else None), data


def write_temp_at(afd, name, data, uid, gid, mode=0o600):
    """A new file `name` in the held directory (O_EXCL, no link followed), owner uid:gid, `mode`, every byte, fsync."""
    rmtree_at(afd, name)
    fd = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600, dir_fd=afd)
    try:
        os.fchown(fd, uid, gid)
        os.fchmod(fd, mode)
        view = memoryview(data)
        while view:
            view = view[os.write(fd, view):]
        os.fsync(fd)
    finally:
        os.close(fd)


def unlink_quiet(dfd, name):
    try:
        os.unlink(name, dir_fd=dfd)
    except OSError:
        pass


# ── openclaw.json: an allowlist of what a restore needs (review 12.10: a denylist of secret names misses
# models.providers.*.request.auth.value, custom headers, mcp env, proxy URLs; reference/secretref-credential-surface.md)
_CFG_DROP = object()
CFG_KEY_RE = re.compile(r"[A-Za-z0-9@._/-]{1,128}")
CFG_ID_RE = re.compile(r"[A-Za-z0-9:@_.-]{1,64}")
CFG_WORD_RE = re.compile(r"[A-Za-z_-]{1,32}")
CFG_PATH_RE = re.compile(r"/[A-Za-z0-9@._/-]{1,255}")
CFG_CMD_RE = re.compile(r"[a-z0-9_]{1,32}")
CFG_DURATION_RE = re.compile(r"[0-9]{1,6}(?:ms|s|m|h|d)?")
CFG_LOCALE_RE = re.compile(r"[A-Za-z]{2,3}(?:[-_][A-Za-z0-9]{2,8}){0,2}")


def config_secret_value(v):
    """A string that looks like a key or a token: a known shape, a long random-looking run, a long hex key."""
    if IMPORT_SECRET_RE.search(v) or HEX_KEY_RE.search(v):
        return True
    return not CONFIG_SRI_RE.match(v) and any(looks_random(r) for r in IMPORT_RANDOM_RE.findall(v))


def _cfg_bool(v):
    return v if isinstance(v, bool) else _CFG_DROP


def _cfg_re(rx):
    return lambda v: v if isinstance(v, str) and rx.fullmatch(v) and not config_secret_value(v) else _CFG_DROP


def _cfg_id(v):
    if isinstance(v, int) and not isinstance(v, bool) and 0 <= v < 10 ** 20:
        return v
    return _cfg_re(CFG_ID_RE)(v)


def _cfg_text(v):
    ok = isinstance(v, str) and len(v) <= 256 and not any(ord(ch) < 32 for ch in v) and not config_secret_value(v)
    return v if ok else _CFG_DROP


def _cfg_bot_token(v):
    """The Telegram bot token (the owner's decision 11.10): null, or one token-shaped string."""
    return v if v is None or (isinstance(v, str) and TG_TOKEN_RE.fullmatch(v)) else _CFG_DROP


def _cfg_model_id(v):
    return v if isinstance(v, str) and MODEL_ID_RE.fullmatch(v) and "/" in v and not config_secret_value(v) else _CFG_DROP


def _cfg_model(v):
    if isinstance(v, str):
        return _cfg_model_id(v)
    return config_pick(v, {"primary": _cfg_model_id, "fallbacks": [_cfg_model_id]})


CFG_TG_ACCOUNT = {"enabled": _cfg_bool, "tokenFile": _cfg_re(CFG_PATH_RE), "botToken": _cfg_bot_token,
                  "dmPolicy": _cfg_re(CFG_WORD_RE), "allowFrom": [_cfg_id], "name": _cfg_text}
CONFIG_KEEP = {
    "channels": {"telegram": dict(CFG_TG_ACCOUNT, groupPolicy=_cfg_re(CFG_WORD_RE), groupAllowFrom=[_cfg_id],
                                  commands={"native": _cfg_bool, "nativeSkills": _cfg_bool},
                                  customCommands=[{"command": _cfg_re(CFG_CMD_RE), "description": _cfg_text}],
                                  accounts={"*": CFG_TG_ACCOUNT})},
    "agents": {"defaults": {"model": _cfg_model, "heartbeat": {"every": _cfg_re(CFG_DURATION_RE)}}},
    "plugins": {"entries": {"*": {"enabled": _cfg_bool}}, "load": {"paths": [_cfg_re(CFG_PATH_RE)]}},
    "cron": {"enabled": _cfg_bool},
    "ui": {"prefs": {"locale": _cfg_re(CFG_LOCALE_RE)}},
}


def config_pick(node, spec, depth=0):
    """What `spec` names of `node` and nothing else: a dict spec takes its keys ("*" = any key of CFG_KEY_RE), a
    one-item list spec takes the items that pass, a function checks a value. Anything not named = not taken."""
    if depth > 16:
        return _CFG_DROP
    if callable(spec):
        return spec(node)
    if isinstance(spec, list):
        if not isinstance(node, list):
            return _CFG_DROP
        return [x for x in (config_pick(i, spec[0], depth + 1) for i in node[:256]) if x is not _CFG_DROP]
    if not isinstance(node, dict):
        return _CFG_DROP
    out = {}
    for k, v in node.items():
        sub = spec.get(k) if isinstance(k, str) and k != "*" else None
        if sub is None and "*" in spec and isinstance(k, str) and CFG_KEY_RE.fullmatch(k):
            sub = spec["*"]
        if sub is None:
            continue
        c = config_pick(v, sub, depth + 1)
        if c is not _CFG_DROP:
            out[k] = c
    return out


def config_bot_tokens(cfg):
    """The token-shaped botToken values the picked config kept (channels.telegram[.accounts.*].botToken)."""
    tg = (cfg.get("channels") or {}).get("telegram") or {}
    found = [tg.get("botToken")] + [a.get("botToken") for a in (tg.get("accounts") or {}).values() if isinstance(a, dict)]
    return [t for t in found if isinstance(t, str)]


def config_facts(cfg, extensions):
    """(provider, model_id, plugins) from the picked config: the default model (agents.defaults.model[.primary]) and the
    plugin list (plugins.entries, plugins.load.paths, the package directories under ~/.openclaw/extensions)."""
    def get(d, *keys):
        for k in keys:
            d = d.get(k) if isinstance(d, dict) else None
        return d
    names = lambda xs: sorted({x for x in xs if isinstance(x, str) and SNAP_NAME_RE.fullmatch(x)})[:SNAPSHOT_LIST]
    model = get(cfg, "agents", "defaults", "model")
    model = model.get("primary") if isinstance(model, dict) else model
    provider = None
    if not isinstance(model, str):
        model = None
    else:
        head = model.split("/", 1)[0]
        provider = head if re.fullmatch(r"[a-z0-9][a-z0-9-]{0,31}", head) else None
    entries = get(cfg, "plugins", "entries")
    entries = entries if isinstance(entries, dict) else {}
    paths = get(cfg, "plugins", "load", "paths")
    plugins = {"entries": names(entries), "enabled": names(k for k, v in entries.items() if get(v, "enabled") is True),
               "load_paths": names(paths if isinstance(paths, list) else []), "installed": names(extensions)}
    return provider, model, plugins


def snap_secret_name(n):
    low = n.lower()
    return secret_name(n) or any(fnmatch.fnmatchcase(low, p) for p in SNAP_SECRET_NAMES)


class _RestStop(Exception):
    """The rest of the snapshot is out of time (deadline − SNAPSHOT_REST_MARGIN): what is in, stays; partial `time`."""


class SnapTar:
    """The tar being written (root 0600 temp file), member by member, by hand: a ustar/pax header (TarInfo.tobuf), the
    data, the padding. Data goes in 1 MB pieces, never whole in memory (a file read for its content check is at most
    SNAP_SCAN_MAX). Limits, what was taken, what was left out and why."""
    def __init__(self, deadline, oc_uid, afd, f):
        import tarfile
        self.deadline, self.oc_uid, self.afd, self.f = deadline, oc_uid, afd, f
        self.tarinfo, self.pax = tarfile.TarInfo, tarfile.PAX_FORMAT
        self.files = 0
        self.taken = set()  # relative paths already handled (taken or left out): a later pass never takes them again
        self.skipped = {}
        self.why = set()    # why the snapshot is partial: size | scan | time | changed | core
        self.lists = {"too_big": [], "too_big_to_scan": [], "changed": [], "secret_content": [], "core_left_out": [],
                      "scrubbed": []}
        self.cuts = 0

    def check(self, core=True):
        """The main part has the whole deadline (past it: TIMEOUT, nothing replaced); the rest stops
        SNAPSHOT_REST_MARGIN earlier, so the snapshot is closed and put in place in time."""
        t = time.monotonic()
        if core:
            if t > self.deadline:
                raise Refused("TIMEOUT")
        elif t > self.deadline - SNAPSHOT_REST_MARGIN:
            raise _RestStop()

    def skip(self, why):
        self.skipped[why] = self.skipped.get(why, 0) + 1

    def note(self, key, path, reason=None, core=False):
        """A file left out (or changed) and named in manifest.json; `reason` makes the snapshot partial."""
        if len(self.lists[key]) < SNAPSHOT_LIST:
            self.lists[key].append(path)
        if reason:
            self.why.add(reason)
        if core:
            self.why.add("core")
            if len(self.lists["core_left_out"]) < SNAPSHOT_LIST:
                self.lists["core_left_out"].append(path)

    def left(self):
        """Bytes a member's data may still take (its header and padding, then manifest.json, README.md, end blocks)."""
        return SNAPSHOT_MAX_BYTES - self.f.tell() - SNAPSHOT_TAIL - 2048

    def room(self, n):
        s = os.fstatvfs(self.afd)
        if s.f_bavail * s.f_frsize - n < SNAPSHOT_MIN_FREE:
            raise Refused("NO_DISK")

    def header(self, arcname, size, mtime):
        ti = self.tarinfo(arcname)
        ti.size, ti.mtime, ti.mode, ti.uid, ti.gid, ti.uname, ti.gname = size, int(mtime), 0o600, 0, 0, "", ""
        self.f.write(ti.tobuf(self.pax, "utf-8", "strict"))

    def pad(self, size):
        self.f.write(b"\0" * ((512 - size % 512) % 512))

    def rollback(self, pos):
        self.f.flush()
        self.f.seek(pos)
        self.f.truncate()

    def add(self, arcname, data, mtime):
        """A member from bytes in memory (the config, the token, a checked small file, the manifest, the README)."""
        self.room(len(data))
        self.header(arcname, len(data), mtime)
        self.f.write(data)
        self.pad(len(data))
        self.files += 1

    def stream(self, arcname, fd, st, core):
        """A member copied from the open file in 1 MB pieces under a header of its fstat size. The file must stay that
        size (no short read, nothing more, the same size and time after): else the member is cut off again and False."""
        size = st.st_size
        self.room(size)
        pos = self.f.tell()
        try:
            self.header(arcname, size, st.st_mtime)
            left = size
            while left:
                chunk = os.read(fd, min(1 << 20, left))
                if not chunk:
                    break
                self.f.write(chunk)
                left -= len(chunk)
                self.check(core)
            after = os.fstat(fd)
            same = not left and not os.read(fd, 1) and after.st_size == size and after.st_mtime_ns == st.st_mtime_ns
            if not same:
                self.rollback(pos)
                return False
            self.pad(size)
        except BaseException:
            self.rollback(pos)
            raise
        self.files += 1
        return True

    def read_small(self, fd, st, core):
        """The whole file (at most SNAP_SCAN_MAX, pieces joined once), or None when it changed while read."""
        parts, got = [], 0
        while got < st.st_size:
            chunk = os.read(fd, min(1 << 20, st.st_size - got))
            if not chunk:
                return None
            parts.append(chunk)
            got += len(chunk)
            self.check(core)
        after = os.fstat(fd)
        if os.read(fd, 1) or after.st_size != st.st_size or after.st_mtime_ns != st.st_mtime_ns:
            return None
        return b"".join(parts)

    def clean(self, name, path, data, core):
        """A checked file's bytes as they go in, or None (left out: key-like content). Text (.md, .txt, no extension, valid
        UTF-8) is CUT like the memory copy (scrub_secrets, then 32-40 hex runs) and kept; structured files (json, yaml,
        toml, env, ini) are left out on a secret's name or shape; anything else on a secret's shape."""
        ext = os.path.splitext(name)[1].lower()
        if ext in SNAP_TEXT_EXTS:
            try:
                text = data.decode("utf-8")
                if "\0" in text:
                    raise ValueError
            except ValueError:
                text = None
            if text is not None:
                text, cuts = scrub_secrets(text)
                text, more = SNAP_HEX_CUT_RE.subn(IMPORT_CUT, text)
                if IMPORT_SECRET_RE.search(text):  # fail-closed: should never fire after the scrub, kept on purpose
                    self.skip("secret_content")
                    self.note("secret_content", path, core=core)
                    return None
                if cuts + more:
                    self.cuts += cuts + more
                    self.note("scrubbed", path)
                return text.encode("utf-8")
        shaped = IMPORT_SECRET_RE.search(data.decode("latin-1")) is not None
        if ext in SNAP_STRUCT_EXTS:
            raw = data.decode("latin-1")
            shaped = shaped or SECRET_BYTES_RE.search(data) is not None or SNAP_HEX_CUT_RE.search(raw) is not None or \
                (not CONFIG_SRI_RE.search(raw) and any(looks_random(r) for r in IMPORT_RANDOM_RE.findall(raw)))
        if shaped:
            self.skip("secret_content")
            self.note("secret_content", path, core=core)
            return None
        return data

    def take(self, sfd, name, rel, scan, core):
        """One plain file of openclaw (O_NOFOLLOW in the held directory, a regular file of openclaw with one link) into
        openclaw/<rel>. Not fitting: the main part = TOO_BIG, the rest = left out and named (partial `size`). Checked
        (`scan`: everything but conversations) only up to SNAP_SCAN_MAX (text: SNAP_SCRUB_MAX): a bigger one is left out
        (partial `scan`)."""
        self.check(core)
        if rel in self.taken:
            return
        self.taken.add(rel)
        path = "/".join(rel)
        try:
            path.encode("utf-8")
            odd = any(ord(ch) < 32 or ord(ch) == 127 for ch in path)
        except UnicodeEncodeError:
            odd = True
        if odd:
            self.skip("odd_name")
            return
        try:
            fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_NOCTTY | os.O_CLOEXEC, dir_fd=sfd)
        except OSError:
            self.skip("not_plain")
            return
        try:
            st = os.fstat(fd)
            if not stat.S_ISREG(st.st_mode):
                self.skip("not_plain")
                return
            if st.st_nlink != 1 or st.st_uid != self.oc_uid:
                self.skip("linked_or_foreign")
                return
            if st.st_size > self.left():
                if core:
                    raise Refused("TOO_BIG")  # the main part does not fit: no snapshot, the previous one stays
                self.skip("too_big")
                self.note("too_big", path, "size")
                return
            if not scan:
                if not self.stream("openclaw/" + path, fd, st, core):
                    self.skip("changed")
                    self.note("changed", path, "changed", core)
                return
            if st.st_size > (SNAP_SCRUB_MAX if os.path.splitext(name)[1].lower() in SNAP_TEXT_EXTS else SNAP_SCAN_MAX):
                self.skip("too_big_to_scan")
                self.note("too_big_to_scan", path, "scan", core)
                return
            data = self.read_small(fd, st, core)
        finally:
            os.close(fd)
        if data is None:
            self.skip("changed")
            self.note("changed", path, "changed", core)
            return
        data = self.clean(name, path, data, core)
        if data is None:
            return
        if len(data) > self.left():  # a cut can be longer than what it cut
            if core:
                raise Refused("TOO_BIG")
            self.skip("too_big")
            self.note("too_big", path, "size")
            return
        self.add("openclaw/" + path, data, st.st_mtime)

    def tree(self, sfd, rel, depth, scan, core):
        """A directory of openclaw, held open: everything allowed in it, recursively (taken files skipped)."""
        for n in sorted(os.listdir(sfd)):
            self.check(core)
            r = rel + (n,)
            if r in self.taken:
                continue
            kind = entry_kind(sfd, n)
            if kind == stat.S_IFDIR:
                if n.startswith(".") or n in SNAP_SKIP_DIRS or n.lower() in SECRET_DIRS or r in SNAP_SKIP_SUBTREES or \
                        depth >= SNAPSHOT_MAX_DEPTH:
                    self.skip("dir")
                    continue
                self.subtree(sfd, n, r, depth + 1, scan, core)
            elif kind == stat.S_IFREG:
                if snap_secret_name(n):
                    self.skip("secret_name")
                elif n.lower().endswith(SNAP_SKIP_EXTS):
                    self.skip("log_tmp")
                else:
                    self.take(sfd, n, r, scan, core)
            elif kind is not None:
                self.skip("not_plain")  # a link, a fifo, a socket, a device

    def subtree(self, sfd, name, rel, depth, scan, core):
        try:
            sub = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=sfd)
        except OSError:
            self.skip("not_plain")
            return False
        try:
            if os.fstat(sub).st_uid != self.oc_uid:
                self.skip("linked_or_foreign")
                return False
            self.tree(sub, rel, depth, scan, core)
            self.taken.add(rel)  # done: the next pass does not enter it again
            return True
        finally:
            os.close(sub)


def snapshot_config(c, sfd, man):
    """openclaw.json, only what CONFIG_KEEP names, into the tar. Returns the picked config ({} when none)."""
    got = None
    if entry_kind(sfd, "openclaw.json") == stat.S_IFREG:
        try:
            fd = os.open("openclaw.json", os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_NOCTTY | os.O_CLOEXEC,
                         dir_fd=sfd)
        except OSError:
            fd = None
        if fd is not None:
            try:
                st = os.fstat(fd)
                if stat.S_ISREG(st.st_mode) and st.st_nlink == 1 and st.st_uid == c.oc_uid and \
                        st.st_size <= SNAPSHOT_CONFIG_MAX:
                    got = (os.read(fd, SNAPSHOT_CONFIG_MAX + 1), st)
            finally:
                os.close(fd)
    if got is None or len(got[0]) > SNAPSHOT_CONFIG_MAX:
        man["config"] = "absent" if entry_kind(sfd, "openclaw.json") is None else "unreadable"
        return {}
    raw, st = got
    try:
        cfg = json.loads(raw.decode("utf-8"))
    except Exception:
        cfg = None
    if not isinstance(cfg, dict):
        man["config"] = "not_json"
        return {}
    picked = config_pick(cfg, CONFIG_KEEP)
    text = json.dumps(picked, indent=2, ensure_ascii=False) + "\n"
    check = text
    for t in config_bot_tokens(picked):
        check = check.replace(t, "")
    if IMPORT_SECRET_RE.search(check) or HEX_KEY_RE.search(check):
        man["config"] = "secret_left"  # fail-closed: should never fire after the allowlist, kept on purpose
        return {}
    data = text.encode("utf-8", "replace")
    if len(data) > c.left():
        raise Refused("TOO_BIG")
    c.add("openclaw/openclaw.json", data, st.st_mtime)
    man["config"] = "picked"
    man["config_left_out"] = sorted(k for k in cfg if isinstance(k, str) and SNAP_NAME_RE.fullmatch(k)
                                    and k not in CONFIG_KEEP)[:SNAPSHOT_LIST]
    man["included"].append("openclaw.json")
    return picked


def snapshot_token(c, sfd, name, man):
    """The Telegram bot token file (owner's decision 11.10): as it is, only when it holds one token-shaped line."""
    try:
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_NOCTTY | os.O_CLOEXEC, dir_fd=sfd)
    except OSError:
        return False
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1 or st.st_uid != c.oc_uid or st.st_size > 512:
            return False
        data = os.read(fd, 513)
    finally:
        os.close(fd)
    if not TG_TOKEN_RE.fullmatch(data.decode("ascii", "replace").strip()):
        c.skip("token_shape")
        return False
    c.add("openclaw/" + name, data, st.st_mtime)
    man["included"].append(name)
    return True


def snapshot_openclaw(c, man):
    """The allowed parts of ~/.openclaw into the tar under openclaw/: the main part first (config, token, personality,
    memory), then the rest while it fits. Returns {token, provider, model_id}."""
    try:
        sfd, sst = open_dir_chain(os.path.join(OC_HOME, ".openclaw"))
    except OSError:
        raise Refused("NO_OPENCLAW_STATE")
    facts = {"token": False}
    try:
        if sst.st_uid != c.oc_uid:
            raise Refused("OPENCLAW_STATE_OWNER")
        names = sorted(os.listdir(sfd))
        kinds = {n: entry_kind(sfd, n) for n in names}
        workspaces = [n for n in names if kinds[n] == stat.S_IFDIR and SNAP_WORKSPACE_RE.fullmatch(n)]
        # 1. the main part: what makes this OpenClaw this owner's (does not fit = TOO_BIG)
        cfg = snapshot_config(c, sfd, man)
        for n in names:
            if SNAP_TOKEN_RE.fullmatch(n) and kinds[n] == stat.S_IFREG and snapshot_token(c, sfd, n, man):
                facts["token"] = True
        facts["token"] = facts["token"] or bool(config_bot_tokens(cfg))
        for ws in workspaces:
            try:
                wfd = os.open(ws, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=sfd)
            except OSError:
                continue
            try:
                if os.fstat(wfd).st_uid != c.oc_uid:
                    continue
                for f in SNAP_CORE_FILES:
                    if entry_kind(wfd, f) == stat.S_IFREG:
                        c.take(wfd, f, (ws, f), True, True)
                if entry_kind(wfd, "memory") == stat.S_IFDIR:
                    c.subtree(wfd, "memory", (ws, "memory"), 2, True, True)
            finally:
                os.close(wfd)
        # 2. the rest while it fits and while there is time: the workspaces, then the trees, conversations last
        try:
            for ws in workspaces:
                if c.subtree(sfd, ws, (ws,), 1, True, False):
                    man["included"].append(ws + "/")
            for n in [t for t in SNAP_TREES if t not in SNAP_UNSCANNED]:
                if kinds.get(n) == stat.S_IFDIR and c.subtree(sfd, n, (n,), 1, True, False):
                    man["included"].append(n + "/")
            if kinds.get("agents") == stat.S_IFDIR:
                snapshot_agents(c, sfd, man)
            for n in SNAP_UNSCANNED:
                if kinds.get(n) == stat.S_IFDIR and c.subtree(sfd, n, (n,), 1, False, False):
                    man["included"].append(n + "/")
        except _RestStop:
            c.why.add("time")  # what is in stays; the snapshot is closed as partial
        extensions = []
        if kinds.get("extensions") == stat.S_IFDIR:
            try:
                efd = os.open("extensions", os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=sfd)
                try:
                    extensions = os.listdir(efd)
                finally:
                    os.close(efd)
            except OSError:
                pass
        facts["provider"], facts["model_id"], man["plugins"] = config_facts(cfg, extensions)
        taken_top = {"openclaw.json", "agents"} | set(workspaces) | set(SNAP_TREES)
        excluded = [n for n in names if n not in taken_top and not (SNAP_TOKEN_RE.fullmatch(n) and n in man["included"])]
        fixed = (["agents/*/agent"] if kinds.get("agents") == stat.S_IFDIR else []) + \
            (["skills/config"] if kinds.get("skills") == stat.S_IFDIR else [])
        man["excluded"] = ([x for x in excluded if SNAP_NAME_RE.fullmatch(x)] + fixed)[:SNAPSHOT_LIST]
    finally:
        os.close(sfd)
    return facts


def snapshot_agents(c, sfd, man):
    """agents/<id>/sessions only (older and archived transcripts, never cut by content). agents/<id>/agent never: its
    openclaw-agent.sqlite keeps the model auth profiles with the live history, beside auth-profiles.json, auth.json,
    codex-home."""
    try:
        afd = os.open("agents", os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=sfd)
    except OSError:
        return
    try:
        if os.fstat(afd).st_uid != c.oc_uid:
            return
        for a in sorted(n for n in os.listdir(afd) if BOT_ID_RE.fullmatch(n))[:SNAPSHOT_LIST]:
            c.check(False)
            if entry_kind(afd, a) != stat.S_IFDIR:
                continue
            try:
                one = os.open(a, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=afd)
            except OSError:
                continue
            try:
                if os.fstat(one).st_uid == c.oc_uid and entry_kind(one, "sessions") == stat.S_IFDIR and \
                        c.subtree(one, "sessions", ("agents", a, "sessions"), 3, False, False):
                    man["included"].append("agents/%s/sessions/" % a)
            finally:
                os.close(one)
    finally:
        os.close(afd)


