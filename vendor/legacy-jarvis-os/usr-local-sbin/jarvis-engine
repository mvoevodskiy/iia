def plugin_settled(info):
    """The configure/plugin step's word on the plugin: wired (and reloaded or nothing to reload), switched off by the
    owner, or no plugin files: nothing left for the tick."""
    return info.get("plugin") in ("off", "absent") or \
        (info.get("plugin") == "wired" and info.get("reload", "skipped") in ("ok", "skipped"))


def rewire_plugin(work):
    """Flagged plugin files under an installed OpenClaw: wired (idempotent) and reloaded in the running gateway by
    openclaw-configure.sh plugin. At most PLUGIN_TRIES ticks per helper version (setup of the next version re-arms)."""
    flag = plugin_flag()
    if flag is None or flag[0] >= PLUGIN_TRIES:
        return
    write_file(PLUGIN_STALE, ("%d %s" % (flag[0] + 1, HELPER_VERSION)).encode(), 0o600)
    result, info = script(work, unpack(work), "openclaw-configure.sh", ["plugin"], timeout=300)
    if result == "ok" and plugin_settled(info):
        os.unlink(PLUGIN_STALE)
    else:
        print("JARVIS_ENGINE_PLUGIN_%s" % (info if isinstance(info, str) else
                                           "%s_%s" % (info.get("plugin", ""), info.get("reload", ""))).upper(),
              file=sys.stderr)


def purge_trash():
    """Trash past TRASH_TTL: the client one erased by client itself, the root one (keys, config) by root."""
    if uid_of("client") is not None and os.path.isdir(os.path.join(CLIENT_HOME, ".msb", "archive", ".trash")):
        try:
            client_py(PURGE_PY, [CLIENT_HOME, now(), TRASH_TTL])
        except Refused:
            pass
    try:
        names = os.listdir(ROOT_TRASH)
    except OSError:
        names = []
    for name in names:
        m = ARCHIVE_RE.fullmatch(name)
        t = stamp_time(m.group(2)) if m else None
        if t is not None and now() - t >= TRASH_TTL:
            rmtree_private(os.path.join(ROOT_TRASH, name))


def node_check_ok():
    try:
        r = as_user("client", ["node", "--check", PULLER], timeout=60)
    except subprocess.TimeoutExpired:
        return False
    return r.returncode == 0


def guard_puller():
    """Step 5 of the base layer: a broken puller on a free server means no update ever reaches it. Repairs only
    what is safe without our access: the client's puller.cjs restored from the root copy setup.sh took at install
    (when it is missing or does not even parse), an ENABLED timer that is not running started again, a failed tick
    unit reset. A timer that is disabled stays disabled (born-pull decides on paid boxes, the owner on free ones)."""
    if os.path.lexists(UPDATES_OFF):
        return "off"
    if os.path.lexists(STAGED_HOLD):
        return "held"
    check = "ok"
    st = None
    try:
        st = os.lstat(PULLER)
    except OSError:
        pass
    healthy = st is not None and stat.S_ISREG(st.st_mode) and node_check_ok()
    if not healthy:
        if os.path.isfile(PULLER_GOOD) and not os.path.islink(PULLER_GOOD):
            r = as_user("client", ["/bin/sh", "-c", 'cp -- "$1" "$2.tmp.$$" && chmod 0755 "$2.tmp.$$" && mv -f -- "$2.tmp.$$" "$2"',
                                   "sh", PULLER_GOOD, PULLER])
            check = "restored" if r.returncode == 0 and node_check_ok() else "broken"
        else:
            check = "missing" if st is None else "broken"
    if check in ("ok", "restored") and systemctl_word("is-enabled", PULLER_TIMER) == "enabled":
        if systemctl_word("is-active", PULLER_TIMER) != "active":
            systemctl_ok("start", PULLER_TIMER)
            check = check if check == "restored" else "rearmed"
        if systemctl_word("is-failed", PULLER_SERVICE) == "failed":
            systemctl_ok("reset-failed", PULLER_SERVICE)
    return check


def helper_version_of(data):
    m = re.search(rb'^HELPER_VERSION = "(0|[1-9][0-9]{0,3})\.(0|[1-9][0-9]{0,3})\.(0|[1-9][0-9]{0,3})"$', data or b"", re.M)
    return tuple(int(x) for x in m.groups()) if m else None


def kick_updater():
    """Safety net for jarvis-engine-update.path: a staged build newer than this helper that nobody installed yet
    (a missed inotify event, a manifest not reachable at that moment) gets the updater started, at most every
    UPDATE_KICK_EVERY. The updater decides; the tick only asks."""
    staged = read_user_file(STAGED_HELPER, "client", 8 << 20)
    new_v, cur_v = helper_version_of(staged), helper_version_of(read_small(HELPER, 8 << 20))
    if not new_v or (cur_v and new_v <= cur_v):
        return False
    mark = os.path.join(STATE_DIR, "update-kick")
    try:
        last = int((read_small(mark, 32) or b"0").strip() or 0)
    except ValueError:
        last = 0
    if now() - last < UPDATE_KICK_EVERY:
        return False
    ensure_root_dir(STATE_DIR, 0o700)
    write_file(mark, str(now()).encode(), 0o600)
    return systemctl_ok("start", "--no-block", "jarvis-engine-update.service")


# ── S5: OpenClaw moved up by the tick ─────────────────────────────────────────────────────────────
UPDATE_PUBLIC = ("id", "by", "from", "to", "result", "code", "reason", "version", "at", "tries")


def oc_update_record():
    """The last automatic OpenClaw update (root file): {id, by, from, to, result, code, reason, version, at, tries,
    tried_at}."""
    raw = read_small(OC_UPDATE_FILE, 8192)
    try:
        rec = json.loads(raw.decode()) if raw else {}
    except Exception:
        rec = {}
    return rec if isinstance(rec, dict) else {}


def save_oc_update(rec):
    ensure_root_dir(STATE_DIR, 0o700)
    write_file(OC_UPDATE_FILE, json.dumps(rec, sort_keys=True).encode())


def forget_oc_update():
    try:
        os.unlink(OC_UPDATE_FILE)
    except OSError:
        pass


def public_update(rec):
    """What state.json shows of it (no tried_at bookkeeping): the plugin tells the owner the outcome once."""
    out = {k: rec[k] for k in UPDATE_PUBLIC if k in rec and isinstance(rec[k], (str, int)) and not isinstance(rec[k], bool)}
    return out or None


def oc_quiet():
    """Nobody talked to OpenClaw for AUTO_UPDATE_QUIET: no session file of it changed since (stat only, no content)."""
    agents = os.path.join(OC_HOME, ".openclaw", "agents")
    dirs = sub_dirs(agents, "sessions") + sub_dirs(agents, "agent") + [os.path.join(OC_HOME, ".openclaw", "sessions")]
    return count_today(dirs, now() - AUTO_UPDATE_QUIET) == 0


def settle_interrupted_update():
    """Under the lock nothing runs: a record still «running» was cut off (the tick killed, a reboot). Told as failed,
    so neither the bots nor the plugin wait for it forever."""
    rec = oc_update_record()
    if rec.get("result") == "running":
        save_oc_update(dict(rec, result="failed", code="FAILED", reason="INTERRUPTED", at=iso()))


def auto_update_openclaw(work):
    """S5 (decision D5): an installed, switched-on OpenClaw older than the version pinned in this helper is updated to
    it by the tick, the same script as the owner's «🔄 Обновить». Never while the owner has updates off
    (/etc/jarvis-engine/updates.off), never to upstream «latest», at most one try a day and AUTO_UPDATE_TRIES per
    version, only when nobody talks to OpenClaw. The outcome: OC_UPDATE_FILE → state.json `openclaw_update`; the
    /server plugin tells the owner when its gateway is back. Returns the record of a try, None when there was none."""
    if os.path.lexists(UPDATES_OFF):
        return None
    o = openclaw_info()
    cur, target = oc_version(o["version"]), oc_version(OC_VERSION_VERIFIED)
    if not o["installed"] or not o["enabled"] or cur is None or cur >= target:
        return None
    rec = oc_update_record()
    tries = rec.get("tries") if rec.get("to") == OC_VERSION_VERIFIED and isinstance(rec.get("tries"), int) else 0
    last = rec.get("tried_at") if isinstance(rec.get("tried_at"), int) else 0
    if tries >= AUTO_UPDATE_TRIES or now() - last < AUTO_UPDATE_EVERY:
        return None
    if sandboxes_alive() or not oc_quiet():
        return None
    base = {"id": "auto" + stamp().lower(), "by": "auto", "from": o["version"], "to": OC_VERSION_VERIFIED,
            "tries": tries + 1, "tried_at": now()}
    save_oc_update(dict(base, result="running", at=iso()))
    write_state({"openclaw_update": public_update(oc_update_record())})  # the bots see «идёт обновление OpenClaw»
    try:
        result, info = script(work, unpack(work), "openclaw-configure.sh", ["update", OC_VERSION_VERIFIED])
    except Exception as e:
        result, info = "failed", "INTERNAL_" + type(e).__name__.upper()[:40]
    if result == "ok":
        rec = dict(base, result="done", code="OK", version=info.get("version", "") or OC_VERSION_VERIFIED, at=iso())
    else:
        rec = dict(base, result="failed", code="FAILED", reason=info if isinstance(info, str) else "UPDATE", at=iso())
        wake_if_openclaw_down(work, rec["id"])
    save_oc_update(rec)
    print("JARVIS_ENGINE_AUTO_UPDATE result=%s to=%s" % (rec["result"], OC_VERSION_VERIFIED), file=sys.stderr)
    return rec


def settle_sleep(work):
    """Tick: a sleep mark means «OpenClaw answers instead of this bot». Where that is not true any more (OpenClaw not
    installed, half-done (no channel) or switched off, a gateway that stays failed after revive, a mark restored from a
    backup onto a server without OpenClaw, a wake that failed earlier) every sleeping bot is woken: a bot never sleeps
    for nobody."""
    if not sleep_marks():
        forget_down()
        return []
    o = openclaw_info(work, unpack(work)) if EMBEDDED else openclaw_info()
    if o["installed"] and o["enabled"] and not o["incomplete"]:
        if o["gateway"] == "active":
            forget_down()
            return []
        # Not active: failed now, or a second tick in a row (a restart loop reads «activating», never «failed»).
        downs = down_ticks() + 1
        if o["gateway"] != "failed" and downs < 2:
            ensure_root_dir(STATE_DIR, 0o700)
            write_file(SLEEP_DOWN_FILE, str(downs).encode(), 0o600)
            return []
    forget_down()
    woken = wake_all("tick")
    print("JARVIS_ENGINE_WOKEN %s" % ",".join(woken), file=sys.stderr)
    return woken


def down_ticks():
    try:
        return int((read_small(SLEEP_DOWN_FILE, 16) or b"0").strip() or 0)
    except ValueError:
        return 0


def forget_down():
    try:
        os.unlink(SLEEP_DOWN_FILE)
    except OSError:
        pass


# ── 0.5.9: a frozen gateway (OC_FROZEN_*) ────────────────────────────────────────────────────────────────────────────
def frozen_record():
    raw = read_small(os.path.join(STATE_DIR, OC_FROZEN_NAME), 8192)
    try:
        rec = json.loads(raw.decode()) if raw else {}
    except Exception:
        rec = {}
    return rec if isinstance(rec, dict) else {}


def frozen_restarts(rec, t):
    """The restarts of the record within the last 24 h."""
    r = rec.get("restarts")
    return [x for x in (r if isinstance(r, list) else []) if type(x) is int and 0 <= t - x < 86400]


def frozen_public(rec=None):
    """state.json `openclaw.frozen`: the last frozen round of the day, null = none in 24 h. `now` = a tick saw it frozen
    at most OC_FROZEN_EVENTS_GAP ago (no tick since, e.g. switched off, = not now); `since` = the start of that episode;
    `restarts` = restarts in 24 h; `result` = what the last frozen round did."""
    rec = frozen_record() if rec is None else rec
    t = now()
    at = rec.get("at")
    if type(at) is not int or not 0 <= t - at < 86400:
        return None
    restarts = frozen_restarts(rec, t)
    since = rec.get("since")
    return {"now": rec.get("now") is True and t - at <= OC_FROZEN_EVENTS_GAP, "at": iso(at),
            "since": iso(since) if type(since) is int else None, "restarts": len(restarts),
            "result": rec.get("result") if rec.get("result") in OC_FROZEN_RESULTS else None,
            "last_restart": iso(max(restarts)) if restarts else None}


def slice_memory(uid):
    """OpenClaw's slice as the kernel counts it: {"full60", "full300"} (memory.pressure, %), {"high"} (memory.events,
    hierarchical); a key is missing when it cannot be read."""
    base = os.path.join(CGROUP_ROOT, "user.slice", "user-%s.slice" % uid)
    out = {}
    for line in (read_small(os.path.join(base, "memory.pressure"), 4096) or b"").decode("ascii", "replace").splitlines():
        f = line.split()
        if f and f[0] == "full":
            for kv in f[1:]:
                k, _, v = kv.partition("=")
                if k in ("avg60", "avg300") and re.fullmatch(r"[0-9]{1,3}\.[0-9]{1,2}", v):
                    out["full" + k[3:]] = float(v)
    for line in (read_small(os.path.join(base, "memory.events"), 4096) or b"").decode("ascii", "replace").splitlines():
        f = line.split()
        if len(f) == 2 and f[0] == "high" and re.fullmatch(r"[0-9]{1,20}", f[1]):
            out["high"] = int(f[1])
    return out


def save_frozen(rec):
    ensure_root_dir(STATE_DIR, 0o700)
    write_file(os.path.join(STATE_DIR, OC_FROZEN_NAME), json.dumps(rec, sort_keys=True).encode(), 0o600)


def watch_frozen(work, uid, gateway):
    """The tick, right after revive (`gateway` = its word this round): a frozen gateway (OC_FROZEN_*) is killed and started
    again (openclaw-configure.sh revive frozen) within OC_FROZEN_HOUR_MAX an hour and OC_FROZEN_DAY_MAX a day, past that
    only recorded (`capped`). Never for an OpenClaw the owner switched off (the tick does not get here, and revive frozen
    refuses it too). The memory.events reading is kept every round: the next round judges its growth. Returns the result
    of a frozen round, None otherwise."""
    t = now()
    rec = frozen_record()
    mem = slice_memory(uid)
    prev, prev_at = rec.get("high"), rec.get("high_at")
    grew = type(prev) is int and type(prev_at) is int and "high" in mem and 0 <= t - prev_at <= OC_FROZEN_EVENTS_GAP \
        and mem["high"] - prev >= OC_FROZEN_HIGH_EVENTS
    pressed = max(mem.get("full60", 0.0), mem.get("full300", 0.0)) >= OC_FROZEN_PRESSURE
    age = plugin_alive_age()
    frozen = gateway == "active" and age is not None and age > OC_FROZEN_ALIVE and (pressed or grew)
    restarts = frozen_restarts(rec, t)
    new = {k: rec[k] for k in ("at", "since", "result") if k in rec}
    new.update({"now": False, "restarts": restarts, "high": mem.get("high"), "high_at": t if "high" in mem else None})
    if not frozen:
        if new != rec:
            save_frozen(new)
        return None
    new.update({"now": True, "at": t, "since": rec["since"] if rec.get("now") is True and type(rec.get("since")) is int
                else t, "pressure": [mem.get("full60"), mem.get("full300")], "alive_age": int(age)})
    if sum(1 for x in restarts if t - x < 3600) >= OC_FROZEN_HOUR_MAX or len(restarts) >= OC_FROZEN_DAY_MAX:
        new["result"] = "capped"
    else:
        restarts.append(t)
        new["result"] = "restart_failed"
        save_frozen(new)   # counted before it runs: a round killed halfway still spends its restart
        try:
            result, info = script(work, unpack(work), "openclaw-configure.sh", ["revive", "frozen"], timeout=300)
        except Exception as e:
            result, info = "failed", "INTERNAL_" + type(e).__name__.upper()[:40]
        if result == "ok":
            new["result"] = "restarted"
        else:
            print("JARVIS_ENGINE_FROZEN_RESTART_%s" % info, file=sys.stderr)
    save_frozen(new)
    print("JARVIS_ENGINE_OC_FROZEN result=%s restarts=%d alive_age=%d full=%s/%s grew=%s" % (
        new["result"], len(restarts), int(age), mem.get("full60"), mem.get("full300"), grew), file=sys.stderr)
    return new["result"]


def cmd_tick(args):
    need_root()
    lock = locked(wait=False)
    if lock is None:
        return 0  # a request (an install can take 40 min) holds the helper: the next tick does the round
    mark_busy("tick")  # an automatic OpenClaw update in this round takes up to 70 min (the pulse keeps OpenClaw's answer)
    try:
        if host_refusal():
            # 0.5.8/0.5.9: never a grant on a held host; a file of ours goes with the switch, OpenClaw or the lock
            for name, step in (("SUDOERS", ensure_sudoers), ("CC_SUDOERS", ensure_cc_sudoers),
                               ("BOT_DROPIN", ensure_bot_dropin)):
                try:
                    step()
                except Exception as e:
                    print("JARVIS_ENGINE_KEEP_%s_%s" % (name, backup_dropin_error(e)), file=sys.stderr)
            write_state(compute_state())
            return 0
        sweep_work()
        keep_ours()  # 0.5.8: OpenClaw is root; what keeps the server ours is put back first (backup units before the drop-in)
        try:
            ensure_backup_dropin()  # every round: a backup unit installed later (R2 switch, a new install) gets it too
        except Exception as e:
            print("JARVIS_ENGINE_BACKUP_DROPIN_%s" % backup_dropin_error(e), file=sys.stderr)
        try:
            note_snapshot_file(guard_snapshot_files())  # the snapshot tars root 0600 again (a restore chowns HOME)
        except Exception as e:
            print("JARVIS_ENGINE_SNAPSHOT_FILE_%s" % backup_dropin_error(e), file=sys.stderr)
        work = work_dir("tick")
        try:
            purge_trash()
            m = marker()
            if m.get("complete") == "1" and not os.path.lexists(OC_OFF) and EMBEDDED and not sandboxes_alive():
                result, code = script(work, unpack(work), "openclaw-configure.sh", ["revive"], timeout=300)
                if result != "ok":
                    print("JARVIS_ENGINE_REVIVE_%s" % code, file=sys.stderr)
                elif not unconfigured(m) and re.fullmatch(r"[0-9]{1,10}", m.get("uid", "")):
                    try:
                        watch_frozen(work, m["uid"], code.get("state"))   # 0.5.9: active, but frozen
                    except Exception as e:  # never at the cost of the rest of the round
                        print("JARVIS_ENGINE_FROZEN_INTERNAL_%s" % type(e).__name__.upper()[:40], file=sys.stderr)
            if m.get("complete") == "1" and not os.path.lexists(OC_OFF) and EMBEDDED and os.path.lexists(PLUGIN_STALE) \
                    and not sandboxes_alive():
                try:
                    rewire_plugin(work)
                except Exception as e:  # never at the cost of the rest of the round (puller guard, state)
                    print("JARVIS_ENGINE_PLUGIN_INTERNAL_%s" % type(e).__name__.upper()[:40], file=sys.stderr)
            try:
                settle_interrupted_update()
                auto_update_openclaw(work)
            except Exception as e:  # never at the cost of the rest of the round
                print("JARVIS_ENGINE_AUTO_UPDATE_INTERNAL_%s" % type(e).__name__.upper()[:40], file=sys.stderr)
            if m.get("complete") == "1" and not os.path.lexists(OC_OFF) and EMBEDDED:
                # 0.5.6 defaults, menu; 0.5.8 SOUL rights; 0.5.9 SOUL plugins (after the defaults: they replace an old seed)
                for step in (migrate_openclaw, lambda w: menu_tick(), rights_soul, plugins_soul):
                    try:
                        step(work)
                    except Exception as e:  # never at the cost of the rest of the round
                        print("JARVIS_ENGINE_TICK_INTERNAL_%s" % type(e).__name__.upper()[:40], file=sys.stderr)
            try:
                settle_sleep(work)
            except Exception as e:
                print("JARVIS_ENGINE_SLEEP_INTERNAL_%s" % type(e).__name__.upper()[:40], file=sys.stderr)
            reconcile_jarvis()
            check = guard_puller()
            if check not in ("off", "held"):
                kick_updater()
            write_state(compute_state(work, check))
        finally:
            rmtree_private(work)
    finally:
        clear_busy()
        os.close(lock)
    return 0


def cmd_status(args):
    if os.geteuid() == 0:
        # A request or an automatic update (up to 40 min) holds the lock: print what state.json has, never wait.
        lock = locked(wait=False)
        if lock is not None:
            try:
                work = work_dir("tick")
                try:
                    write_state(compute_state(work))
                finally:
                    rmtree_private(work)
            finally:
                os.close(lock)
    data = read_small(os.path.join(RUN_DIR, "state.json"), 1 << 20)
    sys.stdout.write(data.decode() if data else json.dumps({"v": 1, "helper_version": HELPER_VERSION, "at": None}) + "\n")
    return 0


# ── OpenClaw snapshot for the nightly backup (0.5.5) ─────────────────────────────────────────────
# The nightly backup (templates/backup-r2.sh, msb-backup.service) archives /home/client only; the native OpenClaw lives
# in /home/openclaw. So before it msb-backup.service runs `jarvis-engine snapshot` as root (ExecStartPre with «-»: a
# failed snapshot never fails the backup) from the drop-in this helper keeps (setup and every tick). What brings OpenClaw
# back on another server goes into ONE file, ~/.msb/archive/openclaw-snapshot.tar (root 0600: the bot's agent, running as
# client, cannot read it; one file because backup-r2.sh drops *.log, .cache, node_modules, __pycache__, … by name at any
# depth, and parts of a tree would silently miss the archive); the engines' state goes to ~/.msb/archive/engines.json
# (schema 1, client 0600, no secret). Agreed with the owner and the backup team 11.10, reviewed 12.10:
#  - model API keys and sign-ins (OAuth: the ChatGPT login and alike) never go in. A store that mixes them with the
#    owner's data stays out whole; README.md inside the tar says what that costs (OpenClaw 2026.9.5 docs,
#    gateway/security/secrets-and-storage.md: agents/<id>/agent/openclaw-agent.sqlite = model auth profiles together
#    with the live history; state/openclaw.sqlite = MCP OAuth tokens together with the cron jobs). The Telegram bot token
#    goes in (Tom 11.10: restore in one click): its token file when it holds a token-shaped line, or the config's
#    botToken when token-shaped;
#  - an allowlist everywhere: of ~/.openclaw (CONFIG + token, workspace[-<name>], agents/<id>/sessions, sessions, wiki,
#    memory, cron, skills without skills/config, hooks, transcripts) and of openclaw.json (CONFIG_KEEP: what a restore
#    needs, nothing else). Inside the trees no logs, caches, tmp, node_modules, hidden directories, secret-named files,
#    links, devices, hard links, files of other users; outside sessions/ and transcripts/ a file whose bytes look like a
#    key or a token stays out (named in manifest.json);
#  - the main part first: config, token, personality (SOUL/USER/IDENTITY/AGENTS.md), memory (MEMORY.md, memory/); then
#    the rest while it fits SNAPSHOT_MAX_BYTES (what does not fit is listed: `partial`). The main part does not fit =
#    TOO_BIG, nothing replaced;
#  - bounded: SNAPSHOT_SEC for the whole run (the wait for the helper's lock included); the deadline is checked last
#    BEFORE anything is replaced, never after. Any exit 1 = the previous snapshot and engines.json exactly as they were;
#  - atomic: the tar is written to a root 0600 temp file next to it (O_EXCL, dir_fd), engines.json to its own temp file;
#    then engines.json and the tar are renamed into place (a failed rename puts the previous engines.json back). Root
#    reaches the client's HOME only through O_NOFOLLOW descriptor chains (every component a real directory; from the
#    HOME down owned by client and writable by nobody else);
#  - under a hold marker (hold, partner, msb-staged-hold) nothing at all is written: JARVIS_ENGINE_SNAPSHOT_HOST_HOLD;
#  - a server moved here keeps the only copy of its OpenClaw: engines.json of ANOTHER machine and no OpenClaw installed
#    here = nothing written (PENDING_RESTORE). Once OpenClaw is installed here (a new install, an event, the next night)
#    that copy is never replaced: it moves aside to openclaw-snapshot.<machine>.tar + engines.<machine>.json, stays in
#    the backup and waits for an explicit restore or discard (0.5.6); at most SNAPSHOT_KEEP_FOREIGN of them, the oldest
#    goes only when a third one arrives;
#  - no OpenClaw here: engines.json only (installed false), nothing deleted (an earlier snapshot stays);
#  - the tick gives every snapshot tar back to root 0600 (restore-runner `chown -R client` gives the HOME to client).
# The outcome: SNAPSHOT_RECORD (root) → state.json `snapshot` → the base pulse (`oc_snapshot`, `snapshot_at`,
# `oc_snapshot_file`).
SNAPSHOT_TAR = "openclaw-snapshot.tar"
ENGINES_NAME = "engines.json"
SNAPSHOT_SEC = 120
SNAPSHOT_MAX_BYTES = 256 << 20         # the tar as written
SNAPSHOT_TAIL = 64 << 10               # kept for manifest.json, README.md and the tar's end blocks
SNAPSHOT_MIN_FREE = 512 << 20          # the disk keeps at least this free while the tar is written
SNAPSHOT_MAX_DEPTH = 24
SNAPSHOT_CONFIG_MAX = 4 << 20
SNAPSHOT_LIST = 64                     # names listed in manifest.json per list
SNAPSHOT_KEEP_FOREIGN = 2
SNAPSHOT_REST_MARGIN = 30              # the rest stops this long before the deadline: closing and renaming fit in time
SNAP_SCAN_MAX = 8 << 20                # a file checked by content is read whole: at most this (bigger = left out)
SNAP_SCRUB_MAX = IMPORT_MAX_FILE       # text is cut like the memory copy (several copies of it in memory): at most 4 MB
SNAPSHOT_RECORD = "/var/lib/jarvis-engine/snapshot.json"
SNAPSHOT_FILE_STATE = "/var/lib/jarvis-engine/snapshot.file"   # the tick's word on the tars' owner: ok | bad
MACHINE_ID = "/etc/machine-id"
