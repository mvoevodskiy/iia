        raise Refused("NOT_ROOT", "failed")


def uid_of(name):
    try:
        return pwd.getpwnam(name).pw_uid
    except KeyError:
        return None


def gid_of(name):
    try:
        return pwd.getpwnam(name).pw_gid
    except KeyError:
        return None


def child_env(extra=None):
    env = {"PATH": SAFE_PATH, "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8", "HOME": "/root"}
    env.update(extra or {})
    return env


def kill_group(p):
    """The child and everything it started (its own session): TERM, then KILL."""
    for sig, wait in ((signal.SIGTERM, 5), (signal.SIGKILL, 5)):
        try:
            os.killpg(p.pid, sig)
        except (ProcessLookupError, PermissionError):
            return
        try:
            p.wait(wait)
            return
        except subprocess.TimeoutExpired:
            continue


def run(argv, timeout=120, env=None, stdout=None, stderr=None, input=None):
    """A child in its own process group; on timeout or on our own SIGTERM the whole group goes."""
    p = subprocess.Popen(argv, env=env or child_env(), cwd="/",
                         stdin=subprocess.PIPE if input is not None else subprocess.DEVNULL,
                         stdout=stdout if stdout is not None else subprocess.PIPE,
                         stderr=stderr if stderr is not None else subprocess.PIPE, start_new_session=True)
    try:
        out, err = p.communicate(input=input, timeout=timeout)
    except BaseException:
        kill_group(p)
        raise
    return subprocess.CompletedProcess(argv, p.returncode, out, err)


def on_signal(signum, frame):
    raise SystemExit(128 + signum)  # unwinds every finally: work dirs with secrets are removed


def now():
    return int(time.time())


def iso(t=None):
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(now() if t is None else t))


def stamp(t=None):
    return time.strftime("%Y%m%dT%H%M%SZ", time.gmtime(now() if t is None else t))


def stamp_time(s):
    try:
        return calendar.timegm(time.strptime(s, "%Y%m%dT%H%M%SZ"))
    except ValueError:
        return None


def fsync_dir(path):
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def ensure_root_dir(path, mode):
    try:
        os.mkdir(path, mode)
    except FileExistsError:
        pass
    st = os.lstat(path)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != ROOT_UID:
        raise Refused("ROOT_DIR", "failed")
    if stat.S_IMODE(st.st_mode) != mode:
        os.chmod(path, mode)


def write_file(path, data, mode=0o600):
    """Atomic replace inside a root-only directory: O_EXCL|O_NOFOLLOW temp, every byte written (a short write on a
    filling disk is not the whole file: it writes the root updater, which is never replaced), fsync, rename, fsync of
    the dir. On any failure the temp file goes and `path` is untouched."""
    tmp = "%s.%s.tmp" % (path, os.urandom(6).hex())
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, mode)
    try:
        try:
            view = memoryview(data)
            while view:
                view = view[os.write(fd, view):]
            os.fchmod(fd, mode)
            os.fsync(fd)
        finally:
            os.close(fd)
        os.rename(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    fsync_dir(os.path.dirname(path) or ".")


def read_small(path, limit=4096):
    try:
        with open(path, "rb") as f:
            return f.read(limit)
    except (FileNotFoundError, NotADirectoryError, IsADirectoryError, PermissionError):
        return None


def work_dir(prefix):
    ensure_root_dir(WORK_ROOT, 0o700)
    path = os.path.join(WORK_ROOT, "%s.%s" % (prefix, os.urandom(8).hex()))
    os.mkdir(path, 0o700)
    return path


def rmtree_private(path):
    """Remove a tree without following any link (os.walk never descends into a link; links are unlinked)."""
    if not os.path.lexists(path):
        return
    if os.path.islink(path) or not os.path.isdir(path):
        os.unlink(path)
        return
    for root, dirs, files in os.walk(path, topdown=False):
        for f in files:
            os.unlink(os.path.join(root, f))
        for d in dirs:
            p = os.path.join(root, d)
            os.unlink(p) if os.path.islink(p) else os.rmdir(p)
    os.rmdir(path)


def sweep_work():
    """Under the lock nothing else runs: every work dir left by a killed run (SIGKILL, power loss) goes, and every
    transfer/seed staging dir (copies of the owner's memory readable by the openclaw group)."""
    for root, prefixes, tail_re in ((WORK_ROOT, WORK_PREFIXES, r"[0-9a-f]{16}"), (XFER_DIR, ("transfer", "seed", "import"), r"[0-9a-f]{12}")):
        try:
            names = os.listdir(root)
        except (FileNotFoundError, NotADirectoryError):
            continue
        for name in names:
            head, _, tail = name.partition(".")
            if head in prefixes and re.fullmatch(tail_re, tail):
                rmtree_private(os.path.join(root, name))


def strict_json(data, code):
    def no_dupes(pairs):
        out = {}
        for k, v in pairs:
            if k in out:
                raise Refused(code)
            out[k] = v
        return out
    try:
        return json.loads(data.decode("utf-8"), object_pairs_hook=no_dupes)
    except Refused:
        raise
    except Exception:
        raise Refused(code)


def on_hold():
    return any(os.path.lexists(p) for p in HOLD_MARKERS)


def managed():
    """The positive marker of setup.sh: a regular root file with one link, writable by nobody else."""
    try:
        st = os.lstat(MANAGED_MARKER)
    except OSError:
        return False
    return stat.S_ISREG(st.st_mode) and st.st_uid == ROOT_UID and st.st_nlink == 1 and not st.st_mode & 0o022


def host_refusal():
    """None where this host is ours to act on, else the reason every action refuses with (fail-closed)."""
    if on_hold():
        return "HOST_HOLD"
    if not managed():
        return "NOT_MANAGED"
    return None


def sandboxes_alive():
    """A sandbox unit of an earlier run still alive (or systemd cannot say: fail-closed)."""
    try:
        r = run(["systemctl", "list-units", "--all", "--plain", "--no-legend", "--type=service", SANDBOX_GLOB], timeout=30)
    except subprocess.TimeoutExpired:
        return True
    if r.returncode != 0:
        return True
    for line in r.stdout.decode("utf-8", "replace").splitlines():
        f = line.split()
        for i, tok in enumerate(f[:-2]):
            if re.fullmatch(r"jarvis-engine-oc-[0-9]{1,10}-[0-9]{1,6}\.service", tok) and f[i + 2] in SANDBOX_LIVE:
                return True
    return False


