class Refused(Exception):
    """result: refused (nothing changed) | failed (something changed or broke). detail: non-secret facts."""
    def __init__(self, code, result="refused", detail=None):
        super().__init__(code)
        self.code = code
        self.result = result
        self.detail = detail or {}


