def act_disable_openclaw(source, req, work, progress):
    o = openclaw_info()
    if not o["installed"]:
        raise Refused("NOT_INSTALLED")
    if not o["enabled"]:
        raise Refused("ALREADY_DISABLED")
    need_jarvis_working()
    progress("stop")
    ensure_root_dir(STATE_DIR, 0o700)
    write_file(OC_OFF, ("off_at=%d\n" % now()).encode(), 0o600)
    woken = None
    try:
        result, info = script(work, unpack(work), "openclaw-configure.sh", ["stop"], timeout=OC_STOP_TIMEOUT)
        if result != "ok":
            raise script_refused("failed", info)
    finally:
        # OpenClaw is off (or half off: the marker stays, revive leaves it alone): no bot keeps sleeping «while
        # OpenClaw answers». A failed wake is reported in detail, never as a failed switch; the tick tries again.
        try:
            woken = wake_all(req["id"])
        except Refused as e:
            woken = {"failed": e.detail.get("reason", "CLIENT_STEP")}
    return {"gateway": "inactive", "woken": woken}


def act_remove_jarvis(source, req, work, progress):
    p = req["params"]
    j = jarvis_info()
    if j["state"] == "absent" or not j["installed"]:
        raise Refused("NOT_INSTALLED", detail={"state": j["state"]})
    live = [b["id"] for b in j["bots"] if not b["removed"]]
    if p.get("bot_id"):
        if p["bot_id"] not in live:
            raise Refused("NOT_INSTALLED", detail={"bot_id": p["bot_id"]})
        ids = [p["bot_id"]]
    else:
        ids = [b["id"] for b in j["bots"] if not b["removed"] and b["known"]] or live
    # no other real Jarvis bot left (a stale directory does not count): the shared workspace goes too
    everything = not any(b["known"] and not b["removed"] and b["id"] not in ids for b in j["bots"])
    # The way back first (Tom 10.10): a removed bot comes back only from OpenClaw's /server. Without OpenClaw switched on
    # and its plugin wired nothing is removed, whatever else runs.
    o = openclaw_info(work, unpack(work))
    if not way_back(o):
        what = "incomplete" if o["incomplete"] else "absent" if not o["installed"] else \
            ("disabled" if not o["enabled"] else "on")
        raise Refused("NO_WAY_BACK", detail={"openclaw": what, "plugin": o.get("plugin"),
                                             "plugin_alive": bool(o.get("plugin_alive"))})
    # LAST_ENGINE on what really runs: another Jarvis bot working, or OpenClaw with its gateway active.
    if not any(b["working"] and b["id"] not in ids for b in j["bots"]) and o["gateway"] != "active":
        raise Refused("LAST_ENGINE", detail={"other": o["gateway"]})
    # The way back is OpenClaw's bot: its Telegram channel must answer (a revoked token leaves the gateway «active»).
    result, _info = script(work, unpack(work), "openclaw-configure.sh", ["probe"], timeout=180)
    if result != "ok":
        raise Refused("NO_WAY_BACK", detail={"openclaw": "on", "plugin": o.get("plugin"), "channel": "down"})
    keep = p["keep"]
    name = "jarvis-" + stamp()
    detail = {"archive": name, "kept": keep, "bots": ids, "whole_engine": everything}
    if p.get("transfer_memory") and everything:
        progress("transfer")
        detail["transferred"] = transfer_memory(work)
    # The request came from a Jarvis bot itself: it is stopped LAST (C4), the owner reads the end in OpenClaw.
    stop_handshake(ids, "removed", progress, detail)
    progress("archive", detail)
    moved = client_py(JARVIS_ARCHIVE_PY, [CLIENT_HOME, name] + keep_args(keep) +
                      [now(), ",".join(JARVIS_MEMORY_NAMES), TRASH_TTL, "1" if everything else "0", ",".join(ids)])
    detail["moved"] = {k: v for k, v in moved.items() if isinstance(v, int)}
    detail["erase_after"] = iso(now() + TRASH_TTL) if moved.get("trash") else None
    return detail


def act_add_jarvis(source, req, work, progress):
    j = jarvis_info()
    if j["state"] == "absent":
        raise Refused("NOT_AVAILABLE")  # a server born without Jarvis: the program is not here (a later release)
    removed = [b["id"] for b in j["bots"] if b["removed"]]
    bot = req["params"].get("bot_id") or ("default" if "default" in removed else (removed[0] if removed else None))
    if bot is None or bot not in removed:
        raise Refused("ALREADY_INSTALLED")
    # The bot comes back answering the same person only: the root record of install time against its ADMIN_ID.
    owner = recorded_owner()
    if owner is None:
        raise Refused("OWNER_MISMATCH", detail={"reason": "NO_OWNER_RECORD"})
    bot_admin = env_last(read_user_file(os.path.join(CLIENT_HOME, ".msb", "bots", bot, ".env"), "client", 64 << 10), ENV_ADMIN_RE) \
        or env_last(read_user_file(os.path.join(CLIENT_HOME, ".msb", ".env"), "client", 64 << 10), ENV_ADMIN_RE)
    if bot_admin != owner:
        raise Refused("OWNER_MISMATCH", detail={"reason": "ADMIN_ID"})
    token = req["params"].get("token")
    oc = openclaw_token()
    # The token this bot really starts on: its own .env wins (systemd loads bots/<id>/.env before the process starts and
    # bootstrap-env fills only the keys still missing from the shared ~/.msb/.env). The two may differ (env-push writes
    # only the bot's own file): a token merely in the shared file is not what the bot runs on, so it is never the «same
    # bot» short path. The shared file counts for default only and only when its own file has no BOT_TOKEN line at all:
    # the LAST assignment of its own file rules even when empty or malformed (systemd sets that, nothing is filled over
    # it); its own file there but not a plain file of client (a link, too big) = unknown: no token of its own
    # (NEED_TOKEN), never the shared one in its place.
    mine = own_env_files(bot)[0]
    raw = read_user_file(mine, "client", 64 << 10)
    assigned = [ln for ln in (raw or b"").decode("utf-8", "replace").splitlines()
                if re.match(r"\s*(?:export\s+)?BOT_TOKEN\s*=", ln)]
    if assigned:
        m = ENV_TOKEN_RE.fullmatch(assigned[-1])
        own = m.group(1) if m else None
    elif raw is None and os.path.lexists(mine):
        own = None
    else:
        own = env_last(read_user_file(os.path.join(CLIENT_HOME, ".msb", ".env"), "client", 64 << 10), ENV_TOKEN_RE) \
            if bot == "default" else None
    # The token files of every OTHER bot, each with «removed or not»; this bot's own files never count against it. The
    # shared ~/.msb/.env is default's (own when bot is default; of a bot that is not removed when no default exists).
    theirs = [(os.path.join(CLIENT_HOME, ".msb", "bots", b, ".env"), b in removed) for b in bot_ids() if b != bot] + \
        ([(os.path.join(CLIENT_HOME, ".msb", ".env"), "default" in removed)] if bot != "default" else [])

    def holder(cands, with_removed):
        """Whose bot a candidate token already is, for the owner's text (detail.holder, no name, no token): "openclaw"
        (OpenClaw's bot), "bot" (another bot that is not removed), "removed_bot" (another removed bot: counted only
        when a token is being given, it would collide when that bot comes back), None = free. The running holders win."""
        if any(same_bot(oc, c) for c in cands):
            return "openclaw"
        if any(same_bot(t, c) for t in tokens_in([f for f, rem in theirs if not rem]) for c in cands):
            return "bot"
        if with_removed and any(same_bot(t, c) for t in tokens_in([f for f, rem in theirs if rem]) for c in cands):
            return "removed_bot"
        return None

    if token and token == own:
        token = None  # exactly the token this bot starts on (its token from before the removal, a retry after a failed
        #               start): the same bot, nothing to write, checked below exactly as «🔁 Прежний» (no token) is, so
        #               the two ways to the same bot never answer differently (a REMOVED bot holding it counts on neither)
    if token:
        # Any other token (one only in the shared .env included) is written into both files and the bot starts on it:
        # against everyone, removed bots too (it would collide when that bot comes back).
        h = holder([token], True)
        if h:
            raise Refused("TOKEN_IN_USE", detail={"holder": h})
    elif not own:
        raise Refused("NEED_TOKEN")
    if not token:
        # The bot starts on its own token as it is: not if that is a running bot's meanwhile (given to OpenClaw or to
        # another bot that is not removed), the short path above included: two bots on one token = 409, both silent.
        h = holder([own], False)
        if h:
            raise Refused("TOKEN_IN_USE", detail={"holder": h, "own": True})
    need_disk(MIN_FREE_BYTES)
    if token:
        progress("token")
        client_py(SET_TOKEN_PY, own_env_files(bot), input=(token + "\n").encode())
    progress("start")
    if bot in sleep_marks():
        set_sleep([bot], False, req["id"])  # a mark left from before the removal: the bot comes back awake
    start_bots([bot], unmark=("removed", "off"))
    return {"bot_id": bot, "active": systemctl_word("is-active", bot_unit(bot)) == "active"}


def act_enable_jarvis(source, req, work, progress):
