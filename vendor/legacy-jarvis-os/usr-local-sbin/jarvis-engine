OLD_SOUL_NO_UI = " Control UI, dashboard и Tailscale на этом сервере не установлены, не предлагай их.".encode("utf-8")
DEFAULTS_NAME_RE = re.compile(r"[A-Za-z0-9._/:-]{1,80}")


def oc_defaults_record():
    raw = read_small(OC_DEFAULTS_FILE, 16384)
    try:
        rec = json.loads(raw.decode()) if raw else {}
    except Exception:
        rec = {}
    return rec if isinstance(rec, dict) else {}


def save_oc_defaults(rec):
