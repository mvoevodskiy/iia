def bot_id_of(token):
    """The numeric bot id is the part of a BotFather token before the colon."""
    head = (token or "").strip().split(":")[0]
    return head if re.fullmatch(r"[0-9]{1,20}", head) else ""


def same_bot(a, b):
    """The two engines must never share one bot (two pollers of one token = both go silent): the same token, or another
    token of the same bot. The same rule as support-bot engine-choice.ts sameBot()."""
    if not a or not b:
        return False
    ta, tb = a.strip(), b.strip()
    if ta == tb:
        return True
    ia, ib = bot_id_of(ta), bot_id_of(tb)
    return bool(ia) and ia == ib


def jarvis_present():
    return os.path.lexists(JARVIS_UNIT)


def bot_mark(bot, kind):
    return os.path.join(JARVIS_MARKS, "%s.%s" % (bot, kind))


def bot_unit(bot):
    return "msb-bot@%s.service" % bot


def sleep_marks():
    """Bot ids with a sleep mark (~/.msb/engine/sleep.<id>, any kind of entry: only its name counts, nothing is read or
    followed). The client writes and deletes these itself: a mark is a wish of the owner's bot, never a permission."""
    try:
        dfd, _ = open_dir_chain(SOURCES[0][1])
    except OSError:
        return set()
    try:
        names = os.listdir(dfd)
    finally:
        os.close(dfd)
    return {n[len(SLEEP_PREFIX):] for n in names if n.startswith(SLEEP_PREFIX) and BOT_ID_RE.fullmatch(n[len(SLEEP_PREFIX):])}


def jarvis_bots():
    """[{id, active, enabled, removed, masked, sleeping, working}] for every Jarvis bot of this server (no Telegram name,
    no token). The list comes from ~/.msb/bots (the client's), so nothing here is trusted alone: `working` (what the
    LAST_ENGINE rule counts) needs the real unit active, not masked, no off/removed mark of ours and no sleep mark."""
    out = []
    asleep = sleep_marks()
    for b in bot_ids():
        removed = os.path.lexists(bot_mark(b, "removed"))
        off = os.path.lexists(bot_mark(b, "off"))
        word = systemctl_word("is-enabled", bot_unit(b))
        masked = word.startswith("masked")
        active = systemctl_word("is-active", bot_unit(b)) == "active"
        enabled = not removed and not off and not masked
        sleeping = enabled and b in asleep  # the process runs, the agent does not (a mark on a stopped bot is moot)
        # `known`: a bot systemd really has (enabled, masked by us, or running), not just a directory in ~/.msb/bots
        known = active or word.split("-")[0] in ("enabled", "masked", "static", "indirect", "linked")
        out.append({"id": b, "active": active, "enabled": enabled, "removed": removed, "masked": masked,
                    "sleeping": sleeping, "working": enabled and active and not sleeping, "known": known})
    return out


def disk():
    try:
        s = os.statvfs(DISK_PATH)
    except OSError:
        return {"free_bytes": None, "total_bytes": None}
    return {"free_bytes": s.f_bavail * s.f_frsize, "total_bytes": s.f_blocks * s.f_frsize}


def gb(n):
    return None if n is None else round(n / 1024 ** 3, 1)


def need_disk(need):
    free = disk()["free_bytes"]
    if free is None or free < need:
        raise Refused("NO_DISK", detail={"free_gb": gb(free), "need_gb": gb(need)})


