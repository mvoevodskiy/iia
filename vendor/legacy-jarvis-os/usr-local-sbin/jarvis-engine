def keep_ours():
    """0.5.8, every tick: what an agent with root could remove is put back (§13, §15 of CONTRACT.md). Each step on its own:
    one that fails never stops the others nor the round. 0.5.9: the rights of client (its sudoers, the bot's drop-in)."""
    for name, step in (("HELPER_COPY", keep_helper_copy), ("UNITS", keep_own_units), ("SUDOERS", ensure_sudoers),
                       ("CC_SUDOERS", ensure_cc_sudoers), ("BOT_DROPIN", ensure_bot_dropin),
                       ("OC_GUARDS", keep_openclaw_guards), ("BACKUP_KEEP", keep_backup_units)):
        try:
            got = step()
            if got is True:
                got = "written"
            if got and got not in ("same", "none", "absent", "ok", "held"):
                print("JARVIS_ENGINE_KEPT_%s %s" % (name, ",".join(got) if isinstance(got, list) else got),
                      file=sys.stderr)
        except Exception as e:
            print("JARVIS_ENGINE_KEEP_%s_%s" % (name, backup_dropin_error(e)), file=sys.stderr)


def write_revoked():
    """A leaked release key: a release signed by the other key carries it in REVOKED_KEYS, and its setup adds it to
    /etc/jarvis-engine/revoked-keys, which the updater reads (the list only grows; a helper never un-revokes)."""
    spki = re.compile(r"MCowBQYDK2VwAyEA[A-Za-z0-9+/]{43}=")
    path = os.path.join(ETC_DIR, "revoked-keys")
    have = set((read_small(path, 64 << 10) or b"").decode("ascii", "replace").split())
    want = have | {k for k in REVOKED_KEYS if spki.fullmatch(k)}
    if want != have:
        write_file(path, ("\n".join(sorted(want)) + "\n").encode("ascii"), 0o600)


def lay_out_plugin():
    """The /server plugin files ride inside the helper (one checked artifact) and are laid out root-owned, read-only
    for everyone, one link each (OpenClaw refuses a world-writable or foreign-owned plugin file and hardlinks: discovery
    -C8SwFp3U.mjs:649-656). Files of an older plugin that are not in the kit go. True when anything changed."""
    ensure_root_dir(LIB_DIR, 0o755)
    ensure_root_dir(PLUGIN_DIR, 0o755)
    want = {name[len(PLUGIN_PREFIX):]: name for name in KIT_FILES if name.startswith(PLUGIN_PREFIX)}
    changed = False
    for rel, name in want.items():
        dest = os.path.join(PLUGIN_DIR, rel)
        try:
            st = os.lstat(dest)
            sound = stat.S_ISREG(st.st_mode) and st.st_uid == ROOT_UID and st.st_nlink == 1 and \
                stat.S_IMODE(st.st_mode) == 0o644
        except OSError:
            sound = False
        if not sound:
            write_file(dest, embedded_bytes(name), 0o644)  # a new inode: a hardlink or a wrong owner/mode is gone
            changed = True
        else:
            changed |= install_if_changed(name, dest, 0o644)
    for entry in os.listdir(PLUGIN_DIR):
        if entry not in want:
            p = os.path.join(PLUGIN_DIR, entry)
            if os.path.isdir(p) and not os.path.islink(p):
                rmtree_private(p)
            else:
                os.unlink(p)
            changed = True
    return changed


def plugin_flag():
    """(tries, helper version) of the plugin.stale flag, or None when there is none."""
    raw = read_small(PLUGIN_STALE, 128)
    if raw is None:
        return None
    m = re.fullmatch(rb"([0-9]{1,3})(?: ([0-9.]{1,20}))?", raw.strip())
    return (int(m.group(1)), (m.group(2) or b"").decode()) if m else (PLUGIN_TRIES, "")


