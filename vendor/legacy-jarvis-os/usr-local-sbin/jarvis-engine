def ack_present():
    """The Jarvis bot's goodbye: ~/.msb/engine/stop-ack (any kind of entry; removed, never followed)."""
    try:
        dfd, _ = open_dir_chain(SOURCES[0][1])
    except OSError:
        return False
    try:
        try:
            os.stat(STOP_ACK_NAME, dir_fd=dfd, follow_symlinks=False)
        except FileNotFoundError:
            return False
        remove_entry(dfd, STOP_ACK_NAME)
        return True
    finally:
        os.close(dfd)


def mask_bots(ids):
    """disable + `mask --now` (mask alone does not stop a running unit), then verify nothing still runs."""
    for b in ids:
        systemctl_ok("disable", bot_unit(b), timeout=120)
        systemctl_ok("mask", "--now", bot_unit(b), timeout=120)
    still = [b for b in ids if systemctl_word("is-active", bot_unit(b)) == "active"]
    if still:
        raise Refused("FAILED", "failed", {"reason": "STILL_ACTIVE", "bots": still})


def stop_handshake(ids, kind, progress, detail):
    """C4: the bot stops LAST. The mark of intent (off/removed) is written FIRST, so a run killed halfway is finished
    by the tick (reconcile_jarvis) and never leaves a masked bot without a way back. Announce, wait for the bot's ack
    (it says goodbye first) at most STOP_ACK_WAIT, then disable + mask --now (bot-ctl.sh, the puller's restart and a
    reboot cannot start a masked unit), verified."""
    mark_bots(ids, kind)
    ack_present()  # a stale ack of an earlier run never counts
    if any(systemctl_word("is-active", bot_unit(b)) == "active" for b in ids):
        progress("jarvis_stop_pending", detail)
        deadline = now() + STOP_ACK_WAIT
        while now() < deadline and not ack_present():
            time.sleep(2)
    mask_bots(ids)


def reconcile_jarvis():
    """Tick: our marks and the units agree. A mark without a mask (a run killed halfway, a hand that unmasked) →
    masked; a masked bot without a mark (someone masked it) → marked off, so «▶️ Включить» is offered."""
    if not jarvis_present():
        return
    for b in jarvis_bots():
        if (b["removed"] or os.path.lexists(bot_mark(b["id"], "off"))) and not b["masked"]:
            try:
                mask_bots([b["id"]])
            except Refused:
                pass
        elif b["masked"] and not b["removed"] and not os.path.lexists(bot_mark(b["id"], "off")):
            mark_bots([b["id"]], "off")


def mark_bots(ids, kind):
    ensure_root_dir(ETC_DIR, 0o700)
    ensure_root_dir(JARVIS_MARKS, 0o700)
    for b in ids:
        write_file(bot_mark(b, kind), ("at=%d\n" % now()).encode(), 0o600)


def unmark_bots(ids, kind):
    for b in ids:
        if os.path.lexists(bot_mark(b, kind)):
            os.unlink(bot_mark(b, kind))


def set_sleep(ids, on, rid):
    """Sleep marks of these bots written (on) or deleted, by client itself (its own directory)."""
    if ids:
        client_py(SLEEP_PY, [SOURCES[0][1], "1" if on else "0", now(), rid or "", ",".join(ids)])


def wake_all(rid):
    """Every sleeping bot woken: OpenClaw stops answering (switched off or removed), so «сейчас работает OpenClaw» would
    be a lie and the bot would answer nobody. Returns the ids woken."""
    ids = sorted(sleep_marks())
    set_sleep(ids, False, rid)
    return ids


def start_bots(ids, unmark=()):
    """unmask + enable --now, bot by bot. The marks of intent in `unmark` (off, removed) go for a bot only AFTER it
    started: a bot whose start failed keeps its mark, the tick masks it again (reconcile_jarvis) and it stays «off» /
    «removed» with its way back offered, never an unmasked, disabled, dead unit without a mark (the pulse would read
    `disabled` as switched off on purpose and the base pulse would cover the dead bot)."""
    ok = True
    for b in ids:
        systemctl_ok("unmask", bot_unit(b))
        if systemctl_ok("enable", "--now", bot_unit(b), timeout=120):
            for kind in unmark:
                unmark_bots([b], kind)
        else:
            ok = False
    if not ok:
        raise Refused("FAILED", "failed", {"reason": "JARVIS_START"})


def act_add_openclaw(source, req, work, progress):
    p = req["params"]
    m = marker()
    # Installed, but a step after the install script failed (seed, channel: a bad token, a blip) and our record says
    # its channel was never configured: continued, not refused, else the owner is left with a bot that never answers
    # and only remove + reinstall (stand 10.10). The same installation and owner; every check below still applies.
    resume = m.get("complete") == "1"
    if resume and not unconfigured(m):
        raise Refused("ALREADY_INSTALLED")
    if resume and os.path.lexists(OC_OFF):
        raise Refused("ENGINE_OFF")  # switched off by the owner (unit disabled, no revive): «▶️ Включить» first
    # The root record of install time is the owner; ADMIN_ID of the client's .env only where no record exists.
    owners = {recorded_owner()} if recorded_owner() else jarvis_owner_ids()
    if not owners:
        raise Refused("OWNER_MISMATCH", detail={"reason": "OWNER_UNKNOWN"})  # a bot open to everyone: nobody to bind to
    if p["owner"] not in owners or m.get("owner") not in (None, "", p["owner"]):
        raise Refused("OWNER_MISMATCH")  # the owner recorded at the first attempt is the owner
    if any(same_bot(t, p["token"]) for t in jarvis_tokens()):
        raise Refused("TOKEN_IN_USE")
    need_disk(add_need_bytes(resume))
    iid = m.get("installation_id") if UUID_RE.fullmatch(m.get("installation_id") or "") else str(uuid.uuid4())
    rec = key_values(OC_SETUP_FILE)
    # «🦞 Перейти» once for this installation = always for it: the adapter stays on until the new bot works (the bot
    # switches it off then), so a continue without the flag would be refused ADAPTER_PRESENT. The flag only lifts that
    # check; the nft table keeps OpenClaw off the adapter's ports anyway.
    beside = bool(p.get("from_adapter")) or \
        (bool(m) and rec.get("installation_id") == iid and rec.get("beside_adapter") == "1")
    lib = unpack(work)
    write_setup(iid, 0, beside)  # before the install script marks OpenClaw complete: until configure succeeds, resumable
    progress("install")
    args = ["--port", OC_PORT, "--installation-id", iid, "--owner", p["owner"], "--version", OC_VERSION_VERIFIED]
    if resume:
        args.append("--resume")  # the script refuses a complete install without it; it keeps the runtime and the unit
    if beside:
        # «🦞 Перейти»: the old adapter keeps answering in the Jarvis bot until the new bot works; that bot then switches
        # its adapter off itself (archive, reversible). The nft table keeps OpenClaw off the adapter's loopback ports.
        args.append("--beside-adapter")
    result, info = script(work, lib, "openclaw-install.sh", args)
    if result != "ok":
        raise script_refused(result, info)
    progress("language")
    seed_russian(work, ("before-resume-" + stamp().lower()) if resume else None)
    memory = {"result": "off"}
    if p.get("import_memory", True):
        # a copy of the Jarvis memory is a gift, not a condition: its failure never fails the install
        try:
            memory = import_jarvis_memory(work)
        except Refused as e:
            memory = {"result": "failed", "reason": e.detail.get("reason", e.code)}
        except Exception as e:  # any surprise in the copy (odd names, IO) is the copy's failure, never the install's
            memory = {"result": "failed", "reason": "INTERNAL_" + type(e).__name__.upper()[:40]}
    progress("configure")
    lay_out_plugin()  # the /server plugin files are there before configure wires them (no restart of anything)
    inp = os.path.join(work, "input.json")
    write_file(inp, json.dumps({"telegram": {"token": p["token"], "username": "openclaw_bot", "allowFrom": [p["owner"]],
                                             "accountId": "default"},
                                "model": p.get("model") or {"mode": "none"},
                                "plugin": {"jarvisBot": p.get("jarvis_bot") or ""}}).encode())
    try:
        result, info2 = script(work, lib, "openclaw-configure.sh", ["configure", inp], timeout=900)
    finally:
        if os.path.lexists(inp):
            os.unlink(inp)
    if result != "ok":
        raise script_refused("failed", info2)  # the server is touched: OpenClaw is installed, the channel is not
    write_setup(iid, 1, beside)  # only now a repeated add-openclaw is ALREADY_INSTALLED
    try:
        defaults_installed(iid)  # installed with today's defaults: the tick has nothing to bring over
    except Exception:  # noqa: BLE001 without the record the tick finds nothing of ours to change: never a failed install
        print("JARVIS_ENGINE_DEFAULTS_RECORD", file=sys.stderr)
    menus_after_configure(p["token"])
    if plugin_settled(info2):
        if os.path.lexists(PLUGIN_STALE):
            os.unlink(PLUGIN_STALE)
    else:
        flag_plugin()  # OpenClaw works without /server; the tick wires it later
    return {"openclaw_version": info.get("version", ""), "model_mode": info2.get("model", ""),
            "model_status": info2.get("model_status", ""), "plugin": info2.get("plugin", ""),
            "model_id": info2.get("model_id", ""), "verified": info2.get("verified", ""), "memory": memory}


def act_remove_openclaw(source, req, work, progress):
    if not marker():
        raise Refused("NOT_INSTALLED")
    need_jarvis_working()
    keep = req["params"]["keep"]
    name = "openclaw-" + stamp()
    ensure_root_dir(STAGING_DIR, 0o700)
    staging = os.path.join(STAGING_DIR, name.lower())
    rmtree_private(staging)
    os.mkdir(staging, 0o700)
    try:
        progress("uninstall")
        result, info = script(work, unpack(work), "openclaw-uninstall.sh", ["--home-to", os.path.join(staging, "home")],
                              timeout=600)
        if result != "ok":
            raise script_refused(result, info)
        detail = {"archive": name, "kept": keep, "erase_after": None}
        home = os.path.join(staging, "home")
        if not os.path.isdir(home):
            return detail
        progress("archive")
        arch, trash, secrets = (os.path.join(staging, x) for x in ("archive", "trash", "secrets"))
        for d in (arch, trash, secrets):
            os.mkdir(d, 0o700)
        counts, history = sort_openclaw_home(home, keep, arch, trash, secrets)
        with open(os.path.join(arch, "ARCHIVE.json"), "w") as f:
            json.dump({"engine": "openclaw", "removed_at": now(), "kept": keep, "history": history}, f, sort_keys=True)
        detail["landed"] = hand_off(arch, "", name)
        if os.listdir(trash):
            hand_off(trash, ".trash", name)
            detail["erase_after"] = iso(now() + TRASH_TTL)
        if os.listdir(secrets):
            ensure_root_dir(ROOT_TRASH, 0o700)
            os.rename(secrets, os.path.join(ROOT_TRASH, name))
        detail["moved"] = counts
        detail["history"] = history
        return detail
    finally:
        rmtree_private(staging)
        if not marker():
            # OpenClaw is gone: a bot that slept «while OpenClaw answers» answers again; its update and setup records
            # go too
            forget_oc_update()
            for f in (OC_SETUP_FILE, OC_DEFAULTS_FILE):
                if os.path.lexists(f):
                    os.unlink(f)
            try:
                woken = wake_all(req["id"])
            except Refused:
                woken = None
            if woken:
                print("JARVIS_ENGINE_WOKEN %s" % ",".join(woken), file=sys.stderr)


def act_update_openclaw(source, req, work, progress):
    o = openclaw_info()
    if not o["installed"]:
        raise Refused("NOT_INSTALLED")
    if not o["enabled"]:
        raise Refused("ENGINE_OFF")
    cur, target = oc_version(o["version"]), oc_version(OC_VERSION_VERIFIED)
    if cur and cur > target:
        raise Refused("DOWNGRADE", detail={"openclaw_version": o["version"], "offered": OC_VERSION_VERIFIED})
    if cur and cur == target:
        raise Refused("ALREADY_CURRENT", detail={"openclaw_version": o["version"]})
    progress("update")
    result, info = script(work, unpack(work), "openclaw-configure.sh", ["update", OC_VERSION_VERIFIED])
    if result != "ok":
        wake_if_openclaw_down(work, req["id"])
        raise script_refused(result, info)
    return {"openclaw_version": info.get("version", "")}


def wake_if_openclaw_down(work, rid):
    """After a failed update (it does not roll back) a sleeping bot must not keep saying «OpenClaw answers» to a dead
    gateway: the gateway not active, or OpenClaw's setup never finished, = every sleeping bot woken. Never raises."""
    try:
        if not sleep_marks():
            return []
        gateway, _ = openclaw_live(work, unpack(work))
        return wake_all(rid) if gateway != "active" or unconfigured(marker()) else []
    except Exception:
        return []


def act_enable_openclaw(source, req, work, progress):
