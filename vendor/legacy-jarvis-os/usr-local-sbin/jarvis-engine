# ── 0.5.7 import-cron: the old adapter's scheduled tasks into OpenClaw's own cron («Перейти на 🦞») ──────────────
# Bot v27.170+ (src/agent/engines-menu.ts moveAdapterJobsToNative, the requirement in PR #1150): the tasks the old
# adapter ran on its own schedule move into the native OpenClaw's scheduler instead of staying paused. The bot puts
# them as ~/.msb/engine/cron-import.<bot_id>.json (client 0600, written atomically) and names it in the request with its
# sha256; the file is taken here like a request (O_NOFOLLOW chain, regular, owner client, single link, removed first,
# at most CRON_IMPORT_MAX_BYTES) and its hash must match. Only what the native cron runs by itself goes over: a schedule
# of cron (5-6 fields, its IANA zone REQUIRED and known to tzdata), interval (minutes) or one time in the future; a task in words (an isolated agent turn,
# its answer to the owner in Telegram) or a reminder (the text to the owner as it is: a command job printing it, no
# model call). A job with anything else (sources, roles, freshness, follow-ups, delivery to a channel: the bot already
# leaves such tasks paused, review v27.170 p.3), a past one-time run or a value out of bounds = skipped with its reason,
# never half moved. Each job gets the stable name from-jarvis:<bot_id>:<key>: one already in the scheduler under that
# name is `exists`, never a twin (a repeat after a lost answer is safe). The rights a task had in the adapter and its
# helper roles do not move: in OpenClaw it runs with OpenClaw's own. The jobs in OpenClaw now (ok, exists) are also
# written into the bot's archive of the switch (~/.msb/archive/adapter-*/moved-jobs.json, as client), so «◂ Вернуть»
# never resumes them in the old mode, even when the bot restarted while it waited for this answer (review v27.170 p.4).
CRON_IMPORT_MAX_BYTES = 256 * 1024
CRON_IMPORT_MAX_JOBS = 50
CRON_IMPORT_MAX_TEXT = 8000
CRON_IMPORT_MAX_NAME = 120
CRON_IMPORT_EVERY_MAX = 31 * 24 * 60
CRON_IMPORT_SEC = 1500   # the script's own budget is less (openclaw-configure.sh cronimport); the bot waits 30 min
CRON_IMPORT_JOB_KEYS = ("key", "name", "schedule", "kind", "text")
CRON_KEY_RE = re.compile(r"[A-Za-z0-9_.:-]{1,128}")
CRON_EXPR_RE = re.compile(r"[0-9A-Za-z*,/?#LW-]+( [0-9A-Za-z*,/?#LW-]+){4,5}")
CRON_TZ_RE = re.compile(r"[A-Za-z][A-Za-z0-9_+-]*(/[A-Za-z0-9_+-]+){0,2}")
ZONEINFO_DIR = "/usr/share/zoneinfo"   # a cron zone must exist here (tzdata), else the job is skipped (TZ)
CRON_CTRL_RE = re.compile(r"[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]")
# A lone surrogate (JSON "\ud800" without its pair) is a valid python str but not UTF-8: encoding the script's input
# would fail the whole batch (review 12.10). Such a name or text = skipped (NAME, TEXT).
CRON_SURROGATE_RE = re.compile(r"[\ud800-\udfff]")
CRON_AT_RE = re.compile(r"([0-9]{4})-([0-9]{2})-([0-9]{2})[T ]([0-9]{2}):([0-9]{2})(?::([0-9]{2})(?:\.[0-9]{1,9})?)?"
                        r"(Z|[+-][0-9]{2}:?[0-9]{2})?")
CRON_JOB_LINE_RE = re.compile(r"OPENCLAW_CRONIMPORT_JOB ([0-9]{1,3}) (ok|exists|failed)")


def cron_import_file(bot):
    return "cron-import.%s.json" % bot


def cron_on():
    """C8 for import-cron: cron is on as far as this helper knows. This installation was set up by 0.5.6+ (cron on from
    the first config) or brought over by the tick (defaults record), and the owner did not keep it off. The script reads
    the config itself at run time (HOST_NOT_READY, CRON_DISABLED)."""
    iid = marker().get("installation_id")
    rec = oc_defaults_record()
    kept = rec.get("kept") if isinstance(rec.get("kept"), list) else []
    return bool(iid) and rec.get("installation_id") == iid and isinstance(rec.get("version"), int) and \
        rec["version"] >= OC_DEFAULTS_VERSION and rec.get("result") in ("install", "done") and "cron.enabled" not in kept


def cron_at(v):
    """A one-time run as seconds since the epoch, or None. An offset-less time is UTC (as OpenClaw reads it)."""
    m = CRON_AT_RE.fullmatch(v) if isinstance(v, str) and len(v) <= 40 else None
    if not m:
        return None
    y, mo, d, h, mi = (int(m.group(i)) for i in range(1, 6))
    sec = int(m.group(6) or 0)
    if not (1 <= mo <= 12 and 1 <= d <= calendar.monthrange(y, mo)[1] and h <= 23 and mi <= 59 and sec <= 59):
        return None
    t = calendar.timegm((y, mo, d, h, mi, sec, 0, 0, 0))
    off = m.group(7)
    if off and off != "Z":
        hh, mm = int(off[1:3]), int(off[-2:])
        if hh > 23 or mm > 59:
            return None
        t -= (1 if off[0] == "+" else -1) * (hh * 3600 + mm * 60)
    return t


def cron_line_ok(v, limit, lines):
    return isinstance(v, str) and bool(v.strip()) and len(v) <= limit and not CRON_CTRL_RE.search(v) and \
        not CRON_SURROGATE_RE.search(v) and (lines or ("\n" not in v and "\r" not in v))


def cron_job(j):
    """(why, job) of one job of the bot's file: why = None and the job as the script takes it, or a reason word."""
    if not set(j) <= set(CRON_IMPORT_JOB_KEYS):
        return "UNSUPPORTED", None   # a field the native cron has no place for: not moved half
    if not set(CRON_IMPORT_JOB_KEYS) <= set(j):
        return "FIELDS", None
    if j["kind"] not in ("prompt", "reminder"):
        return "KIND", None
    if not cron_line_ok(j["name"], CRON_IMPORT_MAX_NAME, False):
        return "NAME", None
    if not cron_line_ok(j["text"], CRON_IMPORT_MAX_TEXT, True):
        return "TEXT", None
    sc, out = j["schedule"], None
    if isinstance(sc, dict) and sc.get("kind") == "cron" and set(sc) == {"kind", "expr", "tz"}:
        # the zone is required: without it OpenClaw reads the expression in the host's zone (UTC), the adapter read it
        # in the owner's (Moscow by default): the task would move by hours (live check 12.10 on 002fa94b)
        expr, tz = sc["expr"], sc["tz"]
        if isinstance(expr, str) and len(expr) <= 100 and CRON_EXPR_RE.fullmatch(expr) and \
                isinstance(tz, str) and len(tz) <= 64 and CRON_TZ_RE.fullmatch(tz):
            if not os.path.isfile(os.path.join(ZONEINFO_DIR, tz)):
                return "TZ", None   # no such zone here: the add would fail; said honestly as «set it up again»
            out = {"kind": "cron", "expr": expr, "tz": tz}
    elif isinstance(sc, dict) and sc.get("kind") == "every" and set(sc) == {"kind", "minutes"}:
        n = sc["minutes"]
        if isinstance(n, int) and not isinstance(n, bool) and 1 <= n <= CRON_IMPORT_EVERY_MAX:
            out = {"kind": "every", "minutes": n}
    elif isinstance(sc, dict) and sc.get("kind") == "at" and set(sc) == {"kind", "at"}:
        t = cron_at(sc["at"])
        if t is not None and t <= now():
            return "AT_PAST", None
        if t is not None:
            out = {"kind": "at", "at": iso(t)}
    if out is None:
        return "SCHEDULE", None
    return None, {"key": j["key"], "name": j["name"].strip(), "kind": j["kind"], "text": j["text"], "schedule": out}


def cron_import_jobs(raw, bot):
    """(jobs, {key: why} skipped) of the bot's file, in its order. The file as a whole wrong = Refused BAD_REQUEST
    JOBS_FORMAT / JOBS_TOO_MANY; a job the native cron cannot run as given = skipped (cron_job). The bounds are the
    bot's (src/agent/engine-helper.ts cronJobValid, CRON_IMPORT_MAX_*)."""
    def bad(reason="JOBS_FORMAT"):
        return Refused("BAD_REQUEST", detail={"reason": reason})
    try:
        doc = strict_json(raw, "BAD_REQUEST")
    except Refused:
        raise bad()
    if not isinstance(doc, dict) or set(doc) != {"v", "bot_id", "jobs"} or doc["v"] != 1 or isinstance(doc["v"], bool) \
            or doc["bot_id"] != bot or not isinstance(doc["jobs"], list):
        raise bad()
    if len(doc["jobs"]) > CRON_IMPORT_MAX_JOBS:
        raise bad("JOBS_TOO_MANY")
    jobs, skipped = [], {}
    for j in doc["jobs"]:
        key = j.get("key") if isinstance(j, dict) else None
        if not isinstance(key, str) or not CRON_KEY_RE.fullmatch(key) or key in skipped or any(x["key"] == key for x in jobs):
            raise bad()   # a job that cannot even be named in the answer
        why, job = cron_job(j)
        if why:
            skipped[key] = why
        else:
            jobs.append(job)
    return jobs, skipped


def cron_owner():
    """Where the jobs announce: the owner OpenClaw's bot answers (its install marker), else the recorded owner."""
    o = marker().get("owner", "")
    return o if TG_ID_RE.fullmatch(o) else recorded_owner()


# Run AS client: the keys now in OpenClaw's cron into the bot's archive of the switch, in the bot's own format
# (src/agent/adapter-migrate.ts writeMovedJobs / readMovedJobs: {"v":1,"at":…,"moved":[…]}): the newest
# ~/.msb/archive/adapter-* whose bot-<bot_id>.json paused any of them; what the file already lists stays. None = nothing.
MOVED_PY = r'''
import json, os, re, sys
home, bot, at = sys.argv[1], sys.argv[2], sys.argv[3]
keys = json.loads(sys.stdin.read())
root = os.path.join(home, ".msb", "archive")
dir_re = re.compile(r"adapter-[0-9]{8}T[0-9]{6}Z(-[0-9]{1,2})?")
id_re = re.compile(r"[A-Za-z0-9_.:-]{1,128}")
def load(p, limit):
    try:
        st = os.lstat(p)
        if os.path.islink(p) or not os.path.isfile(p) or st.st_size > limit:
            return None
        with open(p) as f:
            return json.load(f)
    except Exception:
        return None
try:
    names = sorted((n for n in os.listdir(root) if dir_re.fullmatch(n)), reverse=True)
except OSError:
    names = []
for n in names:
    d = os.path.join(root, n)
    if os.path.islink(d) or not os.path.isdir(d):
        continue
    m = load(os.path.join(d, "bot-" + bot + ".json"), 1 << 20)
    paused = m.get("pausedJobs") if isinstance(m, dict) and m.get("botId") == bot else None
    if not isinstance(paused, list) or not any(k in paused for k in keys):
        continue
    f = os.path.join(d, "moved-jobs.json")
    cur = load(f, 64 * 1024)
    have = cur.get("moved") if isinstance(cur, dict) and cur.get("v") == 1 and isinstance(cur.get("moved"), list) else []
    have = [x for x in have if isinstance(x, str) and id_re.fullmatch(x)]
    whole = have + [k for k in keys if k not in have]
    moved = whole[:200]   # the bot reads at most 200
    tmp = f + ".jarvis-engine.tmp"
    if os.path.lexists(tmp):
        os.unlink(tmp)
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "w") as fh:
        fh.write(json.dumps({"v": 1, "at": at, "moved": moved}) + "\n")
    os.replace(tmp, f)
    print(json.dumps({"archive": n, "cut": len(whole) - len(moved)}))
    sys.exit(0)
print(json.dumps({"archive": ""}))
'''


def record_moved(bot, keys):
    """archive | partial (the file holds 200, the bot's limit: not every key fits) | none (no archive of the switch paused
    them) | failed. Never raises."""
    try:
        out = client_py(MOVED_PY, [CLIENT_HOME, bot, iso()], input=json.dumps(keys).encode(), timeout=60)
    except Exception:  # noqa: BLE001 the bot writes the same file after the answer; this one only covers its restart
        return "failed"
    if not out.get("archive"):
        return "none"
    return "partial" if out.get("cut") else "archive"   # partial: over the bot's 200, some keys not written


def act_import_cron(source, req, work, progress):
    p = req["params"]
    bot = p["bot_id"]
    # the file first, whatever follows: the owner's task texts never stay in the request directory
    raw = take_request(SOURCES[0][1], uid_of(SOURCES[0][2]), p["jobs_file"], CRON_IMPORT_MAX_BYTES)
    if not isinstance(raw, bytes):
        raise Refused("BAD_REQUEST", detail={"reason": "JOBS_FILE"})
    if hashlib.sha256(raw).hexdigest() != p["jobs_sha256"]:
        raise Refused("BAD_REQUEST", detail={"reason": "JOBS_HASH"})
    jobs, skipped = cron_import_jobs(raw, bot)
    o = openclaw_info()
    if not marker():
        raise Refused("NOT_INSTALLED")
    if o["installed"] and not o["enabled"]:
        raise Refused("ENGINE_OFF")
    if o["incomplete"]:
        raise Refused("HOST_NOT_READY", detail={"reason": "INCOMPLETE"})
    owner = cron_owner()
    if owner is None:
        raise Refused("HOST_NOT_READY", detail={"reason": "NO_OWNER"})
    words, reason = {}, None
    if jobs:
        lib = unpack(work)
        gateway, _ = openclaw_live(work, lib)
        if gateway != "active":
            raise Refused("HOST_NOT_READY", detail={"reason": "GATEWAY_" + gateway.upper()})
        progress("import", {"jobs": len(jobs)})
        inp = os.path.join(work, "cron-import.json")
        calls = [{"n": i, "name": "from-jarvis:%s:%s" % (bot, j["key"]), "display": j["name"], "kind": j["kind"],
                  "text": j["text"], "schedule": j["schedule"]} for i, j in enumerate(jobs)]
        write_file(inp, json.dumps({"owner": owner, "jobs": calls}, ensure_ascii=False).encode("utf-8"))
        try:
            result, info = script(work, lib, "openclaw-configure.sh", ["cronimport", inp], timeout=CRON_IMPORT_SEC)
        finally:
            if os.path.lexists(inp):
                os.unlink(inp)
        said = {}
        for line in (read_small(os.path.join(work, "openclaw-configure.sh.out"), 1 << 20) or b"").decode("utf-8", "replace").splitlines():
            m = CRON_JOB_LINE_RE.fullmatch(line.strip())
            if m and int(m.group(1)) < len(jobs):
                said[int(m.group(1))] = m.group(2)
        # a run that stopped halfway still says which jobs are there: those are a partial success, never «nothing»
        if result != "ok" and not any(w in ("ok", "exists") for w in said.values()):
            raise script_refused(result, info)
        if result != "ok":
            reason = info
        words = {j["key"]: said.get(i, "failed") for i, j in enumerate(jobs)}
    words.update({k: "skipped" for k in skipped})
    count = lambda w: sum(1 for v in words.values() if v == w)
    detail = {"imported": count("ok"), "exists": count("exists"), "failed": count("failed"), "skipped": count("skipped"),
              "jobs": words}
    if skipped:
        detail["skipped_why"] = skipped
    if reason:
        detail["reason"] = reason
    moved = [k for k, w in words.items() if w in ("ok", "exists")]
    if moved:
        detail["recorded"] = record_moved(bot, moved)
    elif jobs:
        raise Refused("FAILED", "failed", dict(detail, reason=reason or "CRON_ADD"))
    return detail


ACTS = {"add-openclaw": act_add_openclaw, "remove-openclaw": act_remove_openclaw, "update-openclaw": act_update_openclaw,
        "enable-openclaw": act_enable_openclaw, "disable-openclaw": act_disable_openclaw,
        "add-jarvis": act_add_jarvis, "remove-jarvis": act_remove_jarvis, "enable-jarvis": act_enable_jarvis,
        "disable-jarvis": act_disable_jarvis, "restore": act_restore, "set-model": act_set_model, "status": act_status,
        "import-cron": act_import_cron}


def locked(wait=True):
    """The one lock of the helper (and of the updater). wait=False: None when a request is running."""
    ensure_root_dir(RUN_DIR, 0o755)
    fd = os.open(os.path.join(RUN_DIR, "lock"), os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX if wait else fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(fd)
        return None
    return fd


def peek_request(data):
    """(id, action, bot_id) of a request the host refuses before reading it (HOST_NOT_READY): each only when well
    formed, else None. Nothing else of it is used."""
    try:
        obj = strict_json(data, "BAD_REQUEST")
    except Refused:
        return None, None, None
    if not isinstance(obj, dict):
        return None, None, None
    rid, action, bot = obj.get("id"), obj.get("action"), obj.get("bot_id")
    return (rid if isinstance(rid, str) and ID_RE.fullmatch(rid) else None,
            action if action in ACTIONS else None,
            bot if isinstance(bot, str) and BOT_ID_RE.fullmatch(bot) else None)


def handle(source, data):
    try:
        req = parse_request(data)
    except Refused as e:
        return write_result(source, getattr(e, "request_id", None), None, "refused", e.code, None, e.detail)
    rid, action = req["id"], req["action"]
    bot = req["params"].get("bot_id")
    if action not in SOURCE_ACTIONS[source]:
        return write_result(source, rid, action, "refused", "NOT_ALLOWED", bot_id=bot)
    limited = spend(source, rid, action)
    if limited:
        return write_result(source, rid, action, "refused", limited, bot_id=bot)
    if action != "status" and sandboxes_alive():
        # a step of an earlier run still runs as openclaw: no second one beside it
        return write_result(source, rid, action, "refused", "BUSY", bot_id=bot)
    work = work_dir("task")
    if action != "status":
        mark_busy(action)
    try:
        progress = lambda phase, detail=None: write_result(source, rid, action, "running", "RUNNING", phase, detail, bot)
        progress("start")
        try:
            detail = ACTS[action](source, req, work, progress)
            outcome = ("done", "OK", detail)
        except Refused as e:
            outcome = (e.result, e.code, e.detail)
        except Exception as e:  # never leave the bot waiting on «running»: an unexpected error is a failure
            outcome = ("failed", "FAILED", {"reason": "INTERNAL_" + type(e).__name__.upper()[:40]})
        if action in ("add-openclaw", "remove-openclaw"):
            try:
                ensure_sudoers()  # 0.5.8: root through sudo exactly while OpenClaw is installed here
            except Exception as e:
                print("JARVIS_ENGINE_SUDOERS_%s" % backup_dropin_error(e), file=sys.stderr)
        try:
            write_state(compute_state(work))
        except Exception:
            pass
        write_result(source, rid, action, outcome[0], outcome[1], None, outcome[2], bot)
        if outcome[0] == "done" and action in SNAPSHOT_EVENTS and \
                not (action == "import-cron" and not (outcome[2] or {}).get("imported")):  # nothing new in the scheduler
            # the engines changed: a fresh copy for the backup, AFTER the bot has its result (best effort, bounded)
            snapshot_after(action)
    finally:
        clear_busy()
        rmtree_private(work)


def cmd_run(args):
    need_root()
    lock = locked()
    try:
        sweep_work()
        todo = [(n, take_request(p, uid_of(u))) for n, p, u in SOURCES if uid_of(u) is not None]
        for name, got in todo:
            if got is None:
                continue
            refusal = host_refusal()
            if refusal:
                # the bot waits for ITS id: a readable id goes with the refusal (nothing of the request is acted on)
                rid, action, bot = peek_request(got) if isinstance(got, bytes) else (None, None, None)
                write_result(name, rid, action, "refused", "HOST_NOT_READY", None, {"reason": refusal}, bot)
            elif isinstance(got, Refused):
                write_result(name, None, None, got.result, got.code, None, got.detail)
            else:
                handle(name, got)
        stuck = any(os.path.exists(os.path.join(p, REQUEST_NAME)) for _, p, _ in SOURCES)
    finally:
        os.close(lock)
    # A request that could not be consumed (e.g. a symlinked directory) keeps PathExists true: slow the restart loop
    # down instead of spinning (no start limit on purpose, see jarvis-engine.service), WITHOUT the lock, so the tick
    # (revive, puller guard, trash) still gets its turn.
    if stuck:
        time.sleep(STUCK_SLEEP)
    return 0


# ── setup / tick / status ────────────────────────────────────────────────────────────────────────
def request_dirs():
    if uid_of("client") is not None and os.path.isdir(os.path.join(CLIENT_HOME, ".msb")):
        as_user("client", [MKDIR, "-p", "-m", "0700", SOURCES[0][1]])
    if uid_of("openclaw") is not None and os.path.lexists(OPENCLAW_MARKER):
        as_user("openclaw", [MKDIR, "-p", "-m", "0700", SOURCES[1][1]])


def cmd_setup(args):
    need_root()
    refusal = host_refusal()
    if refusal:
        # 0.5.8/0.5.9: never a grant here; a file of ours goes when the switch is on, OpenClaw is gone or Claude Code locked
        for step in (ensure_sudoers, ensure_cc_sudoers, ensure_bot_dropin):
            try:
                step()
            except Exception:
                pass
        raise Refused(refusal)
    if not EMBEDDED:
        raise Refused("NOT_BUILT", "failed")
    for d, mode in ((WORK_ROOT, 0o700), (STATE_DIR, 0o700), (ETC_DIR, 0o700), (RUN_DIR, 0o755), (LIB_DIR, 0o755)):
        ensure_root_dir(d, mode)
    for unit in OWN_UNITS:
        install_if_changed(unit, os.path.join(UNITS_DIR, unit), 0o644)
    for src, dest, mode in STATIC_FILES:
        if not os.path.lexists(dest):  # never replaced once present: the update path is not ours to change
            write_file(dest, embedded_bytes(src), mode)
    flag = plugin_flag()
    if lay_out_plugin() or (flag is not None and flag[1] != HELPER_VERSION):
        # OpenClaw keeps the old plugin code until a reload: the tick wires and reloads it (never here: the updater
        # gives setup 5 minutes and rolls the helper back when it fails). A new helper version re-arms a flag the
        # tick gave up on.
        flag_plugin()
    # the backup's snapshot drop-in (0.5.5), before the reload below that loads it; never a reason to roll back
    try:
        ensure_backup_dropin(reload=False)
    except Exception as e:
        print("JARVIS_ENGINE_BACKUP_DROPIN_%s" % backup_dropin_error(e), file=sys.stderr)
    # 0.5.9: OpenClaw's slice ceilings by the server's RAM, applied to the running slice; never a reason to roll back
    try:
        got = keep_oc_limits()
        if got:
            print("JARVIS_ENGINE_OC_LIMITS %s" % got, file=sys.stderr)
    except Exception as e:
        print("JARVIS_ENGINE_OC_LIMITS_%s" % backup_dropin_error(e), file=sys.stderr)
    # every time, not only when a unit file changed: an earlier setup whose reload failed left the files as they are
    # now, and systemd still runs the old definitions
    reloaded = systemctl_ok("daemon-reload")

    def units_off(units):
        if systemctl_ok("enable", "--now", *units):
            return []
        # a non-zero answer can be a mere warning: what counts is each unit enabled AND running now
        deadline = time.monotonic() + UNITS_CHECK_WAIT
        return [u for u, e, a in zip(units, systemctl_words("is-enabled", units, deadline),
                                     systemctl_words("is-active", units, deadline)) if e != "enabled" or a != "active"]
    off = units_off(list(OWN_ENABLE))
    # The update path's unit is not this helper's (written once, never replaced): when it is off that is said, never a
    # failure (that would roll every update back for good, while the tick still starts the updater every 6 h).
    static_off = units_off(list(STATIC_ENABLE))
    if static_off:
        print("JARVIS_ENGINE_UPDATE_PATH_OFF %s" % " ".join(static_off), file=sys.stderr)
    # the rest runs either way (a revoked key stays revoked even when this helper is rolled back), then the verdict
    write_revoked()
    request_dirs()
    try:
        refresh_nft()
    except Exception as e:  # the guard is refreshed by the next setup; a failure here never rolls the helper back
        print("JARVIS_ENGINE_NFT_%s" % type(e).__name__.upper()[:40], file=sys.stderr)
    if off or not reloaded:
        # 0.5.8: the updater now puts back a helper that may not know the sudoers file (0.5.7: nobody would guard it,
        # its switch would not work, its remove-openclaw would leave it): the rights go with this setup. The helper put
        # back gives them again in its own setup when it knows them.
        # 0.5.9: the same for the rights of client (0.5.8 does not know them: its tick would not guard them, its switch
        # would not take them away)
        for name, step in (("SUDOERS", ensure_sudoers), ("CC_SUDOERS", ensure_cc_sudoers), ("BOT_DROPIN", ensure_bot_dropin)):
            try:
                step(grant=False)
            except Exception as e:
                print("JARVIS_ENGINE_%s_%s" % (name, backup_dropin_error(e)), file=sys.stderr)
        # not set up: a non-zero exit, so the updater puts the previous helper back and the installer stops with
        # BASE_LAYER_SETUP (setup.sh Step 16b: base-layer FAILED, Jarvis unaffected); a re-run redoes all of it
        if off:
            print("JARVIS_ENGINE_UNITS_OFF %s" % " ".join(off), file=sys.stderr)  # which ones; the code line follows
        raise Refused("UNITS_OFF" if off else "DAEMON_RELOAD", "failed")
    try:
        keep_helper_copy()  # 0.5.8: only a helper whose setup went through is the one put back when it is removed
    except Exception as e:
        print("JARVIS_ENGINE_HELPER_COPY_%s" % backup_dropin_error(e), file=sys.stderr)
    # 0.5.8: OpenClaw root through sudo at once on an update (after the verdict), not a tick later; 0.5.9: client too,
    # and the bot unit's drop-in without its old sandbox (daemon-reload only: the bot gets it at its next start)
    for name, step in (("SUDOERS", ensure_sudoers), ("CC_SUDOERS", ensure_cc_sudoers), ("BOT_DROPIN", ensure_bot_dropin)):
        try:
            step()
        except Exception as e:
            print("JARVIS_ENGINE_%s_%s" % (name, backup_dropin_error(e)), file=sys.stderr)
    print("JARVIS_ENGINE_SETUP_OK version=%s" % HELPER_VERSION)
    return 0


def refresh_nft(create=False):
    """An installed OpenClaw keeps its loopback guard in step with the helper's template: a rule added later (0.5.0:
    OpenClaw's uid off the old adapter's ports 18789-18899) reaches servers installed by an older helper. Only over a
    conf that is already there (openclaw-install.sh wrote it); the table is reloaded in one nft transaction.
    create=True (0.5.8, the tick): OpenClaw has root now, so a conf it removed, emptied, edited or replaced by a link is
    written again from the template, and a failed reload never puts the agent's version back (the tick starts the
    unit, which loads the file)."""
    m = marker()
    uid, port = m.get("uid", ""), m.get("port", "")
    if not re.fullmatch(r"[0-9]{1,10}", uid) or not re.fullmatch(r"19[34][0-9]{2}", port):
        return False
    try:
        st = os.lstat(NFT_CONF)
    except FileNotFoundError:
        if not create:
            return False
        st = None
    ours = st is not None and stat.S_ISREG(st.st_mode) and st.st_uid == ROOT_UID
    if st is not None and not ours and not create:
        return False
    want = (embedded_bytes("jarvis-engine-nft.conf").decode("utf-8").replace("__OPENCLAW_UID__", uid)
            .replace("__PORT_LO__", port).replace("__PORT_HI__", str(int(port) + 110))).encode("utf-8")
    have = read_small(NFT_CONF, 1 << 16) if ours else None
    if have == want:
        return False
    if st is None:
        ensure_root_dir(ETC_DIR, 0o700)
    write_file(NFT_CONF, want, 0o600)   # a link in its place is replaced by the rename, never followed
    if not systemctl_ok("reload", NFT_UNIT):
        if not create:
            # the table did not take the new rules: the old file goes back, so the next setup tries again
            write_file(NFT_CONF, have or b"", 0o600)
        print("JARVIS_ENGINE_NFT_RELOAD", file=sys.stderr)
        return False
    return True


def rights_wanted():
    """OpenClaw installed by this helper to the end (its marker, complete=1) under its own user, and the owner's switch
    not there."""
    return not os.path.lexists(RIGHTS_OFF) and uid_of("openclaw") is not None and os.path.isfile(OPENCLAW_MARKER) \
        and not os.path.islink(OPENCLAW_MARKER) and marker().get("complete") == "1"


def rights_granted():
    """The rights as they are now: wanted, the host not held, our sudoers file there (the SOUL.md line follows this)."""
    try:
        st = os.lstat(os.path.join(SUDOERS_DIR, SUDOERS_NAME))
    except OSError:
        return False
    return stat.S_ISREG(st.st_mode) and rights_wanted() and not host_refusal()


def ensure_sudoers(grant=True):
    """0.5.8: /etc/sudoers.d/jarvis-openclaw holds exactly SUDOERS_BODY (root:root 0440, one link) while rights_wanted(),
    and is gone otherwise. Written into a temp file in the same directory (a name with a dot: sudo never reads it),
    checked by `visudo -cf` and only then renamed over the old one: a file sudo would refuse never goes in (a broken
    sudoers.d file breaks sudo for everyone); after the rename `sudo -l -U openclaw` must show the rule (a sudoers
    without the #includedir of sudoers.d: "inactive", a failure, never "written"). No sudo on the host (no directory) =
    nothing. A held host (partner/hold/unmanaged) never gets the file nor has it put back; a file there is still removed
    when the switch is on or OpenClaw is gone. grant=False (a failed setup: the updater puts back a helper that does not
    know the file) = removed whatever else holds.
    "absent" | "same" | "written" | "removed" | "none" | "held"."""
    want = grant and rights_wanted()
    if want and host_refusal():
        return "held"
    return sudoers_file(SUDOERS_NAME, SUDOERS_BODY, "openclaw", SUDOERS_TMP_RE, want)


def sudoers_file(name, body, user, tmp_re, want):
    """One sudoers.d file of the helper (0.5.8 jarvis-openclaw, 0.5.9 jarvis-client): exactly `body` (root:root 0440, one
    link) when `want`, gone otherwise; the way of writing and the checks of ensure_sudoers()."""
    try:
        dst = os.lstat(SUDOERS_DIR)
    except FileNotFoundError:
        return "absent"
    if not stat.S_ISDIR(dst.st_mode) or dst.st_uid != ROOT_UID or dst.st_mode & 0o022:
        raise Refused("SUDOERS_DIR", "failed")
    dfd = os.open(SUDOERS_DIR, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        for n in os.listdir(dfd):  # temp files of a run killed halfway
            if tmp_re.fullmatch(n):
                unlink_quiet(dfd, n)
        try:
            st = os.stat(name, dir_fd=dfd, follow_symlinks=False)
        except FileNotFoundError:
            st = None
        if not want:
            if st is None:
                return "none"
            os.unlink(name, dir_fd=dfd)
            os.fsync(dfd)
            return "removed"
        if st is not None and stat.S_ISREG(st.st_mode) and st.st_uid == ROOT_UID and st.st_gid == ROOT_GID and \
                st.st_nlink == 1 and stat.S_IMODE(st.st_mode) == 0o440 and st.st_size == len(body) and \
                read_owned(dfd, name, ROOT_UID, len(body)) == body:
            return "same"
        tmp = ".%s.tmp.%d" % (name, os.getpid())
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o440, dir_fd=dfd)
        try:
            try:
                view = memoryview(body)
                while view:
                    view = view[os.write(fd, view):]
                os.fchown(fd, ROOT_UID, ROOT_GID)
                os.fchmod(fd, 0o440)
                os.fsync(fd)
            finally:
                os.close(fd)
            r = run([VISUDO, "-cf", os.path.join(SUDOERS_DIR, tmp)], timeout=30)
            if r.returncode != 0:
                raise Refused("SUDOERS_CHECK", "failed")
            os.rename(tmp, name, src_dir_fd=dfd, dst_dir_fd=dfd)  # a link there is replaced, not followed
        except BaseException:
            unlink_quiet(dfd, tmp)
            raise
        os.fsync(dfd)
    finally:
        os.close(dfd)
    try:
        r = run(["sudo", "-n", "-l", "-U", user], timeout=30)
        effective = r.returncode == 0 and b"NOPASSWD: ALL" in r.stdout
    except (OSError, subprocess.TimeoutExpired):
        effective = False
    if not effective:
        raise Refused("SUDOERS_INACTIVE", "failed")   # the file is there, sudo does not read it: said, never "written"
    return "written"


# ── 0.5.9: Claude Code (user client) is root through sudo (step 2 of the rights) ─────────────────────────────────
def unit_file_here(path):
    """A bot unit file of ours: a regular file, never a link (a masked unit is a link to /dev/null), nothing followed."""
    try:
        return stat.S_ISREG(os.lstat(path).st_mode)
    except OSError:
        return False


def sudo_here():
    """sudo on this host: its /etc/sudoers.d is a directory (no sudo = no rights for client, nothing written)."""
    try:
        return stat.S_ISDIR(os.lstat(SUDOERS_DIR).st_mode)
    except OSError:
        return False


def bot_dropin_places():
    """(unit file, its drop-in directory, the unit systemd is asked NeedDaemonReload about) of both kinds of the bot's
    unit: the multibot template (asked through its first bot, None while it has none) and the single unit of a server
    from before multibot. Which of them is here is decided by unit_file_here(), never by a guess."""
    ids = bot_ids()
    return ((JARVIS_UNIT, BOT_DROPIN_DIR, "msb-bot@%s.service" % ids[0] if ids else None),
            (LEGACY_BOT_FILE, LEGACY_BOT_DROPIN_DIR, LEGACY_BOT_UNIT))


def cc_rights_wanted():
    """The bot's user client, sudo, and a unit file of the bot (template or single) are here, the owner's switch is not,
    and Claude Code is not locked by a managed policy (CC_LOCK: our support agent's server keeps its Claude Code locked;
    the bot reads the same file)."""
    return not os.path.lexists(RIGHTS_OFF) and not os.path.lexists(CC_LOCK) and uid_of("client") is not None \
        and sudo_here() and (unit_file_here(JARVIS_UNIT) or unit_file_here(LEGACY_BOT_FILE))


def ensure_cc_sudoers(grant=True):
    """0.5.9: /etc/sudoers.d/jarvis-client holds exactly CC_SUDOERS_BODY while cc_rights_wanted(), and is gone otherwise.
    The same writing, checks, held host and grant=False as ensure_sudoers(). sudo reads it at every call: the owner's
    own shell is root at once; the bot and its agent from the bot's first start without the old sandbox (ensure_bot_dropin).
    "absent" | "same" | "written" | "removed" | "none" | "held"."""
    want = grant and cc_rights_wanted()
    if want and host_refusal():
        return "held"
    return sudoers_file(CC_SUDOERS_NAME, CC_SUDOERS_BODY, "client", CC_SUDOERS_TMP_RE, want)


def ensure_bot_dropin(grant=True):
    """0.5.9: the drop-in 90-jarvis-rights.conf of every bot unit whose file is here (template, single, both) holds
    exactly BOT_DROPIN (root 0644, one link) while the rights for client are wanted, and is gone otherwise (the switch,
    the lock, a failed setup, its unit file gone). Written through a temp file that does not end in .conf, renamed;
    one `daemon-reload` when something changed (or when systemd still needs one for a unit whose drop-in is in place):
    never a restart, the bot gets it at its next ordinary start. A held host never gets it nor has it put back; there it
    is only removed. Each directory on its own: one that fails never stops the other (its error is raised after).
    "held" | "same" | "reloaded" | "none" (nothing of ours anywhere, nothing wanted) | "<unit file>=written|removed,…"."""
    want = grant and cc_rights_wanted()
    if want and host_refusal():
        return "held"
    done, asked, errors = [], [], []
    for unit_file, d, unit in bot_dropin_places():
        try:
            got = bot_dropin(d, want and unit_file_here(unit_file))
        except Exception as e:
            errors.append(e)
            continue
        if got in ("written", "removed"):
            done.append("%s=%s" % (os.path.basename(unit_file), got))
        elif got == "same" and unit:
            asked.append(unit)
    result = ",".join(done) or ("same" if asked else "none")
    if done:
        if not systemctl_ok("daemon-reload"):
            print("JARVIS_ENGINE_BOT_DROPIN_RELOAD", file=sys.stderr)
    elif any(systemctl_word("show", "-p", "NeedDaemonReload", u) == "NeedDaemonReload=yes" for u in asked):
        if not systemctl_ok("daemon-reload"):   # an earlier reload failed: the next start would take the old definition
            print("JARVIS_ENGINE_BOT_DROPIN_RELOAD", file=sys.stderr)
        result = "reloaded"
    if errors:
        raise errors[0]
    return result


def bot_dropin(d, want):
    """One drop-in directory of a bot unit: BOT_DROPIN_NAME holds exactly BOT_DROPIN (root 0644, one link) when `want`,
    is gone otherwise. The directory is made (0755) only when wanted; a link in its place or one others can write =
    Refused DIR. "same" | "written" | "removed" | "none"."""
    created = False
    if want:
        try:
            os.mkdir(d, 0o755)
            created = True
        except FileExistsError:
            pass
    try:
        dfd = os.open(d, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except FileNotFoundError:
        return "none"   # not wanted and no directory: nothing of ours there
    try:
        dst = os.fstat(dfd)
        if dst.st_uid != ROOT_UID or dst.st_mode & 0o022:
            raise Refused("DIR", "failed")
        if created:
            os.fchmod(dfd, 0o755)  # as systemd's own directories (the umask 077 of the helper made it 0700)
        for n in os.listdir(dfd):  # temp files of a run killed halfway
            if BOT_DROPIN_TMP_RE.fullmatch(n):
                unlink_quiet(dfd, n)
        try:
            st = os.stat(BOT_DROPIN_NAME, dir_fd=dfd, follow_symlinks=False)
        except FileNotFoundError:
            st = None
        if not want:
            if st is None:
                return "none"
            os.unlink(BOT_DROPIN_NAME, dir_fd=dfd)
            os.fsync(dfd)
            return "removed"
        if st is not None and stat.S_ISREG(st.st_mode) and st.st_uid == ROOT_UID and st.st_nlink == 1 and \
                stat.S_IMODE(st.st_mode) == 0o644 and st.st_size == len(BOT_DROPIN) and \
                read_owned(dfd, BOT_DROPIN_NAME, ROOT_UID, len(BOT_DROPIN)) == BOT_DROPIN:
            return "same"
        tmp = ".%s.tmp.%d" % (BOT_DROPIN_NAME[:-len(".conf")], os.getpid())
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o644, dir_fd=dfd)
        try:
            try:
                view = memoryview(BOT_DROPIN)
                while view:
                    view = view[os.write(fd, view):]
                os.fchmod(fd, 0o644)
                os.fsync(fd)
            finally:
                os.close(fd)
            os.rename(tmp, BOT_DROPIN_NAME, src_dir_fd=dfd, dst_dir_fd=dfd)  # a link there is replaced, not followed
        except BaseException:
            unlink_quiet(dfd, tmp)
            raise
        os.fsync(dfd)
        return "written"
    finally:
        os.close(dfd)


def cc_rights_granted():
    """For the state file: the rights of client are wanted, the host is not held, our sudoers file for client is there
    and so is the drop-in of every bot unit file here (the bot gets the rights at its next start, or has them already
    when its unit had no sandbox; whether sudo reads the file is said by the setup and tick lines, not here)."""
    if not cc_rights_wanted() or host_refusal():
        return False
    try:
        if not stat.S_ISREG(os.lstat(os.path.join(SUDOERS_DIR, CC_SUDOERS_NAME)).st_mode):
            return False
        return all(stat.S_ISREG(os.lstat(os.path.join(d, BOT_DROPIN_NAME)).st_mode)
                   for f, d, _ in bot_dropin_places() if unit_file_here(f))
    except OSError:
        return False


def this_helper_installed():
    """The helper file on disk is this version: a tick of an older code in memory never writes its units over a newer
    helper's (the updater holds the lock while it installs, this is the second wall)."""
    return helper_version_of(read_small(HELPER, 8 << 20)) == helper_version_of(
        ('HELPER_VERSION = "%s"' % HELPER_VERSION).encode())


def keep_helper_copy():
    """The copy the units' ExecStartPre put back when the helper is gone or empty: the installed helper's bytes, kept
    only while they are this version (setup at its end and every tick)."""
    if not this_helper_installed():
        return False
    data = read_small(HELPER, 8 << 20)
    if read_small(HELPER_GOOD, (8 << 20) + 1) == data:
        return False
    ensure_root_dir(LIB_DIR, 0o755)
    write_file(HELPER_GOOD, data, 0o755)
    return True


def keep_own_units():
    """The helper's units as its setup lays them out, the update path placed where absent (never replaced, as setup),
    every one of them enabled and running. A unit the agent disabled or removed is back within a tick.
    Returns the list of what was put back (file paths and units)."""
    back = []
    if not this_helper_installed():
        return back
    for unit in OWN_UNITS:
        if install_if_changed(unit, os.path.join(UNITS_DIR, unit), 0o644):
            back.append(unit)
    for src, dest, mode in STATIC_FILES:
        if not os.path.lexists(dest):
            write_file(dest, embedded_bytes(src), mode)
            back.append(os.path.basename(dest))
    if back:
        systemctl_ok("daemon-reload")
    units = list(OWN_ENABLE) + list(STATIC_ENABLE)
    deadline = time.monotonic() + UNITS_CHECK_WAIT
    words = zip(units, systemctl_words("is-enabled", units, deadline), systemctl_words("is-active", units, deadline))
    off = [u for u, e, a in words if e != "enabled" or a != "active"]
    if off:
        systemctl_ok("enable", "--now", *off)
        back += off
    return back


def keep_openclaw_guards():
    """An installed OpenClaw: the loopback guard (conf from the template, its unit file, enabled, running, the table
    loaded again from the file every tick: one atomic nft transaction, so a rule the agent removed or added in our
    table is gone), the drop-in of its user manager put back where removed and the limits of its slice kept by the
    server's RAM (0.5.9, keep_slice_limits). Nothing restarts: the user manager's drop-in counts from its next start, the
    limits are applied to the running slice.
    "none" | "ok" | "<what was done>,…"."""
    m = marker()
    uid = m.get("uid", "")
    if m.get("complete") != "1" or not re.fullmatch(r"[0-9]{1,10}", uid) or uid_of("openclaw") is None:
        return "none"
    done = []
    reload = False
    if this_helper_installed() and install_if_changed(NFT_UNIT, os.path.join(UNITS_DIR, NFT_UNIT), 0o644):
        done.append("unit")
        reload = True
    for path, name in zip(OC_DROPINS, ("openclaw-user-at.conf", "openclaw-slice-limits.conf")):
        dest = path.replace("{uid}", uid)
        if name == "openclaw-slice-limits.conf":
            got = keep_slice_limits(dest, uid)   # 0.5.9: by the server's RAM, applied live (its own reload)
            if got:
                done.append(got)
            continue
        if os.path.lexists(dest):
            continue
        data = embedded_bytes(name).decode("utf-8").replace("__OPENCLAW_UID__", uid)
        d = os.path.dirname(dest)
        if os.path.islink(d):
            continue
        os.makedirs(d, 0o755, exist_ok=True)
        write_file(dest, data.encode("utf-8"), 0o644)
        done.append(os.path.basename(d))
        reload = True
    if reload:
        systemctl_ok("daemon-reload")
    wrote = refresh_nft(create=True)
    if wrote:
        done.append("conf")
    if systemctl_word("is-enabled", NFT_UNIT) != "enabled":
        systemctl_ok("enable", NFT_UNIT)
        done.append("enabled")
    if systemctl_word("is-active", NFT_UNIT) != "active":
        done.append("started" if systemctl_ok("start", NFT_UNIT) else "start_failed")
    elif not wrote:
        try:
            r = run(["nft", "-f", NFT_CONF], timeout=30)
            if r.returncode != 0:
                done.append("load_failed")
        except OSError:
            done.append("no_nft")
    return ",".join(done) or "ok"


def slice_limits_conf(uid, high, mx):
    """The slice drop-in as openclaw-install.sh renders it, with these ceilings (MB)."""
    return embedded_bytes("openclaw-slice-limits.conf").decode("utf-8").replace("__OPENCLAW_UID__", uid).replace(
        "__MEMORY_HIGH__", "%dM" % high).replace("__MEMORY_MAX__", "%dM" % mx).encode("utf-8")


def unit_settings(data):
    """[(section, key, value)] of a unit file in order, comments and blank lines left out; None when it is no unit text."""
    try:
        text = data.decode("utf-8")
    except (UnicodeDecodeError, AttributeError):
        return None
    out, section = [], None
    for line in text.splitlines():
        s = line.strip()
        if not s or s[0] in "#;":
            continue
        if s.startswith("[") and s.endswith("]"):
            section = s
            continue
        k, eq, v = s.partition("=")
        if not eq:
            return None
        out.append((section, k.strip(), v.strip()))
    return out


def size_mb(v):
    """«1600M» / «2G» in MB; None for anything else (a percentage, infinity, bytes)."""
    m = re.fullmatch(r"([0-9]{1,7})([MG])", v or "")
    return int(m.group(1)) * (1024 if m.group(2) == "G" else 1) if m else None


def keep_slice_limits(dest, uid):
    """0.5.9: the ceilings of OpenClaw's slice by the server's RAM and the number of Jarvis bots (oc_limits). The file is
    the template with today's ceilings; a different one is written again, `daemon-reload`, and the running slice gets the
    same values at once (`set-property --runtime`: nothing restarts, the gateway runs on). Never lowered under a running
    OpenClaw: a file of ours (the template's settings, only the two ceilings differ) whose ceilings lie between today's
    and those of the same server without bots (a bot added after OpenClaw) stays; only comments differing = the same.
    "" = nothing done, "limits" = written and applied, "limits_failed" = written, systemd refused a step."""
    d = os.path.dirname(dest)
    if os.path.islink(d):
        return ""
    total = mem_total_mb()
    high, mx = oc_limits(total, len(bot_ids()))
    want = slice_limits_conf(uid, high, mx)
    cur = None
    try:
        if stat.S_ISREG(os.lstat(dest).st_mode):
            cur = read_small(dest, 64 << 10)
    except FileNotFoundError:
        pass
    if cur == want:
        return ""
    have, mine = (unit_settings(cur) if cur is not None else None), unit_settings(want)
    if have is not None:
        if have == mine:
            return ""
        ceil = ("MemoryHigh", "MemoryMax")
        rest = lambda s: [x for x in s if x[1] not in ceil]
        vals = [(k, size_mb(v)) for _, k, v in have if k in ceil]
        got = dict(vals)
        top_high, top_max = oc_limits(total, 0)
        if rest(have) == rest(mine) and len(vals) == 2 and None not in got.values() and set(got) == set(ceil) and \
                high <= got["MemoryHigh"] <= top_high and mx <= got["MemoryMax"] <= top_max:
            return ""
    os.makedirs(d, 0o755, exist_ok=True)
    write_file(dest, want, 0o644)
    ok = systemctl_ok("daemon-reload")
    ok = systemctl_ok("set-property", "--runtime", "user-%s.slice" % uid, "MemoryHigh=%dM" % high,
                      "MemoryMax=%dM" % mx) and ok
    return "limits" if ok else "limits_failed"


def keep_oc_limits():
    """keep_slice_limits for an OpenClaw installed to the end (setup: at once on a helper update, not a tick later)."""
    m = marker()
    uid = m.get("uid", "")
    if m.get("complete") != "1" or not re.fullmatch(r"[0-9]{1,10}", uid) or uid_of("openclaw") is None:
        return ""
    return keep_slice_limits(OC_DROPINS[1].replace("{uid}", uid), uid)


def keep_backup_units():
    """The nightly backup's unit, timer and script: the last copy seen as a regular root file is kept (KEEP_DIR, root
    0700); one that is gone (removed, not changed: our rollouts replace them, and the R2 switch and its way back own
    their own files, not kept here) is written back from it, systemd reloaded, and a timer that was enabled is enabled
    and started again. A disabled or stopped timer is left alone: a restore stops it on purpose. The env file with the
    keys and the R2 drop-in are never copied. Returns the paths put back."""
    ensure_root_dir(STATE_DIR, 0o700)
    ensure_root_dir(KEEP_DIR, 0o700)
    back = []
    for path in BACKUP_KEEP:
        copy = os.path.join(KEEP_DIR, os.path.basename(path))
        try:
            st = os.lstat(path)
        except FileNotFoundError:
            st = None
        if st is None:
            data = read_small(copy, KEEP_MAX + 1)
            if data and len(data) <= KEEP_MAX and os.path.isdir(os.path.dirname(path)):
                write_file(path, data, 0o755 if path.endswith(".sh") else 0o644)
                back.append(path)
            continue
        if stat.S_ISREG(st.st_mode) and st.st_uid == ROOT_UID and 0 < st.st_size <= KEEP_MAX:
            data = read_small(path, KEEP_MAX + 1)
            if data and data != read_small(copy, KEEP_MAX + 1):
                write_file(copy, data, 0o600)
    timer_file = [p for p in BACKUP_KEEP if p.endswith(BACKUP_TIMER)]
    raw = read_small(KEEP_RECORD, 4096)
    try:
        rec = json.loads(raw.decode()) if raw else {}
    except Exception:
        rec = {}
    rec = rec if isinstance(rec, dict) else {}
    if back:
        systemctl_ok("daemon-reload")
        if rec.get("timer_enabled") is True and any(p in back for p in timer_file + [BACKUP_KEEP[0]]):
            # a restore (constructor-restore-<run>) stops the timer and starts it itself at its end; Persistent=true
            # would run a backup at once and put a half-restored HOME into the archive: then (or when systemd cannot
            # say) the timer is only enabled
            if restore_running() is False:
                systemctl_ok("enable", "--now", BACKUP_TIMER)
            else:
                systemctl_ok("enable", BACKUP_TIMER)
    elif timer_file and os.path.isfile(timer_file[0]):
        enabled = systemctl_word("is-enabled", BACKUP_TIMER) == "enabled"
        if rec.get("timer_enabled") is not enabled:
            write_file(KEEP_RECORD, json.dumps({"timer_enabled": enabled}).encode(), 0o600)
    return back


def restore_running():
    """A restore runner (constructor-restore-*, src/fleet/restore-runner.ts) active now: True / False, None when systemd
    did not answer (the same question as backup-r2-switch.ts)."""
    try:
        r = run(["systemctl", "list-units", "constructor-restore-*", "--state=active,activating,deactivating",
                 "--no-legend", "--plain"], timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if r.returncode != 0:
        return None
    return bool(r.stdout.strip())


# ── Ж4: the rights line in our section of SOUL.md ───────────────────────────────────────────────────
def soul_rights(data, on):
    """SOUL.md with our rights line in our section «На этом сервере» exactly when `on`; None when that section is not
    there (the owner rewrote the file: left alone)."""
    line = SOUL_RIGHTS_LINE + b"\n"
    if (line in data) == bool(on):
        return data
    if not on:
        return data.replace(line, b"", 1)
    i = data.find(SOUL_SECTION)
    if i < 0:
        return None
    j = i + len(SOUL_SECTION)
    return data[:j] + line + data[j:]


def soul_plugins(data):
    """0.5.9: SOUL.md with our plugins line as the last item of our section «На этом сервере» (where the seed has it;
    first in the section when it starts with no list); the same bytes when the line is there; None when the section is
    not there (the owner rewrote the file: left alone)."""
    line = SOUL_PLUGINS_LINE + b"\n"
    if line in data:
        return data
    i = data.find(SOUL_SECTION)
    if i < 0:
        return None
    j = i + len(SOUL_SECTION)
    if not data.startswith(b"- ", j):
        return data[:j] + line + data[j:]
    k = data.find(b"\n\n", j)
    if k < 0:
        return data + (b"" if data.endswith(b"\n") else b"\n") + line
    return data[:k + 1] + line + data[k + 1:]


def plugins_soul(work):
    """The tick, once per installation (STATE_DIR/SOUL_PLUGINS_NAME): our plugins line into the SOUL.md of an OpenClaw
    installed before 0.5.9 (a new one has it from the seed). A SOUL.md without our section is the owner's: recorded,
    never edited; a line taken out later stays out. What is overwritten is copied first (configure.sh seed with a
    backup). Returns "written" when written, None otherwise."""
    m = marker()
    iid = m.get("installation_id", "")
    if m.get("complete") != "1" or unconfigured(m) or not UUID_RE.fullmatch(iid) or sandboxes_alive():
        return None
    rec_path = os.path.join(STATE_DIR, SOUL_PLUGINS_NAME)
    raw = read_small(rec_path, 512)
    try:
        rec = json.loads(raw.decode()) if raw else {}
    except Exception:
        rec = {}
    if isinstance(rec, dict) and rec.get("installation_id") == iid:
        return None
    have = workspace_files(("SOUL.md",))
    cur = have.get("SOUL.md") if have else None
    if not cur:
        return None   # no workspace or no plain SOUL.md of openclaw yet: tried again next tick
    new = soul_plugins(cur)
    if new is not None and new != cur:
        stage_dir = xfer_dir("seed")
        try:
            xfer_write(stage_dir, "SOUL.md", new)
            result, info = script(work, unpack(work), "openclaw-configure.sh",
                                  ["seed", stage_dir, "before-059-plugins-" + stamp().lower()], timeout=120)
            if result != "ok":
                raise script_refused("failed", info)
        finally:
            rmtree_private(stage_dir)
    ensure_root_dir(STATE_DIR, 0o700)
    write_file(rec_path, json.dumps({"installation_id": iid}).encode(), 0o600)
    return "written" if new is not None and new != cur else None


