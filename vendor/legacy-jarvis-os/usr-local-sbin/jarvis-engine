class MemoryCopy:
    """What import_jarvis_memory took and left: names relative to the workspace, never a byte of content."""
    def __init__(self, stage_dir, uid):
        self.stage, self.uid = stage_dir, uid
        self.copied, self.skipped, self.redacted_in = [], [], []
        self.bytes = 0
        self.cuts = 0
        self.deadline = time.monotonic() + IMPORT_MAX_SEC
        self.scanned = 0

    def skip(self, rel, why):
        self.skipped.append((rel, why))


def table_secret_cell(c):
    """A table cell that names a secret (a header or the name of a «name | value» row), not a statistic."""
    t = c.strip().strip("*_`").strip()
    return 0 < len(t) <= 40 and IMPORT_KW_RE.search(t) is not None and IMPORT_PLURAL_RE.search(t) is None


def table_sep(st):
    return "-" in st and re.fullmatch(r"\|?[\s:|-]+\|?", st) is not None


def scrub_tables(lines, n):
    """Markdown tables. A header (the row above «|---|») that names a secret column («| Сервис | Логин | Пароль |»):
    that column goes in every row below. Any other row: a cell naming a secret takes its right neighbour with it
    («| Пароль | qwerty |»). Header rows themselves stay (names only)."""
    cols = None
    out = []
    for i, line in enumerate(lines):
        st = line.strip()
        if not st.startswith("|"):
            cols = None
            out.append(line)
            continue
        if table_sep(st):
            out.append(line)
            continue
        cells = st.strip("|").split("|")
        nxt = lines[i + 1].strip() if i + 1 < len(lines) else ""
        if nxt.startswith("|") and table_sep(nxt):
            cols = {j for j, c in enumerate(cells) if table_secret_cell(c)}
            out.append(line)
            continue
        cut_at = set(cols or ())
        cut_at |= {j + 1 for j, c in enumerate(cells[:-1]) if table_secret_cell(c)}
        changed = False
        new = []
        for j, c in enumerate(cells):
            v = c.strip()
            if j in cut_at and v and v != IMPORT_CUT and v not in ("-", "—", "–") and not table_secret_cell(c):
                n[0] += 1
                changed = True
                new.append(" %s " % IMPORT_CUT)
            else:
                new.append(c)
        out.append(line[:len(line) - len(line.lstrip())] + "|" + "|".join(new) + "|" if changed else line)
    return out


def scrub_rest(line, n):
    """After a password-like word the rest of the line is the secret (see IMPORT_REST_RE)."""
    def cut(m):
        rest = m.group(2)
        if IMPORT_CUT in rest:
            return m.group(0)
        if m.group(1).lower() == "seed" and not IMPORT_SEED_WORDS_RE.match(rest.split(":", 1)[-1].split("=", 1)[-1]):
            return m.group(0)  # «Seed: 500k at 5M cap» is a funding round; a seed phrase is 8+ short words
        # up to 3 words, then «: » (a colon with a space: not 12:30) or «=»
        sep = IMPORT_REST_SEP_RE.match(rest)
        if sep and sep.group(2).strip():
            n[0] += 1
            return m.group(1) + sep.group(1) + IMPORT_CUT
        pw = IMPORT_PWLIKE_RE.search(rest)
        if pw:
            n[0] += 1
            return m.group(1) + rest[:pw.start()] + IMPORT_CUT
        return m.group(0)
    if line.lstrip().startswith("|"):
        return line  # tables: scrub_tables
    return IMPORT_REST_RE.sub(cut, line)


def looks_random(word):
    """A run of 32+ characters that looks like a key: upper, lower and a digit, entropy >= IMPORT_ENTROPY bits/char
    (hex hashes and UUIDs stay: no upper case or too little entropy)."""
    if not (re.search(r"[a-z]", word) and re.search(r"[A-Z]", word) and re.search(r"[0-9]", word)):
        return False
    counts = {}
    for ch in word:
        counts[ch] = counts.get(ch, 0) + 1
    n = float(len(word))
    return -sum(c / n * math.log2(c / n) for c in counts.values()) >= IMPORT_ENTROPY


def scrub_secrets(text):
    """(text without keys, tokens and passwords, how many places were cut). str in, str out. Linear in the text."""
    n = [0]

    def cut(m):
        n[0] += 1
        return IMPORT_CUT

    def cut_value(m):
        n[0] += 1
        return m.group(1) + m.group(2) + IMPORT_CUT

    def cut_url(m):
        n[0] += 1
        return m.group(1) + IMPORT_CUT + m.group(3)

    def cut_random(m):
        if not looks_random(m.group(0)):
            return m.group(0)
        n[0] += 1
        return IMPORT_CUT

    text = IMPORT_PEM_RE.sub(cut, text)
    lines = scrub_tables(text.split("\n"), n)
    lines = [scrub_rest(l, n) for l in lines]
    text = "\n".join(lines)
    text = IMPORT_ASSIGN_RE.sub(cut_value, text)
    text = IMPORT_URL_RE.sub(cut_url, text)
    text = IMPORT_SECRET_RE.sub(cut, text)
    # a line that names a secret: shorter random-looking runs go too
    text = "\n".join(IMPORT_SHORT_RE.sub(cut, l) if IMPORT_LINE_WORD_RE.search(l) else l for l in text.split("\n"))
    text = IMPORT_RANDOM_RE.sub(cut_random, text)
    return text, n[0]


def import_file(dfd, name, rel, st, acc):
    if not name.lower().endswith(IMPORT_EXTS):
        return acc.skip(rel, "не текст")
    if secret_name(name):
        return acc.skip(rel, "файл с секретами")
    if st.st_size > IMPORT_MAX_FILE:
        return acc.skip(rel, "больше 4 МБ")
    if len(acc.copied) >= IMPORT_MAX_FILES:
        return acc.skip(rel, "больше 5000 файлов")
    if acc.bytes + st.st_size > IMPORT_MAX_BYTES:
        return acc.skip(rel, "не влезло в 50 МБ")
    # time and everything read (taken or not) are bounded before a byte is read: the helper holds its lock meanwhile
    if time.monotonic() > acc.deadline or acc.scanned + st.st_size > 4 * IMPORT_MAX_BYTES:
        return acc.skip(rel, "не успел за минуту")
    data = read_owned(dfd, name, acc.uid, IMPORT_MAX_FILE)
    if data is None:
        return acc.skip(rel, "не прочитан")
    acc.scanned += len(data)
    try:
        if b"\0" in data:
            raise ValueError
        text = data.decode("utf-8")
    except ValueError:
        return acc.skip(rel, "не текст")
    if any(len(w) >= IMPORT_LONG_WORD for w in text.split()):
        return acc.skip(rel, "не текст")
    text, cuts = scrub_secrets(text)
    if IMPORT_SECRET_RE.search(text):
        return acc.skip(rel, "похоже на ключ")  # fail-closed: should never fire after scrub_secrets, kept on purpose
    clean = text.encode("utf-8")
    if acc.bytes + len(clean) > IMPORT_MAX_BYTES:
        return acc.skip(rel, "не влезло в 50 МБ")
    xfer_write(acc.stage, os.path.join(IMPORT_DIR, rel), clean)
    acc.copied.append(rel)
    acc.bytes += len(clean)
    if cuts:
        acc.cuts += cuts
        acc.redacted_in.append(rel)


def import_tree(dfd, rel, depth, acc):
    """One directory of the client's workspace, held open; entries are opened without following links. Hidden entries,
    links, devices and directories named like secret stores are never taken."""
    try:
        # newest first: daily notes are named by date, so a cap leaves out the oldest, not the latest
        names = sorted(os.listdir(dfd), reverse=True)
    except OSError:
        return
    for n in names:
        if n.startswith("."):
            continue
        r = os.path.join(rel, n)
        try:
            st = os.stat(n, dir_fd=dfd, follow_symlinks=False)
        except OSError:
            continue
        if stat.S_ISDIR(st.st_mode):
            if depth >= IMPORT_MAX_DEPTH or n.lower() in SECRET_DIRS:
                acc.skip(r + "/", "папка не копируется")
                continue
            try:
                sub = os.open(n, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=dfd)
            except OSError:
                continue
            try:
                import_tree(sub, r, depth + 1, acc)
            finally:
                os.close(sub)
        elif stat.S_ISREG(st.st_mode):
            import_file(dfd, n, r, st, acc)


IMPORT_FIRST = (("USER.md", "кто хозяин"), ("MEMORY.md", "главные факты, предпочтения и проекты"),
                ("SOUL.md", "характер и стиль Claude Code"), ("CLAUDE.md", "правила хозяина для агента"),
                ("PROJECTS.md", "проекты"), ("GOALS.md", "цели"), ("memory/", "заметки по дням, свежие в конце списка"),
                ("knowledge/", "база знаний по темам"))


def import_readme(acc):
    """from-jarvis/README.md (Russian): what this is, what to read first, what was cut or left behind."""
    have = set(acc.copied)
    first = [(n, why) for n, why in IMPORT_FIRST
             if n in have or (n.endswith("/") and any(c.startswith(n) for c in acc.copied))]
    out = ["# Память Claude Code", "",
           "Копия памяти и личности Claude Code, первого AI-агента хозяина (его бот на этом же сервере). Сделана %s "
           "при установке OpenClaw. Это только копия: у Claude Code всё осталось, правка здесь у него ничего не меняет."
           % time.strftime("%d.%m.%Y %H:%M UTC", time.gmtime(now())), ""]
    if first:
        out += ["## Что прочитать первым"] + ["%d. %s: %s" % (i + 1, n, why) for i, (n, why) in enumerate(first)] + [""]
    out += ["Ключи, токены и пароли по известным шаблонам и длинные случайные строки из копии вырезаны%s: там стоит «%s»."
            % ((" (%d мест: %s)" % (acc.cuts, ", ".join(acc.redacted_in[:10]))) if acc.cuts else "", IMPORT_CUT),
            "Если всё же увидишь здесь пароль или ключ, не пользуйся им и скажи хозяину.", ""]
    if acc.skipped:
        out += ["## Что не скопировано", "Эти файлы остались только у Claude Code:"]
        out += ["- %s: %s" % (rel, why) for rel, why in acc.skipped[:IMPORT_LIST]]
        if len(acc.skipped) > IMPORT_LIST:
            out.append("- и ещё %d" % (len(acc.skipped) - IMPORT_LIST))
        out.append("")
    # a file name that is not UTF-8 (os.listdir gives it with surrogates) must not fail the README
    return "\n".join(out).encode("utf-8", "replace")


def import_hint(acc):
    """Appended to OpenClaw's USER.md (it keeps at most ~4000 characters of it): short, Russian, where to look first."""
    return hint_bytes(bool(acc.skipped))


def hint_bytes(skipped):
    lines = ["", "## Память Claude Code",
             "В папке from-jarvis/ лежит копия памяти Claude Code, первого AI-агента хозяина (его бот на этом же "
             "сервере): кто хозяин, его проекты, правила и заметки. Когда нужен контекст о хозяине или его делах, сначала "
             "прочитай from-jarvis/README.md: там порядок чтения. Это копия, у Claude Code всё осталось."]
    if skipped:
        lines.append("Скопировано не всё: что осталось у Claude Code, перечислено в from-jarvis/README.md.")
    return ("\n".join(lines) + "\n").encode("utf-8")


def import_jarvis_memory(work):
    """«🧠 Память ✓» (add-openclaw, import_memory): a copy of the Jarvis memory and personality in OpenClaw's
    workspace/from-jarvis/, written by openclaw itself (configure.sh seed), plus a short Russian hint at the end of
    OpenClaw's USER.md. Root reads /home/client/workspace only (O_NOFOLLOW from a held directory chain, files of client
    with one link), writes nothing there; ~/projects and ~/.claude are not opened. Text files only, at most 50 MB, keys
    and tokens cut out. Returns detail for the result (counts only, no names): result copied | none."""
    uid = uid_of("client")
    if uid is None:
        return {"result": "none"}
    try:
        wfd, _ = open_dir_chain(os.path.join(CLIENT_HOME, "workspace"))
    except OSError:
        return {"result": "none"}
    stage_dir = xfer_dir("import")
    try:
        acc = MemoryCopy(stage_dir, uid)
        try:
            for n in IMPORT_TOP:
                try:
                    st = os.stat(n, dir_fd=wfd, follow_symlinks=False)
                except OSError:
                    continue
                if stat.S_ISREG(st.st_mode):
                    import_file(wfd, n, n, st, acc)
            for d in IMPORT_DIRS:
                try:
                    sub = os.open(d, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=wfd)
                except OSError:
                    continue
                try:
                    import_tree(sub, d, 1, acc)
                finally:
                    os.close(sub)
        finally:
            os.close(wfd)
        if not acc.copied:
            return {"result": "none", "skipped": len(acc.skipped)}
        xfer_write(stage_dir, os.path.join(IMPORT_DIR, "README.md"), import_readme(acc))
        xfer_write(stage_dir, "USER.md", seed_bytes("USER.md").rstrip(b"\n") + b"\n" + import_hint(acc))
        result, info = script(work, unpack(work), "openclaw-configure.sh", ["seed", stage_dir], timeout=120)
        if result != "ok":
            raise script_refused("failed", info)
        return {"result": "copied", "files": len(acc.copied), "skipped": len(acc.skipped), "cut": acc.cuts,
                "mb": round(acc.bytes / (1 << 20), 1)}
    finally:
        rmtree_private(stage_dir)


