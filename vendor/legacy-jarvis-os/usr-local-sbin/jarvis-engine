    return {k: u.get(k) for k in ("at", "result", "code", "version", "updater_version")
            if isinstance(u.get(k), str) and re.fullmatch(r"[0-9A-Za-z_.:+-]{1,40}", u.get(k))}


def compute_state(work=None, puller_check=None):
    lib = unpack(work) if work and EMBEDDED and os.path.lexists(OPENCLAW_MARKER) else None
    d = disk()
    j = jarvis_info()
    o = openclaw_info(work, lib)
    if puller_check is None:
        prev = read_state()
        puller_check = (prev.get("puller") or {}).get("check") if isinstance(prev.get("puller"), dict) else None
    refusal = host_refusal()
    return {"v": 1, "helper_version": HELPER_VERSION, "at": iso(), "managed": managed(), "hold": on_hold(),
            "host_ready": refusal is None, "actions": available_actions(j, o, d) if refusal is None else
            {s: ["status"] for s, _, _ in SOURCES},
            "codes": list(CODES), "jarvis": j, "openclaw": o, "way_back": way_back(o),
            "updates": {"auto": not os.path.lexists(UPDATES_OFF)}, "openclaw_update": public_update(oc_update_record()),
            "disk": {"free_gb": gb(d["free_bytes"]), "total_gb": gb(d["total_bytes"]),
                     "need_gb": gb(add_need_bytes(bool(o.get("installed") and o.get("incomplete")))),
                     "used_pct": round(100 * (1 - d["free_bytes"] / d["total_bytes"])) if d["total_bytes"] else None},
            "memory_mb": mem_total_mb(), "puller": puller_facts(puller_check), "base_pulse": pulse_facts(),
            "usage": usage_today(), "trash": trash_entries(), "openclaw_version_offered": OC_VERSION_VERIFIED,
            "update": updater_result(), "snapshot": snapshot_public(),
            "openclaw_defaults": public_defaults(oc_defaults_record()),
            # 0.5.8/0.5.9 (CONTRACT.md §2, §13, §15): root through sudo given by this helper (files in place, host ours);
            # the unit of an old bot gets it only at its next start, so the bot checks `sudo -n true` itself before it
            # tells its agent
            "rights": rights_public()}


def rights_public():
    """state.json `rights`: never at the cost of the state (an error = null for that engine)."""
    out = {}
    for k, f in (("openclaw", rights_granted), ("client", cc_rights_granted)):
        try:
            out[k] = bool(f())
        except Exception:
            out[k] = None
    return out


def read_state():
    raw = read_small(os.path.join(RUN_DIR, "state.json"), 1 << 20)
    try:
        st = json.loads(raw.decode()) if raw else {}
    except Exception:
        st = {}
    return st if isinstance(st, dict) else {}


def write_state(update):
    """Merge `update` into state.json (0644). Progress writes touch only last/results; the engines block is rebuilt by
    compute_state at the end of a request and by the tick."""
    ensure_root_dir(RUN_DIR, 0o755)
    st = read_state()
    st.update(update)
    write_file(os.path.join(RUN_DIR, "state.json"), (json.dumps(st, sort_keys=True) + "\n").encode(), 0o644)


def write_result(source, rid, action, result, code, phase=None, detail=None, bot_id=None):
    """The bot's view of its request (C1 `last`): no token, key, owner id or bot name ever goes here. Three places:
    `last` (any source), `results.<source>` (the last of that source) and `requests.<id>` (the last RESULTS_KEEP by
    request id: on a server with several Jarvis bots each finds its own result there, whoever asked after it)."""
    if code not in CODES:
        detail = dict(detail or {}, reason=code)
        code = "FAILED" if result == "failed" else "HOST_NOT_READY"
    body = {"id": rid, "source": source, "action": action, "result": result, "code": code, "at": iso()}
    if bot_id:
        body["bot_id"] = bot_id
    if phase:
        body["phase"] = phase
    if detail:
        body["detail"] = detail
    st = read_state()
    results = st.get("results") if isinstance(st.get("results"), dict) else {}
    results[source] = body
    update = {"last": body, "results": results}
    if rid:
        reqs = st.get("requests") if isinstance(st.get("requests"), dict) else {}
        reqs = {k: v for k, v in reqs.items() if isinstance(k, str) and isinstance(v, dict)}
        reqs[rid] = body
        # the oldest go first (a running request rewrites its `at` on every phase, so it never goes)
        for k in sorted(reqs, key=lambda k: (str(reqs[k].get("at", "")), k))[:max(0, len(reqs) - RESULTS_KEEP)]:
            del reqs[k]
        update["requests"] = reqs
    write_state(update)
    print("JARVIS_ENGINE result=%s code=%s action=%s source=%s" % (result, code, action or "none", source), file=sys.stderr)


# ── embedded scripts ─────────────────────────────────────────────────────────────────────────────
def unpack(work):
    if not EMBEDDED:
        raise Refused("NOT_BUILT", "failed")
    lib = os.path.join(work, "lib")
    if os.path.isdir(lib):
        return lib
    os.mkdir(lib, 0o700)
    for name, b64 in EMBEDDED.items():
        if name not in KIT_FILES:
            raise Refused("NOT_BUILT", "failed")
        if "/" in name:
            continue
        write_file(os.path.join(lib, name), base64.b64decode(b64), 0o600)
    return lib


MARK_RE = re.compile(r"^OPENCLAW_[A-Z]+_([A-Z0-9_]+)\s*$", re.M)


def script(work, lib, name, args, timeout=2400):
    """Run one embedded bash script → ("ok", {k: v} of its OK line) | ("refused"|"failed", code).
    Exit 2 = refused before any change; anything else non-zero = failed."""
    base = name.split(".")[0].upper().replace("-", "_")
    out_path, err_path = os.path.join(work, name + ".out"), os.path.join(work, name + ".err")
    with open(out_path, "wb") as out, open(err_path, "wb") as err:
        try:
            rc = run([BASH, os.path.join(lib, name)] + list(args), timeout=timeout,
                     env=child_env({"JE_LIB": lib, "JE_WORK": work}), stdout=out, stderr=err).returncode
        except subprocess.TimeoutExpired:
            stop_sandboxes()
            return "failed", "TIMEOUT_" + base
        except BaseException:
            stop_sandboxes()
            raise
    out_lines = [l for l in (read_small(out_path, 1 << 20) or b"").decode("utf-8", "replace").splitlines() if l.strip()]
    if rc == 0 and out_lines and re.match(r"^OPENCLAW_[A-Z]+_OK(\s|$)", out_lines[-1]):
        return "ok", dict(kv.split("=", 1) for kv in out_lines[-1].split()[1:] if "=" in kv)
    marks = MARK_RE.findall((read_small(err_path, 1 << 20) or b"").decode("utf-8", "replace"))
    code = marks[-1] if marks and CODE_RE.fullmatch(marks[-1]) else "SCRIPT_" + base
    return ("refused" if rc == 2 else "failed"), code


def script_refused(result, code):
    """A script's refusal or failure as a Refused with a code of the closed list (the precise one in detail.reason)."""
    if result == "refused":
        return Refused(SCRIPT_CODES.get(code, "HOST_NOT_READY"), "refused", {"reason": code})
    return Refused("FAILED", "failed", {"reason": code})


def openclaw_live(work, lib):
    """(gateway, plugin) from `openclaw-configure.sh state`: the gateway unit and the /server plugin in the config."""
    result, info = script(work, lib, "openclaw-configure.sh", ["state"], timeout=90)
    s = info.get("state") if result == "ok" else "failed"
    if s in ("activating", "deactivating"):
        s = "inactive"
    p = info.get("plugin") if result == "ok" else None
    return (s if s in GATEWAY_STATES else "failed"), (p if p in PLUGIN_STATES else "unknown")


def embedded_bytes(name):
    if name not in EMBEDDED:
        raise Refused("NOT_BUILT", "failed")
    return base64.b64decode(EMBEDDED[name])


def install_if_changed(src_name, dest, mode):
    data = embedded_bytes(src_name)
    if os.path.isfile(dest) and not os.path.islink(dest) and read_small(dest, 8 << 20) == data:
        return False
    write_file(dest, data, mode)
    return True


def as_user(user, argv, input=None, timeout=60):
    home = CLIENT_HOME if user == "client" else OC_HOME
    return run(["runuser", "-u", user, "--", "/usr/bin/env", "-i", "HOME=" + home, "PATH=" + CLIENT_PATH,
                "LANG=C.UTF-8"] + argv, timeout=timeout, input=input)


def client_py(code, args, input=None, timeout=600):
    """A short embedded python program run AS client (its own files edited by itself, never by root). The program is
    an argument (not secret); a secret, when there is one, comes on stdin."""
    r = as_user("client", ["python3", "-I", "-S", "-c", code] + [str(a) for a in args], input=input, timeout=timeout)
    if r.returncode != 0:
        tail = r.stderr.decode("utf-8", "replace").strip().splitlines()[-1:] if r.stderr else []
        m = re.search(r"JE_([A-Z0-9_]{1,40})", tail[0]) if tail else None
        raise Refused("FAILED", "failed", {"reason": m.group(1) if m else "CLIENT_STEP"})
    try:
        out = json.loads(r.stdout.decode("utf-8") or "{}")
    except Exception:
        out = {}
    return out if isinstance(out, dict) else {}


