# The scheduler's jobs (0.5.6): in 2026.9.x they live in state/openclaw.sqlite together with secrets (MCP OAuth), which
# the snapshot never copies. OpenClaw's CLI lists them (`openclaw automations list --all --json`, openclaw-configure.sh
# cronexport: docs/automation/cron-jobs/managing-jobs.md «Use the CLI or Gateway API to change jobs»); of each job only
# what `automations add` needs to make it again goes into the tar as cron-jobs.json (CRON_JOB_KEEP, an allowlist like
# the config's), system jobs (heartbeat monitors: OpenClaw makes them from the config; jobs with a `declarationKey`:
# declared by OpenClaw itself, such as the weekly Skill Workshop review, docs/automation/cron-jobs/payloads.md:25, and
# converged again on their own: restored by hand they would double) stay out, and a job in which anything key-like is
# left (secret_content) stays out whole. Never a reason for the snapshot to fail.
CRON_EXPORT_NAME = "cron-jobs.json"
CRON_EXPORT_SEC = 45       # the CLI call at most (a Node start and one call to the gateway)
CRON_EXPORT_RESERVE = 60   # left of the snapshot's SNAPSHOT_SEC for the tar itself, or no export
CRON_RAW_MAX = 4 << 20
CRON_JOBS_MAX = 500
CRON_SYSTEM_KINDS = ("heartbeat",)


def _cron_int(v):
    return v if isinstance(v, int) and not isinstance(v, bool) and 0 <= v < 10 ** 15 else _CFG_DROP


def _cron_text(v):
    """A prompt: several lines, up to 16 KB, nothing key-like in it."""
    ok = isinstance(v, str) and 0 < len(v) <= 16384 and "\x00" not in v and not config_secret_value(v)
    return v if ok else _CFG_DROP


CRON_JOB_KEEP = {
    "id": _cfg_re(CFG_ID_RE), "name": _cfg_text, "description": _cfg_text, "enabled": _cfg_bool,
    "agentId": _cfg_re(CFG_ID_RE), "sessionTarget": _cfg_text, "wakeMode": _cfg_re(CFG_WORD_RE),
    "deleteAfterRun": _cfg_bool,
    "schedule": {"kind": _cfg_re(CFG_WORD_RE), "at": _cfg_text, "everyMs": _cron_int, "every": _cfg_text,
                 "expr": _cfg_text, "cron": _cfg_text, "tz": _cfg_text, "timezone": _cfg_text,
                 "staggerMs": _cron_int, "exact": _cfg_bool},
    "payload": {"kind": _cfg_re(CFG_WORD_RE), "message": _cron_text, "text": _cron_text, "model": _cfg_model_id,
                "thinking": _cfg_re(CFG_WORD_RE), "timeoutSeconds": _cron_int, "fallbacks": [_cfg_model_id]},
    "delivery": {"mode": _cfg_re(CFG_WORD_RE), "channel": _cfg_re(CFG_WORD_RE), "to": _cfg_id, "accountId": _cfg_id,
                 "threadId": _cfg_id, "bestEffort": _cfg_bool},
    "pacing": {"min": _cfg_text, "max": _cfg_text},
}


def cron_secret_left(text):
    """Anything key-like in a picked job (the shapes of the memory copy and of the history copy)."""
    return IMPORT_SECRET_RE.search(text) is not None or SECRET_BYTES_RE.search(text.encode("utf-8")) is not None


def pick_cron(raw):
    """(cron-jobs.json bytes, jobs taken, {why: count} left out) of what `automations list --all --json` printed (a list
    of jobs, or {"jobs": [...]}). Per job: only CRON_JOB_KEEP, plus `left_out` = the names of fields not taken (a command
    payload's argv and env, webhooks, a trigger script, run state: names only)."""
    doc = json.loads(raw.decode("utf-8"))
    rows = doc.get("jobs") if isinstance(doc, dict) else doc
    if not isinstance(rows, list):
        raise ValueError("NOT_A_LIST")
    jobs, skipped = [], {}
    def skip(why, n=1):
        skipped[why] = skipped.get(why, 0) + n
    for row in rows[:CRON_JOBS_MAX]:
        payload = row.get("payload") if isinstance(row, dict) else None
        if not isinstance(row, dict):
            skip("not_a_job")
            continue
        if isinstance(payload, dict) and payload.get("kind") in CRON_SYSTEM_KINDS:
            skip("system")
            continue
        if isinstance(row.get("declarationKey"), str) and row["declarationKey"].strip():
            skip("declared")  # OpenClaw's own declared job: it makes it again itself
            continue
        job = config_pick(row, CRON_JOB_KEEP)
        if not isinstance(job, dict) or not job.get("schedule"):
            skip("unreadable")
            continue
        left = [k for k in row if isinstance(k, str) and k not in job]
        for part in ("schedule", "payload", "delivery", "pacing"):
            if isinstance(row.get(part), dict) and isinstance(job.get(part), dict):
                left += ["%s.%s" % (part, k) for k in row[part] if isinstance(k, str) and k not in job[part]]
        left = sorted(x for x in left if SNAP_NAME_RE.fullmatch(x))[:32]
        if left:
            job["left_out"] = left
        if cron_secret_left(json.dumps(job, ensure_ascii=False)):
            skip("secret")  # fail-closed: should never fire after the allowlist, kept on purpose
            continue
        jobs.append(job)
    if len(rows) > CRON_JOBS_MAX:
        skip("over_limit", len(rows) - CRON_JOBS_MAX)
    out = {"schema": 1, "source": "openclaw automations list --all --json", "jobs": jobs, "skipped": skipped}
    return (json.dumps(out, indent=2, ensure_ascii=False) + "\n").encode("utf-8"), len(jobs), skipped


def cron_export(deadline):
    """(bytes | None, word, jobs) for the snapshot: ok | none (no job) | off (OpenClaw switched off, an unbuilt helper) |
    no_time | unavailable (the CLI or the gateway did not answer, not JSON). Never raises."""
    if not EMBEDDED or os.path.lexists(OC_OFF):
        return None, "off", 0
    left = deadline - time.monotonic() - CRON_EXPORT_RESERVE
    if left < 10:
        return None, "no_time", 0
    work = None
    try:
        work = work_dir("task")
        lib = unpack(work)
        # its one line of output through a pipe (the list itself lands in the work dir)
        try:
            r = run([BASH, os.path.join(lib, "openclaw-configure.sh"), "cronexport"], timeout=int(min(CRON_EXPORT_SEC, left)),
                    env=child_env({"JE_LIB": lib, "JE_WORK": work}))
        except subprocess.TimeoutExpired:
            stop_sandboxes()
            return None, "unavailable", 0
        said = [l.strip() for l in r.stdout.decode("utf-8", "replace").splitlines() if l.strip()]
        if r.returncode != 0 or not said or said[-1] != "OPENCLAW_CRONEXPORT_OK":
            return None, "unavailable", 0
        raw = read_small(os.path.join(work, "cron.raw"), CRON_RAW_MAX + 1)
        if raw is None or len(raw) > CRON_RAW_MAX:
            return None, "unavailable", 0
        data, jobs, _ = pick_cron(raw)
        return data, ("ok" if jobs else "none"), jobs
    except Exception:  # noqa: BLE001 the jobs are a part of the snapshot, never its failure
        return None, "unavailable", 0
    finally:
        if work:
            rmtree_private(work)


def build_snapshot(afd, deadline, at, machine, m, cron=(None, "off", 0)):
    """The tar into a root 0600 temp file next to the target. Returns (temp name, {token, provider, model_id, why}).
    Any failure: the temp file goes. `cron` = cron_export(): the scheduler's jobs as cron-jobs.json (0.5.6)."""
    oc_uid = uid_of("openclaw")
    if oc_uid is None:
        raise Refused("NO_OPENCLAW_USER")
    tmp = ".%s.tmp.%d" % (SNAPSHOT_TAR, os.getpid())
    rmtree_at(afd, tmp)
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600, dir_fd=afd)
    done = False
    try:
        os.fchown(fd, ROOT_UID, ROOT_GID)
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "wb") as f:
            fd = None
            c = SnapTar(deadline, oc_uid, afd, f)
            man = {"schema": 1, "at": at, "machine": machine, "helper_version": HELPER_VERSION,
                   "openclaw_version": m.get("version") if OC_VERSION_RE.fullmatch(m.get("version", "")) else None,
                   "secrets_excluded": True, "included": [], "config": "absent"}
            facts = snapshot_openclaw(c, man)
            data, word, jobs = cron
            if data is not None and len(data) > c.left():
                data, word = None, "too_big"
            if data is not None:
                c.add(CRON_EXPORT_NAME, data, now())
            man.update({"cron_export": word, "cron_jobs": jobs if data is not None else 0})
            facts["why"] = [w for w in SNAP_WHY if w in c.why]
            man.update(c.lists)
            man.update({"bot_token_included": facts["token"], "partial": bool(facts["why"]), "partial_why": facts["why"],
                        "files": c.files, "skipped": dict(sorted(c.skipped.items())), "cuts": c.cuts})
            c.add("manifest.json", (json.dumps(man, indent=2, sort_keys=True) + "\n").encode("utf-8", "replace"), now())
            c.add("README.md", (SNAPSHOT_README % {"at": at, "helper": HELPER_VERSION, "machine": machine,
                                                   "version": man["openclaw_version"] or "?"}).encode("utf-8"), now())
            f.write(b"\0" * 1024)  # the end of the archive: two zero blocks
            f.flush()
            os.fsync(f.fileno())
            if f.tell() > SNAPSHOT_MAX_BYTES:
                raise Refused("TOO_BIG")
        done = True
        return tmp, facts
    finally:
        if fd is not None:
            os.close(fd)
        if not done:
            unlink_quiet(afd, tmp)


def commit_snapshot(afd, uid, gid, tar_tmp, doc, prev_raw, foreign):
    """The only place that replaces anything. engines.json prepared in its own temp file; then (a foreign snapshot moved
    aside first) engines.json renamed, then the tar. A failed step undoes the earlier ones: any refusal leaves the
    previous snapshot and engines.json as they were. No deadline here: once the main part is in, the run is never a
    TIMEOUT (the rest stopped SNAPSHOT_REST_MARGIN before the deadline to leave the time for this)."""
    eng_tmp = ".%s.tmp.%d" % (ENGINES_NAME, os.getpid())
    write_temp_at(afd, eng_tmp, (json.dumps(doc, indent=2) + "\n").encode(), uid, gid)
    undo = []
    try:
        rename = lambda a, b: os.rename(a, b, src_dir_fd=afd, dst_dir_fd=afd)
        if foreign:
            # another machine's snapshot is never replaced: it moves aside (a newer one of the same machine replaces
            # its older aside copy) and waits for an explicit restore or discard
            aside_tar, aside_eng = "openclaw-snapshot.%s.tar" % foreign, "engines.%s.json" % foreign
            if entry_kind(afd, SNAPSHOT_TAR) is not None:
                rename(SNAPSHOT_TAR, aside_tar)
                undo.append(lambda: rename(aside_tar, SNAPSHOT_TAR))
            if entry_kind(afd, ENGINES_NAME) is not None:
                rename(ENGINES_NAME, aside_eng)
                undo.append(lambda: rename(aside_eng, ENGINES_NAME))
        had = entry_kind(afd, ENGINES_NAME) is not None
        rename(eng_tmp, ENGINES_NAME)
        if had and prev_raw is not None:
            undo.append(lambda: (write_temp_at(afd, eng_tmp, prev_raw, uid, gid), rename(eng_tmp, ENGINES_NAME)))
        else:
            undo.append(lambda: unlink_quiet(afd, ENGINES_NAME))
        if tar_tmp:
            rename(tar_tmp, SNAPSHOT_TAR)  # atomic over the previous one
    except BaseException:
        for u in reversed(undo):
            try:
                u()
            except Exception:
                print("JARVIS_ENGINE_SNAPSHOT_UNDO", file=sys.stderr)
        unlink_quiet(afd, eng_tmp)
        raise
    try:  # replaced: from here on nothing is a failure of the run
        os.fsync(afd)
        if foreign:
            prune_foreign(afd)
    except Exception as e:
        print("JARVIS_ENGINE_SNAPSHOT_AFTER_%s" % type(e).__name__.upper()[:40], file=sys.stderr)


def prune_foreign(afd):
    """At most SNAPSHOT_KEEP_FOREIGN machines' snapshots aside: the oldest goes only when a third one arrived. Age = the
    time of its tar (written on that machine; a tar keeps it through a backup and a restore), else of its engines file."""
    seen = {}
    for name in os.listdir(afd):
        mm = SNAP_FOREIGN_RE.fullmatch(name)
        if mm:
            try:
                t = os.stat(name, dir_fd=afd, follow_symlinks=False).st_mtime
            except OSError:
                continue
            key, is_tar = mm.group(1) or mm.group(2), bool(mm.group(1))
            if is_tar or key not in seen or not seen[key][0]:
                seen[key] = (is_tar, t)
    seen = {k: v[1] for k, v in seen.items()}
    for key in sorted(seen, key=lambda k: (seen[k], k))[:max(0, len(seen) - SNAPSHOT_KEEP_FOREIGN)]:
        for name in ("openclaw-snapshot.%s.tar" % key, "engines.%s.json" % key):
            unlink_quiet(afd, name)
        print("JARVIS_ENGINE_SNAPSHOT_FOREIGN_DROPPED %s" % key, file=sys.stderr)


def settle_snapshot_dir(afd):
    """Under the lock: temp files a run killed halfway left (a temp tar holds the bot token) go."""
    for name in sorted(os.listdir(afd)):
        if SNAP_TMP_RE.fullmatch(name):
            rmtree_at(afd, name)


def state_fresh(st):
    try:
        age = now() - calendar.timegm(time.strptime(st.get("at") or "", "%Y-%m-%dT%H:%M:%SZ"))
    except (TypeError, ValueError):
        return False
    return -60 <= age <= PULSE_OC_FRESH


def bot_state(b):
    if b.get("removed"):
        return "removed"
    if not b.get("enabled"):
        return "off"
    if b.get("sleeping"):
        return "asleep"
    return "active" if b.get("working") else "down"


def engines_doc(at, machine, st, m, snap):
    """engines.json schema 1. From the helper's own knowledge: state.json as the last request or tick wrote it (the bots,
    the gateway; no systemd read here) and the root OpenClaw marker. No secret, no name, no owner id. bot_username: the
    helper never learns the OpenClaw bot's name (null)."""
    j = st.get("jarvis") if isinstance(st.get("jarvis"), dict) else {}
    o = st.get("openclaw") if isinstance(st.get("openclaw"), dict) else {}
    bots = [{"id": b["id"], "state": bot_state(b)} for b in (j.get("bots") if isinstance(j.get("bots"), list) else [])
            if isinstance(b, dict) and isinstance(b.get("id"), str) and BOT_ID_RE.fullmatch(b["id"])][:MAX_BOTS]
    installed = m.get("complete") == "1"
    if not m:
        oc_state = "absent"
    elif not installed or unconfigured(m):
        oc_state = "incomplete"
    elif os.path.lexists(OC_OFF):
        oc_state = "off"
    else:
        g = o.get("gateway")
        oc_state = g if state_fresh(st) and g in GATEWAY_STATES else "unknown"
    answering = "jarvis" if any(b["state"] == "active" for b in bots) else \
        ("openclaw" if installed and oc_state == "active" and oc_answers(st) else None)
    v = m.get("version", "")
    return {"schema": 1, "at": at, "machine": machine, "answering": answering, "jarvis": {"bots": bots},
            "openclaw": {"installed": installed, "version": v if OC_VERSION_RE.fullmatch(v) else None, "state": oc_state,
                         "bot_username": None, "provider": snap.get("provider"), "model_id": snap.get("model_id"),
                         "snapshot_at": snap.get("at"), "snapshot_ok": bool(snap.get("ok")), "secrets_excluded": True,
                         "bot_token_included": bool(snap.get("token"))}}


def snapshot_core(deadline):
    """One snapshot, the helper's lock held. (at, machine, snapshot_at, why partial) or Refused."""
    if on_hold() or os.path.lexists(STAGED_HOLD):
        raise Refused("HOST_HOLD")
    machine = machine_hash()
    uid, gid = uid_of("client"), gid_of("client")
    if uid is None or gid is None:
        raise Refused("NO_CLIENT")
    afd = open_archive_dir(uid, gid)
    try:
        prev, prev_raw = read_engines(afd)
        m = marker()
        installed = m.get("complete") == "1"
        pm = prev.get("machine") if prev else None
        foreign = pm if isinstance(pm, str) and re.fullmatch(r"[0-9a-f]{16}", pm) and pm != machine else None
        if foreign and not installed:
            raise Refused("PENDING_RESTORE")  # a moved server's only copy waits for its restore: nothing written
        settle_snapshot_dir(afd)
        at = iso()
        tar_tmp = None
        try:
            if installed:
                tar_tmp, facts = build_snapshot(afd, deadline, at, machine, m, cron_export(deadline))
                snap = dict(facts, ok=True, at=at)
            else:
                snap = {"ok": False}
                po = prev.get("openclaw") if prev and pm == machine and isinstance(prev.get("openclaw"), dict) else {}
                if entry_kind(afd, SNAPSHOT_TAR) == stat.S_IFREG and isinstance(po.get("snapshot_at"), str) and \
                        ISO_RE.fullmatch(po["snapshot_at"]):
                    # OpenClaw gone (removed by the owner): the earlier snapshot stays, engines.json still names it
                    snap.update(at=po["snapshot_at"], token=po.get("bot_token_included") is True)
            commit_snapshot(afd, uid, gid, tar_tmp, engines_doc(at, machine, read_state(), m, snap), prev_raw, foreign)
            tar_tmp = None
        finally:
            if tar_tmp:
                unlink_quiet(afd, tar_tmp)
        return at, machine, snap.get("at"), snap.get("why") or []
    finally:
        os.close(afd)


def take_snapshot(deadline):
    """The lock held. (at, machine) or Refused; the outcome recorded for state.json and the pulse, except under a hold
    marker (there nothing at all is written)."""
    try:
        at, machine, snap_at, why = snapshot_core(deadline)
    except Refused as e:
        if e.code in ("HOST_HOLD", "NOT_MANAGED"):
            raise
        save_snapshot_record("skipped:" + SNAPSHOT_SKIPS.get(e.code, "error"), prev_snapshot_at())
        publish_snapshot()
        raise
    except Exception as e:
        save_snapshot_record("skipped:error", prev_snapshot_at())
        publish_snapshot()
        print("JARVIS_ENGINE_SNAPSHOT_REASON INTERNAL_%s" % type(e).__name__.upper()[:40], file=sys.stderr)
        raise Refused("ERROR", "failed")
    save_snapshot_record("partial" if why else "ok", snap_at, why)
    publish_snapshot()
    if why:
        print("JARVIS_ENGINE_SNAPSHOT_PARTIAL why=%s" % ",".join(why), file=sys.stderr)
    return at, machine


def publish_snapshot():
    try:
        write_state({"snapshot": snapshot_public()})
    except Exception:
        pass


def backup_running():
    """A backup is running: its lock (BACKUP_LOCK, flock by backup-r2.sh / backup.sh) is held, or msb-backup.service is
    starting or running (its ExecStartPre snapshot, the tar). Only a probe: a shared lock taken and dropped at once
    (backup.sh does `flock -n`: a lock held here would make the night's backup skip)."""
    try:
        fd = os.open(BACKUP_LOCK, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_NOCTTY | os.O_CLOEXEC)
    except FileNotFoundError:
        fd = None
    except OSError:
        return True  # cannot tell: fail-closed (the night's snapshot comes anyway)
    if fd is not None:
        try:
            fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
        except OSError:
            return True
        finally:
            os.close(fd)  # the shared lock goes with the descriptor
    if not any(os.path.lexists(os.path.join(d, BACKUP_UNIT)) for d in BACKUP_UNIT_DIRS):
        return False
    return systemctl_word("is-active", BACKUP_UNIT) in ("active", "activating", "deactivating", "reloading")


def snapshot_after(action):
    """An event snapshot (SNAPSHOT_EVENTS), the request's lock held: best effort, never raises, never fails the action.
    While a backup runs it is skipped (the tar of /home/client is being read): the night's snapshot comes next."""
    try:
        if backup_running():
            print("JARVIS_ENGINE_SNAPSHOT_SKIPPED_BACKUP event=%s" % action, file=sys.stderr)
            return
        at, machine = take_snapshot(time.monotonic() + SNAPSHOT_SEC)
        print("JARVIS_ENGINE_SNAPSHOT_OK at=%s machine=%s event=%s" % (at, machine, action), file=sys.stderr)
    except Refused as e:
        print("JARVIS_ENGINE_SNAPSHOT_%s event=%s" % (e.code, action), file=sys.stderr)
    except Exception as e:
        print("JARVIS_ENGINE_SNAPSHOT_INTERNAL_%s event=%s" % (type(e).__name__.upper()[:40], action), file=sys.stderr)


def cmd_snapshot(args):
    """`jarvis-engine snapshot` (msb-backup.service ExecStartPre, root): JARVIS_ENGINE_SNAPSHOT_OK at=… machine=… and
    exit 0 (a partial one: also JARVIS_ENGINE_SNAPSHOT_PARTIAL on stderr), or exit 1 with JARVIS_ENGINE_SNAPSHOT_<CODE>
    (HOST_HOLD, NOT_MANAGED, PENDING_RESTORE, TIMEOUT, TOO_BIG, …)."""
    need_root()
    deadline = time.monotonic() + SNAPSHOT_SEC
    refusal = host_refusal()
    if refusal or os.path.lexists(STAGED_HOLD):
        raise Refused(refusal if refusal == "NOT_MANAGED" else "HOST_HOLD")  # before anything is written, the lock too
    lock = locked(wait=False)
    while lock is None and time.monotonic() < deadline:
        time.sleep(1)  # a request or a tick round holds the helper: wait within the deadline
        lock = locked(wait=False)
    if lock is None:
        save_snapshot_record("skipped:timeout", prev_snapshot_at())
        raise Refused("TIMEOUT")  # state.json is not ours to write without the lock: the next tick shows the record
    try:
        at, machine = take_snapshot(deadline)
    finally:
        os.close(lock)
    print("JARVIS_ENGINE_SNAPSHOT_OK at=%s machine=%s" % (at, machine))
    return 0


def guard_snapshot_files():
    """Tick: every snapshot tar in ~/.msb/archive back to root 0600 (a restore gives the whole HOME to client:
    restore-runner `chown -R client`). Each opened O_NOFOLLOW in the held archive directory, fstat, fchown and fchmod
    by its descriptor, never by path. Not a regular file or more than one link = not touched, the word is `bad`.
    "ok" | "bad" | None (no tar)."""
    uid, gid = uid_of("client"), gid_of("client")
    if uid is None or gid is None:
        return None
    try:
        afd = open_archive_dir(uid, gid, create=False)
    except Refused:
        return "bad"
    if afd is None:
        return None
    word = None
    try:
        for name in sorted(os.listdir(afd)):
            if not SNAP_TAR_RE.fullmatch(name):
                continue
            try:
                fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_NOCTTY | os.O_CLOEXEC, dir_fd=afd)
            except OSError:
                word = "bad"  # a link (never followed) or not openable
                continue
            try:
                st = os.fstat(fd)
                if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
                    word = "bad"
                    continue
                if (st.st_uid, st.st_gid, stat.S_IMODE(st.st_mode)) != (ROOT_UID, ROOT_GID, 0o600):
                    os.fchown(fd, ROOT_UID, ROOT_GID)
                    os.fchmod(fd, 0o600)
                    print("JARVIS_ENGINE_SNAPSHOT_FILE_FIXED %s" % name, file=sys.stderr)
                word = word or "ok"
            finally:
                os.close(fd)
    finally:
        os.close(afd)
    return word


def note_snapshot_file(word):
    """The guard's word for state.json and the pulse (SNAPSHOT_FILE_STATE), written only when it changed."""
    have = read_small(SNAPSHOT_FILE_STATE, 16)
    if word is None:
        if have is not None:
            try:
                os.unlink(SNAPSHOT_FILE_STATE)
            except OSError:
                pass
        return
    if have != word.encode():
        ensure_root_dir(STATE_DIR, 0o700)
        write_file(SNAPSHOT_FILE_STATE, word.encode(), 0o600)


# ── base pulse (NOT root) ────────────────────────────────────────────────────────────────────────
PULSE_REPORT_EVERY = 6 * 3600


def http_post(url, key, body):
    """POST JSON with the box key in a header (never in argv). Returns the HTTP status or None."""
    import urllib.request
    req = urllib.request.Request(url, data=json.dumps(body).encode(), method="POST",
                                 headers={"Content-Type": "application/json", "Authorization": "Bearer " + key})
    try:
        with urllib.request.urlopen(req, timeout=15) as r:
            return r.status
    except Exception as e:
        return getattr(e, "code", None)


# `systemctl is-enabled` words of a bot unit switched off on purpose: masked by us (remove-jarvis, an older «off», C4)
# or disabled (a hand; a bots/<id> directory whose unit was never enabled). Every other word of an existing unit
# (enabled, enabled-runtime, static, indirect, linked, alias, generated, transient, bad, a future one, "" = systemctl
# timed out) = the bot is meant to run: systemd starts it at boot and restarts it (Restart=always).
BOT_OFF_WORDS = ("masked", "masked-runtime", "disabled")


def bot_units():
    """The Jarvis bot units of this server: msb-bot@<id> for every ~/.msb/bots/<id> under the template, and the
    single-bot msb-bot.service of a server from before multibot (migrate-single-to-multibot.sh disables it)."""
    units = [bot_unit(b) for b in bot_ids()] if jarvis_present() else []
    return units + ([LEGACY_BOT_UNIT] if os.path.lexists(LEGACY_BOT_FILE) else [])


# Every systemctl read of one pulse together (msb-base-pulse.service TimeoutStartSec=60s: these, then the POST with
# its own 15 s, then the state file): one `is-active` for all bot units, one `is-enabled` for those not running.
PULSE_SYSTEMCTL_BUDGET = 20


def bots_liveness(deadline=None):
    """(enabled, active), read live by the pulse as client (is-active / is-enabled need no root; state.json is up to
    15 min old): `enabled` = bot units meant to run (running now, or not switched off on purpose: BOT_OFF_WORDS),
    `active` = running now. enabled > active = a broken bot: failed, in a crash loop, still activating after a reboot.
    Two systemctl calls for any number of bots under PULSE_SYSTEMCTL_BUDGET; a unit systemd did not answer for counts
    as meant to run and not running (the bot keeps liveness, the base pulse never covers what it could not see)."""
    if deadline is None:
        deadline = time.monotonic() + PULSE_SYSTEMCTL_BUDGET
    units = bot_units()
    up = [u for u, w in zip(units, systemctl_words("is-active", units, deadline)) if w == "active"]
    down = [u for u in units if u not in up]
    words = systemctl_words("is-enabled", down, deadline)
    return len(up) + sum((w.split() or [""])[0] not in BOT_OFF_WORDS for w in words), len(up)


def jarvis_beating(enabled):
    """The Jarvis bot owns liveness while ANY bot unit is meant to run, also while that bot is down: its own heartbeat
    (src/agent/heartbeat.ts) says «alive» every 5 minutes, and when it stops a live base layer must not hide the dead
    bot (fleet-count, the bot_crashed watchdog and the silent-bot detector read last_heartbeat_at). The base pulse says
    «alive» only without Jarvis (no bot unit, or every one masked or disabled) AND while OpenClaw answers (engine_alive).
    Sleep (disable-jarvis) keeps the bot
    running: it beats itself. Several bots, some down: a running one beats for the server, the base pulse never."""
    return enabled > 0


# OpenClaw counts for the server's liveness only as the root tick last SAW it: the tick (every 15 min, timer jitter 1 min,
# plus its own round) writes state.json with the gateway as openclaw's own systemd answers it (`openclaw-configure.sh
# state`, `systemctl --user is-active` as openclaw through systemd-run). The pulse runs as client: another user's
# systemd does not answer it, and that script is a root sandbox of seconds, not a 5-min client probe. So the tick's
# word, no older than one tick period with its jitter and round: older = the tick stopped or a long request (an
# install, an OpenClaw update) holds the helper, and nothing is claimed.
PULSE_OC_FRESH = 20 * 60


def oc_answers(st):
    """OpenClaw switched on, its setup finished (a half-done one has no Telegram channel), its gateway `active` (a failed
    gateway, one restarting in a loop = activating, a stopped one = not), all as the tick saw it at most PULSE_OC_FRESH
    ago. Pure but for the clock."""
    o = st.get("openclaw") if isinstance(st.get("openclaw"), dict) else {}
    try:
        age = now() - calendar.timegm(time.strptime(st.get("at") or "", "%Y-%m-%dT%H:%M:%SZ"))
    except (TypeError, ValueError):
        return False
    return -60 <= age <= PULSE_OC_FRESH and o.get("enabled") is True and o.get("gateway") == "active" and \
        o.get("incomplete") is False


# A request or a tick round holds the helper's lock and rebuilds state.json only at its end (an install up to 40 min, an
# OpenClaw update up to 70 min, the tick waits for nobody): past PULSE_OC_FRESH the pulse would lose OpenClaw right in
# the middle of its update, and the watchdog would call the server dead. So the lock holder records when it began,
# whether OpenClaw answered then, and WHO holds (its pid and the start time of that process, /proc/<pid>/stat field 22)
# in RUN_DIR/busy.json (root, 0644); the pulse trusts that answer while that very process lives, and at most
# PULSE_BUSY_MAX from the start (above the 70 min of the longest hold). A holder killed halfway leaves the file but no
# process: it counts for nothing, the next holder (the tick) rewrites it and removes it at its end; a reboot empties /run.
BUSY_NAME = "busy.json"
PULSE_BUSY_MAX = 75 * 60


def proc_start(pid):
    """Start time of a live process (/proc/<pid>/stat field 22, clock ticks since boot), None when there is none or it
    cannot be read (a /proc that hides other users' processes). The name (field 2) may hold spaces and parentheses: the
    fields are counted after its last «)»."""
    raw = read_small(os.path.join(PROC_DIR, str(pid), "stat"), 4096)
    try:
        return int(raw.decode("ascii", "replace").rsplit(")", 1)[1].split()[19])
    except Exception:
        return None


def mark_busy(op):
    """Root, the lock held: the start of a long hold. Never raises (a missing mark only shortens the pulse's trust)."""
    try:
        ensure_root_dir(RUN_DIR, 0o755)
        pid = os.getpid()
        write_file(os.path.join(RUN_DIR, BUSY_NAME),
                   json.dumps({"op": op, "at": now(), "oc_alive": oc_answers(read_state()), "pid": pid,
                               "start": proc_start(pid)}).encode(), 0o644)
    except OSError:
        pass


def clear_busy():
    try:
        os.unlink(os.path.join(RUN_DIR, BUSY_NAME))
    except OSError:
        pass


def busy_alive():
    """OpenClaw answered when the running hold began, at most PULSE_BUSY_MAX ago, and its holder still runs (the same
    pid with the same start time: a dead holder, or its pid reused by another process, vouches for nothing)."""
    raw = read_small(os.path.join(RUN_DIR, BUSY_NAME), 4096)
    try:
        b = json.loads(raw.decode()) if raw else None
    except Exception:
        b = None
    if not isinstance(b, dict) or b.get("oc_alive") is not True or type(b.get("at")) is not int:
        return False
    pid, start = b.get("pid"), b.get("start")
    if type(pid) is not int or pid <= 0 or type(start) is not int or proc_start(pid) != start:
        return False
    return -60 <= now() - b["at"] <= PULSE_BUSY_MAX


def engine_alive(st):
    """An engine without the Jarvis bot really answers: OpenClaw as the tick last saw it (oc_answers), or, while a request
    or a tick round holds the helper and nothing newer can be written, as it was when that hold began (busy_alive)."""
    return oc_answers(st) or busy_alive()


def pulse_body(st, liveness):
    """Technical facts only: engines, versions, the puller, disk, uptime, counts of the day. No conversation, no name.
    `liveness` = bots_liveness(): `jarvis_beating` (the bot owns the server's liveness) and the live counts behind it;
    `engine_alive` = OpenClaw answers (engine_alive). The server takes the base pulse as «alive» only when the bot does
    not own liveness AND an engine answers: no Jarvis and no working OpenClaw = the server is honestly dead."""
    enabled, active = liveness
    o = st.get("openclaw") if isinstance(st.get("openclaw"), dict) else {}
    j = st.get("jarvis") if isinstance(st.get("jarvis"), dict) else {}
    bots = j.get("bots") if isinstance(j.get("bots"), list) else []
    engines = {
        "jarvis": {"state": j.get("state"), "installed": j.get("installed"), "enabled": j.get("enabled"),
                   "bots": len(bots), "bots_active": sum(1 for b in bots if isinstance(b, dict) and b.get("active")),
                   "cc_cli_version": j.get("cc_cli_version")},
        "openclaw": {"installed": o.get("installed"), "enabled": o.get("enabled"), "gateway": o.get("gateway"),
                     "version": o.get("version")},
    }
    snap = st.get("snapshot") if isinstance(st.get("snapshot"), dict) else {}
    body = {"v": 1, "helper_version": HELPER_VERSION, "jarvis_beating": jarvis_beating(enabled),
            "engine_alive": engine_alive(st), "bots_enabled": enabled, "bots_active": active, "state_at": st.get("at"),
            "engines": engines, "puller": st.get("puller") or {}, "usage": st.get("usage") or {},
            # 0.5.5: the last OpenClaw snapshot for the backup (ok | partial | skipped:<why>, null = never ran), the copy
            # in place, and the tick's word on the snapshot tars' owner (ok = root 0600, bad = left alone)
            "oc_snapshot": snap.get("result") if snap.get("result") in SNAPSHOT_RESULTS else None,
            "snapshot_at": snap.get("snapshot_at") if isinstance(snap.get("snapshot_at"), str) and
            ISO_RE.fullmatch(snap["snapshot_at"]) else None,
            "oc_snapshot_file": snap.get("file") if snap.get("file") in ("ok", "bad") else None,
            "oc_snapshot_why": snap.get("why") if isinstance(snap.get("why"), str) and
            re.fullmatch(r"[a-z]{1,8}(?:,[a-z]{1,8}){0,4}", snap["why"]) else None,
            # 0.5.9: the tick's word on a frozen gateway (state.json openclaw.frozen), null = none in 24 h
            "oc_frozen": pulse_frozen(o.get("frozen"))}
    up = read_small(PROC_UPTIME, 64)
    try:
        body["uptime_s"] = int(float(up.split()[0])) if up else None
    except (ValueError, IndexError):
        body["uptime_s"] = None
    d = disk()
    if d["total_bytes"]:
        body["disk_pct"] = round(100 * (1 - d["free_bytes"] / d["total_bytes"]))
    return body


def pulse_frozen(f):
    """openclaw.frozen of state.json as the pulse carries it: known keys and values only."""
    if not isinstance(f, dict):
        return None
    at = lambda v: v if isinstance(v, str) and ISO_RE.fullmatch(v) else None
    n = f.get("restarts")
    return {"now": f.get("now") is True, "at": at(f.get("at")), "since": at(f.get("since")),
            "restarts": n if type(n) is int and 0 <= n <= 1000 else None,
            "result": f.get("result") if f.get("result") in OC_FROZEN_RESULTS else None,
            "last_restart": at(f.get("last_restart"))}


def pulse_config():
    """SYNC_URL/SYNC_KEY: from the environment when set, else from ~/.msb/.env read AS client (this process runs as
    client: no EnvironmentFile, so PID 1 never parses a client file as root)."""
    url, key = os.environ.get("SYNC_URL"), os.environ.get("SYNC_KEY")
    if url and key:
        return url, key
    found = {}
    for line in (read_small(PULSE_ENV_FILE, 64 << 10) or b"").decode("utf-8", "replace").splitlines():
        m = re.fullmatch(r"\s*(?:export\s+)?(SYNC_URL|SYNC_KEY)\s*=\s*[\"']?([^\"'\s]{1,300})[\"']?\s*", line)
        if m:
            found[m.group(1)] = m.group(2)
    return url or found.get("SYNC_URL", ""), key or found.get("SYNC_KEY", "")


def cmd_pulse(args):
    url, key = pulse_config()
    url, key = (url or "").strip().rstrip("/"), (key or "").strip()
    if not url or not key or not PULSE_URL_RE.fullmatch(url) or not re.fullmatch(r"[\x21-\x7e]{8,256}", key):
        print("JARVIS_ENGINE_PULSE_NO_CONFIG", file=sys.stderr)
        return 0
    st = read_state()
    body = pulse_body(st, bots_liveness())
    beating = body["jarvis_beating"]
    claims = not beating and body["engine_alive"]  # what /api/heartbeat/base takes as «alive» (basePulseLiveness)
    digest = hashlib.sha256(json.dumps([body["engines"], (body["puller"] or {}).get("check"), body["oc_snapshot"],
                                        body["oc_snapshot_file"], body["oc_snapshot_why"],
                                        # 0.5.9: a frozen gateway seen, restarted, capped (not its time: every round)
                                        [(body["oc_frozen"] or {}).get(k) for k in ("now", "result", "restarts")]],
                                       sort_keys=True).encode()).hexdigest()
    prev = read_small(PULSE_STATE, 4096)
    try:
        prev = json.loads(prev.decode()) if prev else {}
    except Exception:
        prev = {}
    prev = prev if isinstance(prev, dict) else {}
    last = prev.get("reported_at") if isinstance(prev.get("reported_at"), int) else 0
    body["report"] = prev.get("digest") != digest or now() - last >= PULSE_REPORT_EVERY
    if not claims and not body["report"]:
        # «alive» is the bot's heartbeat (or its silence: a bot down is down), or nobody's: no Jarvis and OpenClaw not
        # answering = the server is down for the watchdog too; nothing new to report
        return 0
    code = http_post(url + "/api/heartbeat/base", key, body)
    print("JARVIS_ENGINE_PULSE status=%s report=%s beating=%s engine_alive=%s bots=%s/%s" % (
        code, body["report"], beating, body["engine_alive"], body["bots_active"], body["bots_enabled"]), file=sys.stderr)
    if code and 200 <= code < 300 and body["report"]:
        try:
            tmp = PULSE_STATE + ".tmp"
            with open(tmp, "w") as f:
                json.dump({"digest": digest, "reported_at": now()}, f)
            os.replace(tmp, PULSE_STATE)
        except OSError:
            pass
    return 0


def main(argv):
    cmd = argv[1] if len(argv) > 1 else ""
    if cmd == "--version":
        print(HELPER_VERSION)
        return 0
    commands = {"run": cmd_run, "setup": cmd_setup, "tick": cmd_tick, "status": cmd_status, "pulse": cmd_pulse,
                "snapshot": cmd_snapshot}
    if cmd not in commands or len(argv) > 2:
        print("usage: jarvis-engine run | setup | tick | status | pulse | snapshot | --version", file=sys.stderr)
        return 2
    os.umask(0o077)
    for sig in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
        signal.signal(sig, on_signal)
    try:
        return commands[cmd](argv[2:])
    except Refused as e:
        print("JARVIS_ENGINE_%s_%s" % (cmd.upper().replace("-", "_"), e.code), file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
