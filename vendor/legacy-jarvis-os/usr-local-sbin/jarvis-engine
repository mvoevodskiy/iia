    write_file(OC_DEFAULTS_FILE, json.dumps(rec, sort_keys=True).encode())


def public_defaults(rec):
    """state.json `openclaw_defaults`: what was brought over and what of the owner's was kept (names only)."""
    if not rec:
        return None
    names = lambda xs: [x for x in (xs if isinstance(xs, list) else []) if isinstance(x, str) and DEFAULTS_NAME_RE.fullmatch(x)][:32]
    return {"version": rec.get("version") if isinstance(rec.get("version"), int) else None,
            "result": rec.get("result") if rec.get("result") in ("install", "done", "failed") else None,
            "applied": names(rec.get("applied")), "kept": names(rec.get("kept")),
            "at": rec.get("at") if isinstance(rec.get("at"), str) and ISO_RE.fullmatch(rec["at"]) else None}


def defaults_installed(iid):
    """add-openclaw of this helper installed OpenClaw with today's defaults: nothing for the tick to bring over."""
    save_oc_defaults({"version": OC_DEFAULTS_VERSION, "installation_id": iid, "result": "install", "applied": [],
                      "kept": [], "at": iso(), "helper": HELPER_VERSION})


def workspace_files(names):
    """{name: bytes | None (absent) | False (there, but not a plain file of openclaw: never ours to replace)} of
    OpenClaw's workspace, read without following any link; None when the workspace cannot be opened."""
    uid = uid_of("openclaw")
    try:
        dfd, _ = open_dir_chain(os.path.join(OC_HOME, ".openclaw", "workspace"))
    except OSError:
        return None
    try:
        out = {}
        for n in names:
            try:
                os.stat(n, dir_fd=dfd, follow_symlinks=False)
            except FileNotFoundError:
                out[n] = None
                continue
            except OSError:
                out[n] = False
                continue
            data = read_owned(dfd, n, uid, 1 << 20)
            out[n] = data if data is not None else False
        return out
    finally:
        os.close(dfd)


def migrate_workspace(work, backup):
    """(applied, kept) of the workspace part (see above); the new files written by openclaw itself (configure.sh seed with
    a backup: whatever would be overwritten is copied to workspace/memory/<backup>/ first, then each new file is renamed
    over its target: never a moment without the file, nothing erased)."""
    have = workspace_files(("SOUL.md", "IDENTITY.md", "USER.md"))
    if have is None:
        return [], ["workspace"]
    applied, kept, stage = [], [], {}
    sha = lambda b: hashlib.sha256(b).hexdigest()
    for name in ("SOUL.md", "IDENTITY.md", "USER.md"):
        cur, new = have[name], seed_bytes(name)
        if cur is None or (cur and sha(cur) in OLD_SEED_SHA[name]):
            hint = OLD_SEED_SHA[name].get(sha(cur), "") if cur else ""
            stage[name] = new if not hint else new.rstrip(b"\n") + b"\n" + hint_bytes(hint == "hint+skipped")
            applied.append("workspace/" + name)
        elif cur == new:
            continue
        else:
            kept.append("workspace/" + name)
            if name == "SOUL.md" and cur and OLD_SOUL_NO_UI in cur:
                stage[name] = cur.replace(OLD_SOUL_NO_UI, b"")
                applied.append("workspace/SOUL.md:control-ui")
    if stage:
        stage_dir = xfer_dir("seed")
        try:
            for name, data in stage.items():
                xfer_write(stage_dir, name, data)
            result, info = script(work, unpack(work), "openclaw-configure.sh", ["seed", stage_dir, backup], timeout=120)
            if result != "ok":
                raise script_refused("failed", info)
        finally:
            rmtree_private(stage_dir)
    return applied, kept


def migrate_openclaw(work):
    """The tick: an OpenClaw installed by an older helper brought to upstream's defaults, once (see above). Returns the
    record of a try, None when there was none."""
    m = marker()
    iid = m.get("installation_id", "")
    if m.get("complete") != "1" or unconfigured(m) or os.path.lexists(OC_OFF) or not UUID_RE.fullmatch(iid):
        return None
    rec = oc_defaults_record()
    mine = rec.get("installation_id") == iid
    if mine and isinstance(rec.get("version"), int) and rec["version"] >= OC_DEFAULTS_VERSION and \
            rec.get("result") in ("install", "done"):
        return None
    tries = rec.get("tries") if mine and rec.get("helper") == HELPER_VERSION and isinstance(rec.get("tries"), int) else 0
    if tries >= OC_DEFAULTS_TRIES or sandboxes_alive() or not oc_quiet():
        return None
    base = {"version": OC_DEFAULTS_VERSION, "installation_id": iid, "helper": HELPER_VERSION, "tries": tries + 1}
    words = lambda v: [x for x in (v or "-").split(",") if x and x != "-" and DEFAULTS_NAME_RE.fullmatch(x)]
    try:
        result, info = script(work, unpack(work), "openclaw-configure.sh", ["defaults"], timeout=300)
        if result != "ok":
            raise Refused("FAILED", "failed", {"reason": info})
        wa, wk = migrate_workspace(work, "before-056-" + stamp().lower())
        rec = dict(base, result="done", applied=words(info.get("applied")) + wa, kept=words(info.get("kept")) + wk, at=iso())
    except Refused as e:
        reason = e.detail.get("reason", e.code)
        rec = dict(base, result="failed", reason=reason if isinstance(reason, str) else "DEFAULTS", applied=[], kept=[], at=iso())
    save_oc_defaults(rec)
    print("JARVIS_ENGINE_DEFAULTS result=%s applied=%d kept=%d" % (rec["result"], len(rec["applied"]), len(rec["kept"])),
          file=sys.stderr)
    return rec


