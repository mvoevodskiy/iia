MENU_NAME_RE = re.compile(r"[a-z0-9_]{1,32}")
MENU_MAX = 100              # Telegram's command menu
MENU_TEXT_BUDGET = 5700     # commands + descriptions, the budget OpenClaw 2026.9.5 keeps to (TELEGRAM_TOTAL_COMMAND_TEXT_BUDGET)
MENU_WAIT = 30              # after configure: how long the default menu may take to show our /server (OpenClaw's own sync)
