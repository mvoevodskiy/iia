def jarvis_info():
    bots = jarvis_bots() if jarvis_present() else []
    installed = any(not b["removed"] for b in bots)
    enabled = any(b["enabled"] for b in bots)
    if not jarvis_present():
        state = "absent"
    elif bots and not installed:
        state = "removed"
    elif bots and not enabled:
        state = "disabled"
    elif any(b["working"] for b in bots):
        state = "active"
    elif any(b["sleeping"] for b in bots) and all(b["sleeping"] for b in bots if b["enabled"]):
        state = "asleep"  # every switched-on bot sleeps: OpenClaw answers (disable-jarvis)
    else:
        state = "inactive"
    return {"installed": installed, "enabled": enabled, "state": state, "bots": bots,
            "cc_cli_version": cc_cli_version() if jarvis_present() else None}


def openclaw_info(work=None, lib=None):
    """`plugin` (the /server plugin in OpenClaw's config) is known only when the state script ran (work and lib):
    None otherwise, and None is never a way back."""
    m = marker()
    installed = m.get("complete") == "1"
    off = os.path.lexists(OC_OFF)
    plugin = None
    if not m:
        gateway, plugin = "absent", "absent"
    elif work and lib and installed:
        gateway, plugin = openclaw_live(work, lib)
    else:
        gateway = "unknown"
    v = m.get("version", "")
    # incomplete = add-openclaw continues it: the install script stopped halfway, or OpenClaw is installed and its
    # channel was never configured (no Telegram bot answers)
    return {"installed": installed, "enabled": installed and not off,
            "incomplete": bool(m) and (not installed or unconfigured(m)),
            "gateway": gateway, "plugin": plugin, "plugin_alive": plugin_alive() if installed else False,
            "version": v if OC_VERSION_RE.fullmatch(v) else None,
            "frozen": frozen_public() if installed else None}   # 0.5.9: the tick's word on a frozen gateway


def plugin_alive_age():
    """Seconds since the /server plugin's stamp (a regular file of openclaw, only the mtime is looked at, nothing
    followed or read); None when there is none."""
    uid = uid_of("openclaw")
    if uid is None:
        return None
    try:
        dfd, _ = open_dir_chain(SOURCES[1][1])
    except OSError:
        return None
    try:
        st = os.stat(PLUGIN_ALIVE_NAME, dir_fd=dfd, follow_symlinks=False)
    except OSError:
        return None
    finally:
        os.close(dfd)
    if not stat.S_ISREG(st.st_mode) or st.st_uid != uid:
        return None
    return now() - st.st_mtime


def plugin_alive():
    """The /server plugin runs inside the gateway: its stamp is at most PLUGIN_ALIVE_MAX old."""
    age = plugin_alive_age()
    return age is not None and age <= PLUGIN_ALIVE_MAX


def way_back(o):
    """After Jarvis is removed the owner can bring it back only from OpenClaw's /server: OpenClaw installed (and its
    setup finished: a half-done one has no channel of ours), switched on, the plugin wired in its config and alive in the
    gateway (its stamp). Removing Jarvis without it is refused (NO_WAY_BACK); remove-jarvis also probes OpenClaw's
    Telegram channel before anything changes."""
    return bool(o.get("installed") and not o.get("incomplete") and o.get("enabled") and o.get("plugin") == "wired"
                and o.get("plugin_alive"))


def count_today(dirs, start):
    """How many entries under the given directories changed since `start` (stat only, no content, no links)."""
    n = 0
    for d in dirs:
        try:
            with os.scandir(d) as it:
                for e in it:
                    try:
                        if not e.is_symlink() and e.stat(follow_symlinks=False).st_mtime >= start:
                            n += 1
                    except OSError:
                        continue
                    if n >= 10000:
                        return n
        except OSError:
            continue
    return n


def sub_dirs(path, child=None):
    try:
        with os.scandir(path) as it:
            names = [e.name for e in it if e.is_dir(follow_symlinks=False)]
    except OSError:
        return []
    return [os.path.join(path, n, child) if child else os.path.join(path, n) for n in sorted(names)[:64]]


def usage_today():
    """Sessions with activity today (UTC), per engine: a count of session files touched, never their content."""
    t = now()
    start = t - t % 86400
    jarvis = sub_dirs(os.path.join(CLIENT_HOME, ".msb", "bots"), "sessions") + \
        sub_dirs(os.path.join(CLIENT_HOME, ".claude", "projects"))
    oc = sub_dirs(os.path.join(OC_HOME, ".openclaw", "agents"), "sessions") + \
        sub_dirs(os.path.join(OC_HOME, ".openclaw", "agents"), "agent") + [os.path.join(OC_HOME, ".openclaw", "sessions")]
    return {"day": time.strftime("%Y-%m-%d", time.gmtime(t)), "jarvis_sessions": count_today(jarvis, start),
            "openclaw_sessions": count_today(oc, start)}


def trash_entries():
    """Removals whose not-kept data still waits in ~/.msb/archive/.trash (restorable until erase_after)."""
    out = []
    for d in sub_dirs(os.path.join(CLIENT_HOME, ".msb", "archive", ".trash")):
        name = os.path.basename(d)
        m = ARCHIVE_RE.fullmatch(name)
        t = stamp_time(m.group(2)) if m else None
        if t is not None:
            out.append((t, {"archive": name, "erase_after": iso(t + TRASH_TTL)}))
    return [e for _, e in sorted(out, key=lambda x: -x[0])][:16]


def puller_facts(check=None):
    """What the base pulse tells about the delivery rail (no content: times, counters, a version)."""
    facts = {"timer_enabled": systemctl_word("is-enabled", PULLER_TIMER) == "enabled",
             "timer_active": systemctl_word("is-active", PULLER_TIMER) == "active"}
    try:
        st = os.lstat(PULLER_STATE)
        if stat.S_ISREG(st.st_mode):
            facts["last_run_at"] = iso(int(st.st_mtime))
    except OSError:
        pass
    raw = read_user_file(PULLER_STATE, "client", 1 << 20)
    try:
        state = json.loads(raw.decode()) if raw else {}
    except Exception:
        state = {}
    if isinstance(state, dict):
        cf = state.get("consecutive_failures")
        if isinstance(cf, int) and not isinstance(cf, bool):
            facts["consecutive_failures"] = cf
        facts["circuit_open"] = bool(state.get("circuit_open_until"))
        v = state.get("applied_platform_version")
        if isinstance(v, str) and re.fullmatch(r"[0-9A-Za-z._-]{1,100}", v):
            facts["applied_version"] = v
    if check:
        facts["check"] = check
    return facts


def pulse_facts():
    facts = {"installed": os.path.lexists(os.path.join(UNITS_DIR, "msb-base-pulse.service")),
             "timer_active": systemctl_word("is-active", PULSE_TIMER) == "active"}
    raw = read_user_file(PULSE_STATE, "client", 4096)
    try:
        last = json.loads(raw.decode()).get("reported_at") if raw else None
    except Exception:
        last = None
    if isinstance(last, int):
        facts["last_report_at"] = iso(last)
    return facts


def available_actions(j, o, d):
    """C8: the bot shows only these (per source, given the state now). Per bot facts (which bot sleeps) are in
    jarvis.bots: a bot offers disable-jarvis for itself only while it is awake, enable-jarvis while it sleeps."""
    acts = ["status"]
    if not o["installed"] or (o["incomplete"] and o["enabled"]):
        acts.append("add-openclaw")  # while incomplete: it continues the same installation («Продолжить»)
    if o["installed"] or o["incomplete"]:
        acts.append("remove-openclaw")
    if o["installed"]:
        acts.append("disable-openclaw" if o["enabled"] else "enable-openclaw")
        cur = oc_version(o["version"])
        if o["enabled"] and (cur is None or cur < oc_version(OC_VERSION_VERIFIED)):
            acts.append("update-openclaw")
    if j["state"] == "removed":
        acts.append("add-jarvis")
    if j["installed"]:
        if way_back(o):
            acts.append("remove-jarvis")
        if any(b["enabled"] and not b["sleeping"] for b in j["bots"]):
            acts.append("disable-jarvis")
        if any(not b["removed"] and (not b["enabled"] or b["masked"] or b["sleeping"]) for b in j["bots"]):
            acts.append("enable-jarvis")
    if trash_entries():
        acts.append("restore")
    if o["installed"] and o["enabled"]:
        acts.append("set-model")
    if o["installed"] and o["enabled"] and not o["incomplete"] and o["gateway"] == "active" and cron_on():
        acts.append("import-cron")  # 0.5.7: only where the native cron can take the jobs now (C8)
    out = {s: [a for a in acts if a in SOURCE_ACTIONS[s]] for s, _, _ in SOURCES}
    if j["installed"]:
        # With a Jarvis bot installed the model key goes through its bot (⚙️ Движки → 🔑 Модель), never OpenClaw's chat.
        out["openclaw"] = [a for a in out["openclaw"] if a != "set-model"]
    return out


