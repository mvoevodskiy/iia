def tg_call(token, method, params):
    """One Bot API call as root: the `result` of an ok answer, else an exception. The token stays inside this process
    (the URL), never an argument, a log line or an error text (callers swallow every error whole)."""
    import urllib.parse
    import urllib.request
    req = urllib.request.Request("%s/bot%s/%s" % (TG_API, token, method), data=urllib.parse.urlencode(params).encode(),
                                 method="POST")
    with urllib.request.urlopen(req, timeout=10) as r:
        doc = json.loads(r.read(1 << 20).decode("utf-8"))
    if not isinstance(doc, dict) or doc.get("ok") is not True:
        raise ValueError("not ok")
    return doc.get("result")


def ru_menu(default):
    """The Russian menu for the default one OpenClaw registered: the same commands in the same order, Russian
    descriptions where RU_MENU has one. Within Telegram's limits: at most MENU_MAX commands, descriptions of 1-256
    characters, cut evenly (as OpenClaw does) when the whole text is over MENU_TEXT_BUDGET."""
    out = []
    for c in (default if isinstance(default, list) else [])[:MENU_MAX]:
        if not isinstance(c, dict):
            continue
        name, desc = c.get("command"), c.get("description")
        if not isinstance(name, str) or not MENU_NAME_RE.fullmatch(name) or not isinstance(desc, str) or not desc.strip():
            continue
        out.append({"command": name, "description": RU_MENU.get(name, desc)[:256]})
    total = sum(len(c["command"]) + len(c["description"]) for c in out)
    if out and total > MENU_TEXT_BUDGET:
        cap = max(1, (MENU_TEXT_BUDGET - sum(len(c["command"]) for c in out)) // len(out))
        out = [dict(c, description=c["description"] if len(c["description"]) <= cap else c["description"][:max(1, cap - 1)] + "…")
               for c in out]
    return out


def sync_ru_menu(token, need=None):
    """The bot's menu for language_code=ru = ru_menu(its default menu), in both scopes (MENU_SCOPES). Read first: nothing
    is sent where it already is. `need`: a command the default menu must hold before it counts (right after configure
    OpenClaw registers its menu a moment later; an old default menu is never mirrored). An empty default menu (OpenClaw
    left it so: BOT_COMMANDS_TOO_MUCH) = a stale `ru` is removed, never left with an outdated list. Never raises; the
    token never leaves this process. off (no Telegram from here, no token) | empty (no default menu, or not the one
    waited for) | cleared (the default menu empty, a stale ru removed) | same | set | error."""
    if not TG_API or not token:
        return "off"
    try:
        default = tg_call(token, "getMyCommands", {})
        want = ru_menu(default)
        if need and not any(c["command"] == need for c in want):
            return "empty"
        word = "same" if want else "empty"
        for scope in MENU_SCOPES:
            have = tg_call(token, "getMyCommands", dict(scope, language_code="ru"))
            if want and have != want:
                tg_call(token, "setMyCommands", dict(scope, commands=json.dumps(want, ensure_ascii=False), language_code="ru"))
                word = "set"
            elif not want and have:
                tg_call(token, "deleteMyCommands", dict(scope, language_code="ru"))
                word = "cleared"
        return word
    except Exception:  # noqa: BLE001 the menu is cosmetic; an error text could carry the URL
        return "error"


def clear_stale_menus(token):
    """A language menu an earlier OpenClaw left on the same bot (STALE_MENU_LANGS) would win over the default one for
    that language. Removed once after configure, as root; best effort, every error swallowed whole."""
    if not TG_API:
        return
    for lang in STALE_MENU_LANGS:
        try:
            tg_call(token, "deleteMyCommands", {"language_code": lang})
        except Exception:  # noqa: BLE001 a menu left as it was never fails the install
            pass


def menus_after_configure(token):
    """After add-openclaw's configure: stale language menus go, the Russian one is set once OpenClaw's default menu holds
    our /server (its own sync runs a moment after the channel starts), waiting at most MENU_WAIT. Not there by then:
    the tick sets it (sync_ru_menu each round)."""
    clear_stale_menus(token)
    word = "off"
    for _ in range(max(1, MENU_WAIT // 3)):
        word = sync_ru_menu(token, need="server")
        if word != "empty":
            break  # set, same, off; an error (no network) is not waited out here: the tick tries again
        time.sleep(3)
    print("JARVIS_ENGINE_MENU_RU %s" % word, file=sys.stderr)
    return word


def add_need_bytes(resume):
    """What an add-openclaw needs free now: the low bar only for a resume where the program is there; without its CLI
    (a removal broken half-way) the install downloads again. state.json `disk.need_gb` says the same to the bot."""
    has_cli = os.path.lexists(os.path.join(OC_HOME, ".openclaw", "bin", "openclaw"))
    return RESUME_FREE_BYTES if resume and has_cli else MIN_FREE_BYTES


def mem_total_mb():
    for line in (read_small(MEMINFO, 8192) or b"").decode("ascii", "replace").splitlines():
        m = re.fullmatch(r"MemTotal:\s+([0-9]+) kB", line.strip())
        if m:
            return int(m.group(1)) // 1024
    return None


def oc_limits(total_mb, bots):
    """0.5.9: (MemoryHigh, MemoryMax) in MB of OpenClaw's slice on a server of `total_mb` RAM (None = unknown: the
    floor) with `bots` Jarvis bots. Same formula as openclaw-install.sh oc_limits."""
    floor = OC_FLOOR_MAX_MB[1] if bots >= 2 else OC_FLOOR_MAX_MB[0]
    mx = floor
    if isinstance(total_mb, int) and total_mb > 0:
        mx = max(floor, min(total_mb // 2, total_mb - OC_RESERVE_MB - OC_RESERVE_BOT_MB * bots) // 64 * 64)
    return mx * 25 // 32, mx


def cc_cli_version():
    try:
        v = json.loads((read_small(CC_PACKAGE_JSON, 1 << 16) or b"{}").decode()).get("version")
    except Exception:
