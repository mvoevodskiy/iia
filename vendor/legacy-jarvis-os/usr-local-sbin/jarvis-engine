def unconfigured(m):
    """OpenClaw installed (marker complete) but its channel never configured by add-openclaw: the helper's own record
    says configured=0 for this very installation. Anything else counts as configured and is never installed over
    (fail-closed): no record (installed by a helper before the record existed: a working OpenClaw), another
    installation, an unreadable record. Nothing openclaw can write takes part (its config, the plugin state)."""
    rec = key_values(OC_SETUP_FILE)
    iid = rec.get("installation_id", "")
    return m.get("complete") == "1" and rec.get("configured") == "0" and bool(UUID_RE.fullmatch(iid)) and \
        iid == m.get("installation_id")


