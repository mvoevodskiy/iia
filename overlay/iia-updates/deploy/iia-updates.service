[Unit]
Description=IIA updates + installer hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/iia-updates/app
EnvironmentFile=%h/iia-updates/env
ExecStart=/usr/bin/node bin/serve.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes

[Install]
WantedBy=default.target
