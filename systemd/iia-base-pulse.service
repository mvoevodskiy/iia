[Unit]
Description=Base-layer pulse: POST /api/heartbeat/base (no conversation content)
# Runs as client with the box's own SYNC_URL/SYNC_KEY (the same ones the puller uses; read by the helper itself as
# client from ~/.iia/.env: no EnvironmentFile, PID 1 never parses a client file for it), so it keeps the server
# visible when the Jarvis bot (the other heartbeat) is removed or switched off by a mask, while OpenClaw answers (no
# Jarvis and no working OpenClaw = no liveness). While a Jarvis bot unit is meant to run (enabled), its own heartbeat
# carries liveness, also while that bot is down (failed, crash loop: a dead bot never hides behind this pulse), and this
# one only reports a change of engines (at most every 6 hours otherwise). 60 s: systemd reads at most 20 s in all
# (two calls for every bot unit), the POST at most 15 s.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=client
WorkingDirectory=/home/client
Environment=HOME=/home/client
ExecStart=/usr/bin/python3 -IS /usr/local/sbin/jarvis-engine pulse
TimeoutStartSec=60s
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
MemoryMax=128M
Nice=10
