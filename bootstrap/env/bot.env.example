# Per-bot env → /home/client/.iia/bots/<id>/.env
# Только отличающиеся ключи. Общие секреты — в /home/client/.iia/.env
# (systemd грузит этот файл; копия общего ключа сюда навсегда его перебьёт).

BOT_TOKEN=
IIA_BOT_ID=default
IIA_SESSION_DIR=/home/client/.iia/bots/default/sessions
IIA_TRANSCRIPT_DIR=/home/client/.iia/bots/default/transcripts
IIA_HOOKS_DIR=/home/client/.iia/bots/default/agent-hooks
IIA_TRACES_DIR=/home/client/.iia/bots/default/traces
JARVIS_CC_ONLY=1
